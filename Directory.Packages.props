<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- ADR 0164 D6 — git-tag-derived versioning. Build-time only, never a consumer dependency. -->
    <PackageVersion Include="MinVer" Version="6.1.0"/>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="bunit" Version="2.9.0"/>
    <!-- AngleSharp: pulled transitively by bunit 2.7.2 (DOM parsing). Its default 1.4.0 carries
         GHSA-pgww-w46g-26qg (moderate; patched in 1.5.x). Pinned to latest 1.5.x stable and forced
         via a direct PackageReference in each bunit-consuming test project to lift the transitive
         above the vuln range (clears NU1902 under NuGetAudit + warnings-as-errors — same recipe as
         Scriban.Signed below). Remove once bunit ships a build depending on AngleSharp >= 1.5.0. -->
    <PackageVersion Include="AngleSharp" Version="1.8.0"/>
    <PackageVersion Include="xunit" Version="2.9.3"/>
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0"/>
    <PackageVersion Include="Markdig" Version="1.3.2"/>
    <PackageVersion Include="coverlet.collector" Version="10.0.1"/>
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <!-- WireMock.Net (Apache-2.0): in-process, CI-friendly PSP-shaped stub HTTP server for
         Harborline.Providers.Stripe.Tests (Stripe REST fixtures). No docker/network needed. -->
    <PackageVersion Include="WireMock.Net" Version="2.12.0"/>
    <!-- Scriban.Signed: pulled transitively by WireMock.Net 2.12.0 (response templating). Its
         default 7.2.0 carries GHSA-6q7j-xr26-3h2c + GHSA-q6rr-fm2g-g5x8 (moderate; both patched in
         7.2.1). Pinned to latest 7.2.x stable and forced via a direct PackageReference in
         Harborline.Providers.Stripe.Tests to lift the transitive above the vuln range (clears NU1902
         under NuGetAudit + warnings-as-errors). Remove once WireMock.Net ships a build that depends
         on Scriban.Signed >= 7.2.1. -->
    <PackageVersion Include="Scriban.Signed" Version="7.2.5"/>
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="NSubstitute" Version="6.2.0"/>
    <PackageVersion Include="FsCheck" Version="3.3.3"/>
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.3"/>
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0"/>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0"/>
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0"/>
    <PackageVersion Include="MessagePack" Version="3.1.8"/>
    <PackageVersion Include="System.Formats.Cbor" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-preview.6"/>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0"/>
    <PackageVersion Include="ClosedXML" Version="0.105.0"/>
    <!-- PDFsharp-MigraDoc (MIT, empira): the Documents pillar (#111) default PDF render adapter. Pure-managed,
         cross-platform, no revenue gate (unlike QuestPDF — D-1 discipline). Held ONLY by the non-Foundation
         Harborline.Api.Documents.PdfSharp adapter (the ProviderNeutrality analyzer keeps it out of Foundation). -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4"/>
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0"/>
    <PackageVersion Include="CsvHelper" Version="33.1.0"/>
    <PackageVersion Include="MetadataExtractor" Version="2.9.3"/>
    <PackageVersion Include="System.Net.Http.Json" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="SmartFormat" Version="3.6.1"/>
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6"/>
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6"/>
    <PackageVersion Include="Testcontainers" Version="4.13.0"/>
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11"/>
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1"/>
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-preview.7.26381.103"/>
    <PackageVersion Include="YamlDotNet" Version="18.1.0"/>
    <PackageVersion Include="Makaretu.Dns.Multicast.New" Version="0.38.0"/>
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85"/>
    <PackageVersion Include="YDotNet" Version="0.6.0"/>
    <PackageVersion Include="YDotNet.Native" Version="0.6.0"/>
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0"/>
    <PackageVersion Include="MailKit" Version="4.17.0"/>
    <PackageVersion Include="MimeKit" Version="4.17.0"/>
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6"/>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6"/>
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6"/>
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6"/>
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6"/>
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6"/>
    <PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="13.4.6"/>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-preview.5.26302.115"/>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0"/>
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0"/>
    <PackageVersion Include="Microsoft.FeatureManagement.AspNetCore" Version="4.5.0"/>
    <PackageVersion Include="NBomber" Version="6.5.0"/>
    <PackageVersion Include="NBomber.Http" Version="6.2.1"/>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0"/>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0"/>
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0"/>
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0"/>
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1"/>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0"/>
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageVersion Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322"/>
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.1-nblumhardt-02317"/>
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1"/>
    <PackageVersion Include="WolverineFx" Version="6.15.0"/>
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.15.0"/>
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.15.0"/>
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.0-preview.3.26203.7"/>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="11.0.0-preview.3.26203.7"/>
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-preview.7.26381.103"/>
    <!-- ADR 0166 D4: MPL-2.0 dev-only BlazingStory gallery dependency. -->
    <PackageVersion Include="BlazingStory" Version="1.0.0-preview.3.1"/>
  </ItemGroup>
</Project>
