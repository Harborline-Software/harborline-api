<Project>
  <PropertyGroup>
    <Vec0NativeRoot>$(MSBuildThisFileDirectory)v0.1.9\</Vec0NativeRoot>
    <Vec0EffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</Vec0EffectiveRuntimeIdentifier>
    <Vec0EffectiveRuntimeIdentifier Condition="'$(Vec0EffectiveRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</Vec0EffectiveRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <_Vec0PinnedNative Include="$(Vec0NativeRoot)win-x64\vec0.dll"
                       ExpectedSha256="FCF98662A7AD9DCE394B96A88F91032047823831B951C76636787C312A6476E6" />
    <_Vec0PinnedNative Include="$(Vec0NativeRoot)osx-arm64\vec0.dylib"
                       ExpectedSha256="193E480C50B59A55977D166F4AAF0E1BC8832D6963516E5950F39E4D2CE0B793" />

    <!-- Only the exact current/target RID payload is copied beside the app. Unsupported RIDs stage nothing,
         so Vec0Native.ResolveNativePath returns null and composition keeps the brute-force engine. -->
    <Content Include="$(Vec0NativeRoot)$(Vec0EffectiveRuntimeIdentifier)\vec0.dll"
             Condition="Exists('$(Vec0NativeRoot)$(Vec0EffectiveRuntimeIdentifier)\vec0.dll')"
             Link="vec0.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Vec0NativeRoot)$(Vec0EffectiveRuntimeIdentifier)\vec0.dylib"
             Condition="Exists('$(Vec0NativeRoot)$(Vec0EffectiveRuntimeIdentifier)\vec0.dylib')"
             Link="vec0.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <Content Include="$(Vec0NativeRoot)manifest.json" Link="sqlite-vec\manifest.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Vec0NativeRoot)NOTICE.md" Link="sqlite-vec\NOTICE.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Vec0NativeRoot)LICENSE-MIT" Link="sqlite-vec\LICENSE-MIT"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- GetFileHash is SDK-built-in. Every build validates both committed executable inputs, even when only one
       RID is staged, so an unreviewed binary replacement fails before compilation. -->
  <Target Name="VerifyVec0NativeDigests" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="@(_Vec0PinnedNative)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_Vec0HashedNative" />
    </GetFileHash>
    <Error Condition="'%(_Vec0HashedNative.FileHash)' != '%(_Vec0HashedNative.ExpectedSha256)'"
           Text="sqlite-vec native digest mismatch: %(_Vec0HashedNative.Identity)" />
  </Target>
</Project>
