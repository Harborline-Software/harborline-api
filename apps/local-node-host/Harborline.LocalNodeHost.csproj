    <!-- ADR 0114 / ADR 0113 SC-1: SQLite EF provider for the embedded local-node
         data plane, ENCRYPTED at rest via SQLCipher.

         Use Microsoft.EntityFrameworkCore.Sqlite.CORE (not plain .Sqlite): the plain
         package transitively pulls SQLitePCLRaw.bundle_e_sqlite3 (the NON-cipher
         native lib), which wins the SQLitePCLRaw provider race and makes PRAGMA key a
         SILENT NO-OP -> a PLAINTEXT financial store (the SC-1 killer this remediation
         closes). The .Core variant pulls no bundle, so only bundle_e_sqlcipher below
         is deployed and PRAGMA key actually encrypts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- SQLCipher: the encrypted SQLite native lib + managed provider. With
         .Sqlite.Core above (no non-cipher bundle) this is the ONLY native SQLite lib
         deployed; the host pins it via SQLitePCL.raw.SetProvider in
         LocalNodeSqlCipherRegistration so PRAGMA key always takes effect (SC-1). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
  </ItemGroup>

