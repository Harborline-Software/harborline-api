  <!--
    ROOT fix (load-bearing) for the RECURRING NETSDK1152 "multiple publish output
    files with the same relative path" on the Harborline App sidecar publish.

    The DefaultItemExcludes above removes THIS project's own `tests/`+`tools/`
    subtrees from the default globs — but that is only HALF the source. The other
    half is TRANSITIVE: every referenced Razor package (ui-adapters-blazor and the
    blocks-* Razor libraries) carries its OWN sibling `tests/` content, which the
    referenced project's default Content glob sweeps into ITS build output and pushes
    into this host's publish set as copy-local static-web-asset files. Worse, each
    test project's default glob recursively re-globs its OWN `bin/` on every rebuild,
    so `tests/bin/Debug/net11.0/tests/bin/Debug/net11.0/…` self-replicates (the
    ~11.7k-file explosion a dev sees after running the suite a few times). All of
    those flatten to colliding publish-relative paths like
    `tests/bin/Debug/net11.0/Harborline.Api.Blocks.Maintenance.staticwebassets.runtime.json`
    — colliding with EACH OTHER (multiple referenced packages + nesting depths), not
    just with this host's own copy. DefaultItemExcludes cannot reach a sibling
    package's items, so the durable fix must filter the FINAL, fully-resolved publish
    set here.

    `_HandleFileConflictsForPublish` (Microsoft.NET.ConflictResolution.targets) runs
    AfterTargets="ComputeFilesToPublish" and raises NETSDK1152 over @(ResolvedFileToPublish)
    keyed by %(RelativePath). We run BeforeTargets that conflict check and strip every
    ResolvedFileToPublish item whose computed RelativePath passes through a `tests/bin`
    or `tests/obj` segment (these are build artifacts of sibling TEST projects — never
    a runtime asset of this JSON-API host). Removing them is behavior-preserving and
    RID-agnostic: the filter runs over the computed publish set, identical on every RID
    the sidecar targets (osx-x64/arm64, win-x64/arm64, linux-*). CI never accumulates
    test bins (clean checkout) so this is a no-op there; it only ever removes the
    dev-machine `dotnet test` debris that was the recurring failure. Composes with the
    StaticWebAssetsEnabled=false above (root SWA-pipeline manifest) and the NETSDK1206
    musl suppression in Directory.Build.props (#1388) for a clean single-file publish.

    MSBuild does not allow `/` or `\` literals inside item Condition string functions
    cross-platform, so we match on the back-slashed and forward-slashed forms of the
    two segments via a property-computed predicate per item.
  -->
  <Target Name="_DropSiblingTestBinDebrisFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('tests/bin/'))
                   Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('tests/obj/'))" />
    </ItemGroup>
  </Target>

  <!-- Issue 2089: verify and stage the exact sqlite-vec native for the current/target RID. The imported
       target is also shared by the host test project so native parity runs from normal build output. -->
  <ItemGroup>
    <!-- Worker SDK content globs would otherwise also ship the source-layout manifest path. The import below
         is the single owner of output/publish layout for every native, manifest, notice, and license asset. -->
    <Content Remove="native\sqlite-vec\**\*" />
    <None Remove="native\sqlite-vec\**\*" />
  </ItemGroup>
  <Import Project="native\sqlite-vec\sqlite-vec.targets" />

  <!-- ADR 0020 (harborline-control): the operator CLI ships INSIDE the node install rather than as
       a separately distributed app. The CLI can only reach this host's loopback listener with the
       per-boot caller-auth token that exists on this machine, so the node's machine is the only
       place it is useful, and a second install channel would only add version skew against the HTTP
       surface it wraps. Deliberately NOT a ProjectReference: the host must not reference the CLI
       assembly - clients reach the node only over loopback HTTP, and the dependency graph should
       say so. Publishing side-by-side is safe because the CLI has no package dependencies, so its
       output is only the harborline-node exe/dll/deps/runtimeconfig set.
       If the enterprise server later grows a REMOTE admin surface (its own ADR 0018 audience
       decision), a remotely installed CLI follows that decision - the CLI is already fully
       URL-parameterized (dash-dash-url / HARBORLINE_NODE_URL), so nothing here forecloses it; this
       target only decides where the binary ships TODAY. -->
  <Target Name="PublishOperatorCliWithHost" AfterTargets="Publish">
    <PropertyGroup>
      <_OperatorCliPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_OperatorCliPublishDir>
      <_OperatorCliProperties>Configuration=$(Configuration);PublishDir=$(_OperatorCliPublishDir)</_OperatorCliProperties>
      <_OperatorCliProperties Condition="'$(RuntimeIdentifier)' != ''">$(_OperatorCliProperties);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)</_OperatorCliProperties>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\node-operator-cli\Harborline.NodeOperatorCli.csproj"
             Targets="Publish"
             Properties="$(_OperatorCliProperties)" />
  </Target>

  <!-- Ticket 208: the committed Access administration export document IS the preload's content. It is
       embedded (not copied) so AccessAdministrationPreloadHostedService reads the exact committed bytes
       on any deployment layout, with no runtime path guessing. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\_shared\packs\access-administration\access-administration-pack.export.json"
                      LogicalName="Harborline.Api.LocalNodeHost.Packs.access-administration-pack.export.json" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
