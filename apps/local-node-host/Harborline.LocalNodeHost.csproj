<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <PackageId>Harborline.Api.LocalNodeHost</PackageId>
    <AssemblyName>Harborline.Api.LocalNodeHost</AssemblyName>
    <RootNamespace>Harborline.Api.LocalNodeHost</RootNamespace>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(HarborlineMauiEnabled)' == 'true'">Library</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Host process, not a library: no XML-doc generation, no missing-comment warnings. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>sunfish-local-node-host</UserSecretsId>
    <!-- ADR 0114/0115 cohort 1c: this host serves JSON APIs over Kestrel, not Blazor.
         It transitively references ui-adapters-blazor (a Razor static-web-assets
         producer), whose sibling TEST projects' nested bin/obj outputs collide on
         `dotnet publish` (NETSDK1152: multiple publish outputs with the same relative
         path — *.staticwebassets.*.json). The node has no static web assets, so
         disable the SWA pipeline entirely: removes the collision + trims the
         self-contained single-file. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- ADR 0114/0115 cohort 1c (next increment) — the ROOT fix for the RECURRING
         NETSDK1152 "multiple publish output files with the same relative path".
         StaticWebAssetsEnabled=false above only stops the SWA *pipeline* from
         re-aggregating the transitive Razor manifests (it correctly strips the
         ROOT-level *.staticwebassets.runtime.json). It does NOT touch the generic
         DEFAULT Content/None glob, which recursively sweeps EVERYTHING under this
         project directory — including the sibling `tests/` subtree's `bin/`+`obj/`
         once a developer has run `dotnet test`. That glob carries those files into
         the publish set at the flattened relative path `tests/bin/Debug/net11.0/…`,
         where they collide with the IDENTICAL relative paths produced from referenced
         Razor packages' own `tests/bin` content (which self-replicates into
         `tests/bin/…/tests/bin/…` on every test rebuild — the ~11.7k-file explosion).
         CI never hits it (clean checkout, no test bins); a dev does, and a one-off
         `git clean` only masks it until the next `dotnet test` — hence the durable fix.
         Collisions are NOT limited to `*.staticwebassets.*` — the same glob also
         duplicates `project.assets.json` / `*.nuget.dgspec.json` / `*.sourcelink.json`
         from the nested test obj/bin, so the fix excludes the whole `tests/`+`tools/`
         subtrees (not just the SWA manifests). DefaultItemExcludes removes them from
         ALL default globs at once (Compile, Content, None, EmbeddedResource), which is
         why the piecemeal `Compile/Content Remove` items below are no longer
         load-bearing for publish (kept only as belt-and-suspenders for IDE item
         display). This host needs no static web assets and no `tests/`/`tools/`
         content at runtime (it serves JSON APIs), so excluding them is behavior-
         preserving. RID-agnostic: the collision and this fix are identical on every
         RID the sidecar publishes (osx-x64/arm64, win-x64/arm64, linux-*). Composes
         with the NETSDK1206 musl suppression (#1388) for a clean sidecar publish. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;tools/**</DefaultItemExcludes>
    <!-- PublishReadyToRun=false: R2R (crossgen2) is a startup-latency optimisation
         only — it is NOT a correctness requirement. The aarch64-apple-darwin crossgen2
         step fails for this host ("Optimising assemblies for performance failed"),
         turning the Tauri advisory-matrix job red since cohort 1c (earlier app ticket #152).
         Disabling here (csproj-scoped so local dotnet publish matches CI) restores the
         self-contained single-file publish on ALL RIDs. Runtime impact for the sidecar
         use-case (background daemon; cold-start sub-second already) is imperceptible.
         Re-enable once crossgen2 supports this RID/configuration combination.
         Admiral tracking: admiral-tracking-2026-06-14T0157Z-r2r-mac-sidecar-build-regression. -->
    <PublishReadyToRun>false</PublishReadyToRun>
      <!-- Ticket 151: the authority-side record validator (Corvus.Json.Validator) compiles a schema
         at runtime with Roslyn and takes its metadata references from DependencyContext.CompileLibraries,
         which is populated only when the compilation context is preserved in the published deps.json. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
</PropertyGroup>

