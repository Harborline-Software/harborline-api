{
  "name": "@harborline-software/capability-host",
  "version": "0.0.0",
  "private": true,
  "description": "Capability v0 — the composition-driven shell + membrane v0 (Announce/Negotiate/Address/Invoke/Observe) over the @harborline-software/api-contracts capability surface. Reference edition proving ground (ADR 0124/0125).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolution": {
      "types": "./dist/resolution/index.d.ts",
      "import": "./dist/resolution/index.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "kg-embed": "./dist/runtime/kg-embed-cli.js",
    "kg-generate": "./dist/runtime/kg-generate-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist/runtime',{recursive:true});for(const f of ['sd_local.py','kg_embed.py','kg_generate.py','operational_environment.py'])fs.copyFileSync('src/runtime/'+f,'dist/runtime/'+f)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@harborline-software/api-contracts": "file:../../packages/contracts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
