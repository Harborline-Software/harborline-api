{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
    // X-1 single-source: the Capability shell consumes @harborline-software/api-contracts as a real
    // `file:` dependency, resolving (via NodeNext + the package `exports` field)
    // to its built `dist` declarations — the package's public entry, no forked
    // local copy. The capability namespace is pure types, so all imports are
    // type-only and compile away to nothing at runtime.
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
