# Ticket 008 Phase C — TypeScript build outputs and dependencies
node_modules/
apps/capability-host/dist/
packages/contracts/dist/

# Test-run outputs. TRX files are ~12MB each, embed the runner machine name and
# absolute paths, and are superseded by the counts and failure names recorded in
# ticket outcomes and commit messages.
TestResults/
**/obj-*/
.test-results/
.stryker/
StrykerOutput/
.stryker-tmp/
.claude/gate-evidence/

# Python bytecode (245 fix 1 tracked one by mistake)
__pycache__/
*.pyc

# Built from eng/platform-pin.json; CI also checks the producer out here.
.feed/
.platform/

# session and lane artefacts (gate evidence included); the three s293 logs tracked by accident are untracked here
.claude/
.codex/

# StrykerJS (eng/strykerjs.mjs): sandbox, in-place backups, setup files left by an aborted run, reports.
.stryker-tmp/
stryker-setup-*.js
**/reports/mutation/

# From GitHub's VisualStudio.gitignore (github/gitignore), the file `dotnet new gitignore` writes.
# Only the rules this repository needs: the whole template also matches tracked sources here.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Visual Studio cache and options
.vs/

# MSBuild binary logs
*.binlog

# Code coverage output
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# Publish output; publish profiles and certificates can carry credentials
publish/
*.pubxml
*.publishsettings
*.pfx

# NuGet packages
*.nupkg
*.snupkg

# From GitHub's Node.gitignore (github/gitignore)
npm-debug.log*
pnpm-debug.log*
*.tsbuildinfo
.eslintcache
.env
.env.*
!.env.example
