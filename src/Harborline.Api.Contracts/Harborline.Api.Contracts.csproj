<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned when the local-node-host build system merged in (ticket 008 step 0.5): the root
         moved to net11.0 for the incoming closure; this envelope keeps its published net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Packable, so its public surface must be documented (CS1591 enforced). This suppression is
         the one remaining exception: 92 public members are still undocumented. Remove it once they are. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Harborline.Api.Contracts</PackageId>
    <Description>Projection-neutral Harborline API transport contracts.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
