<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned when the local-node-host build system merged in (ticket 008 step 0.5): the root
         moved to net11.0 for the incoming closure; this envelope keeps its published net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Carried from this repository's pre-merge root props (ticket 008 step 0.5). Scoped here
         rather than at root: a root-level 1591 suppression would silently relax the XML-doc
         requirement for all 93 incoming projects, which the source deliberately enforces. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Harborline.Api.Contracts</PackageId>
    <Description>Projection-neutral Harborline API transport contracts.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
