#!/bin/sh
# Refuses to push commits that local verification has not covered.
#
# This repository's GitHub Actions workflows are switched off (ACTIONS_ENABLED, see the block at the
# top of .github/workflows/packages.yml). Nothing else checks a push. eng/verify.sh is the
# replacement and this hook is what stops it from being optional.
#
# pre-push rather than pre-commit: the expensive step clones HEAD and refuses a dirty tree, so the
# receipt is keyed to HEAD's tree — and push is what CI triggered on anyway. Committing stays free.
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
node "$hook_dir/../eng/verify-receipt.mjs" --pre-push
