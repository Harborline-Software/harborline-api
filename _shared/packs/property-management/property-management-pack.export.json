{
  "_note": "Harborline Property Management v1 vertical seed. POST this request to /api/local-node/packs/export, then install and activate the signed artifact. The node derives System ownership and Pack provenance from the verified Active seed; this content declares neither.",
  "key": "harborline.property-management",
  "version": "1.0.0",
  "name": "Property Management",
  "description": "Property-first navigation and rent-invoice document content over Harborline's existing records.",
  "scopeTier": "Vertical",
  "contents": [
    {
      "key": "property-management.navigation",
      "kind": "NavWorkspaceConfig",
      "version": "1.0.0",
      "content": {
        "seedWorkspaces": [
          {
            "id": "property-management",
            "labelKey": "workspaces.property-management",
            "defaultForPersonas": ["manager", "maintenance"],
            "groups": [
              {
                "id": "portfolio",
                "labelKey": "workspaceGroups.operations.portfolio",
                "itemIds": ["asset-tree"]
              },
              {
                "id": "billing",
                "labelKey": "workspaceGroups.money.billing",
                "itemIds": ["invoices"]
              },
              {
                "id": "documents",
                "labelKey": "workspaceGroups.workshop.documents",
                "itemIds": ["documents"]
              }
            ]
          }
        ]
      }
    },
    {
      "key": "property-management.rent-invoice",
      "kind": "TemplateDefinition",
      "version": "1.0.0",
      "content": {
        "key": "property-management.rent-invoice",
        "version": "1.0.0",
        "documentType": "invoice",
        "recordType": { "type": "invoice", "version": "1" },
        "locale": { "kind": "fixed", "tag": "en-US" },
        "structure": [
          {
            "kind": "header",
            "lines": [
              { "runs": [
                { "literal": "Rent invoice " },
                { "binding": "field.invoiceNumber" }
              ] },
              { "runs": [
                { "literal": "Issued " },
                { "binding": "field.issueDate", "format": "date" }
              ] },
              { "runs": [
                { "literal": "Due " },
                { "binding": "field.dueDate", "format": "date" }
              ] }
            ]
          },
          {
            "kind": "fieldGrid",
            "label": "Bill to",
            "lines": [
              { "runs": [
                { "literal": "Customer: " },
                { "binding": "field.customer.name" }
              ] },
              { "runs": [
                { "literal": "Email: " },
                { "binding": "field.customer.email" }
              ] }
            ]
          },
          {
            "kind": "repeatingRegion",
            "label": "Charges",
            "repeatSection": "lineItems",
            "columns": [
              { "header": "Description", "binding": "row.description" },
              { "header": "Qty", "binding": "row.quantity", "format": "integer", "align": "end" },
              { "header": "Unit price", "binding": "row.unitPrice", "format": "currency", "align": "end" },
              { "header": "Amount", "binding": "row.amount", "format": "currency", "align": "end" }
            ]
          },
          {
            "kind": "fieldGrid",
            "label": "Totals",
            "lines": [
              { "runs": [
                { "literal": "Subtotal: " },
                { "binding": "field.subtotal", "format": "currency" }
              ] },
              { "runs": [
                { "literal": "Tax: " },
                { "binding": "field.taxTotal", "format": "currency" }
              ] },
              { "runs": [
                { "literal": "Total: " },
                { "binding": "field.total", "format": "currency" }
              ] }
            ]
          }
        ]
      }
    }
  ],
  "dependencies": [
    {
      "key": "harborline.general",
      "version": "1.0.0",
      "declaredDependencyKeys": []
    }
  ],
  "capabilityRequirements": [],
  "dcp": {
    "regulatoryClass": "General",
    "dataSensitivity": "Internal",
    "dcpVersion": "1.0.0",
    "audience": "general",
    "minorsAsSubjects": false,
    "minorsAsPrincipals": false,
    "outOfScope": []
  }
}
