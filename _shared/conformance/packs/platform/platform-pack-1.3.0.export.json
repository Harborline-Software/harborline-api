  "version": "1.3.0",
  "name": "Harborline platform",
  "description": "The sealed platform catalogue and Workshop bootstrap.",
  "scopeTier": "Horizontal",
  "contents": [
    {
      "key": "platform.detail.form", "kind": "FormDefinition", "version": "1.0.0",
      "content": {
        "catalogueFieldSource": {
          "capabilityId": "forms.catalogue-field-source",
          "coordinateSchemaVersion": 1,
          "sourceMappingSchemaVersion": 1,
          "sourceKind": "FormDefinition",
          "fields": [
            { "fieldId": "formId", "source": "catalogue.entry.formId" },
            { "fieldId": "title", "source": "catalogue.entry.title" },
            { "fieldId": "version", "source": "catalogue.entry.version" },
            { "fieldId": "cascadeLayer", "source": "catalogue.entry.cascadeLayer" }
          ]
        },
        "overlay": {
          "title": { "kind": "Literal", "value": "Form details" },
          "fields": {
            "formId": { "label": { "kind": "Literal", "value": "Form ID" }, "controlHint": "text", "readOnly": true, "piiSensitivity": "None" },
            "title": { "label": { "kind": "Literal", "value": "Title" }, "controlHint": "text", "readOnly": true, "piiSensitivity": "None" },
            "version": { "label": { "kind": "Literal", "value": "Version" }, "controlHint": "text", "readOnly": true, "piiSensitivity": "None" },
            "cascadeLayer": { "label": { "kind": "Literal", "value": "Cascade layer" }, "controlHint": "text", "readOnly": true, "piiSensitivity": "None" }
          },
          "sections": [{ "id": "details", "title": { "kind": "Literal", "value": "Details" }, "fields": ["formId", "title", "version", "cascadeLayer"] }],
          "rules": []
        },
        "fieldsMeta": {
          "formId": { "type": "text", "required": false },
          "title": { "type": "text", "required": false },
          "version": { "type": "text", "required": false },
          "cascadeLayer": { "type": "text", "required": false }
        }
      }
    },
