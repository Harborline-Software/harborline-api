# Formatting defaults plus the three explicitly marked Preview quality-rule severities below.
# TreatWarningsAsErrors and analyzer attachment remain in the MSBuild configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = when_multiline:suggestion

# ADR 0085 D4 Preview-mode Roslyn evidence. The normalized CQG identities are
# intentionally comments: SARIF carries upstream engine IDs, and CQG maps them.
# HLQ.CS.1000 sync-over-async
dotnet_diagnostic.VSTHRD002.severity = warning
# HLQ.CS.1020 async void
dotnet_diagnostic.VSTHRD100.severity = error
# HLQ.CS.1100 empty catch (partial evidence)
dotnet_diagnostic.CA1031.severity = warning

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 100

[*.{yml,yaml,json,mjs,js,ts,tsx}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
