# Formatting and analyzer severities. Editors, `dotnet format`, and builds read this.
# TreatWarningsAsErrors and analyzer attachment remain in the MSBuild configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_diagnostic.CA1001.severity = error
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.CA5398.severity = error


# ADR 0085 D4 Preview-mode Roslyn evidence. The normalized CQG identities are
# intentionally comments: SARIF carries upstream engine IDs, and CQG maps them.
# HLQ.CS.1000 sync-over-async
dotnet_diagnostic.VSTHRD002.severity = warning
# HLQ.CS.1020 async void
dotnet_diagnostic.VSTHRD100.severity = error
# HLQ.CS.1100 empty catch (partial evidence)
dotnet_diagnostic.CA1031.severity = warning
# The rest of the threading analyzer package is outside the ADR 0085 preview set. Suggestion here
# (several of these rules default to error, which no warnings property can demote); razor-generated
# sources miss this section and are covered by WarningsNotAsErrors in Directory.Build.props.
dotnet_diagnostic.VSTHRD001.severity = suggestion
dotnet_diagnostic.VSTHRD003.severity = suggestion
dotnet_diagnostic.VSTHRD004.severity = suggestion
dotnet_diagnostic.VSTHRD010.severity = suggestion
dotnet_diagnostic.VSTHRD011.severity = suggestion
dotnet_diagnostic.VSTHRD012.severity = suggestion
dotnet_diagnostic.VSTHRD101.severity = suggestion
dotnet_diagnostic.VSTHRD102.severity = suggestion
dotnet_diagnostic.VSTHRD103.severity = suggestion
dotnet_diagnostic.VSTHRD104.severity = suggestion
dotnet_diagnostic.VSTHRD105.severity = suggestion
dotnet_diagnostic.VSTHRD106.severity = suggestion
dotnet_diagnostic.VSTHRD107.severity = suggestion
dotnet_diagnostic.VSTHRD108.severity = suggestion
dotnet_diagnostic.VSTHRD109.severity = suggestion
dotnet_diagnostic.VSTHRD110.severity = suggestion
dotnet_diagnostic.VSTHRD111.severity = suggestion
dotnet_diagnostic.VSTHRD112.severity = suggestion
dotnet_diagnostic.VSTHRD113.severity = suggestion
dotnet_diagnostic.VSTHRD114.severity = suggestion
dotnet_diagnostic.VSTHRD115.severity = suggestion
dotnet_diagnostic.VSTHRD200.severity = suggestion

[**/tests/**/*.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.CA5398.severity = none

[**/tests/*.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.CA5398.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.CA5398.severity = none

[tests/*.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.CA5398.severity = none

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 100

[*.{yml,yaml,json,mjs,js,ts,tsx}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
