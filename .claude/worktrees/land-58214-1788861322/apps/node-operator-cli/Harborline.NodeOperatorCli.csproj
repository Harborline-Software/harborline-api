<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Harborline.Api.NodeOperatorCli</PackageId>
    <!-- 063 ruling 2: the package/namespace identity is Harborline.Api.NodeOperatorCli; the AssemblyName is
         the installed command, harborline-node, because the SDK names the apphost, deps.json and
         runtimeconfig after AssemblyName (TargetName renames only the dll). Exempt from the R2 convergence
         rule in harborline-control/tools/scan-identity-standard.mjs for exactly this reason. -->
    <AssemblyName>harborline-node</AssemblyName>
    <RootNamespace>Harborline.Api.NodeOperatorCli</RootNamespace>
  </PropertyGroup>

</Project>
