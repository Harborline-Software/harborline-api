<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Harborline.Api.NodeHosting</RootNamespace>
    <AssemblyName>Harborline.Api.NodeHosting</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- D4: this is the only app-facing hosting project allowed to reference the node. -->
    <ProjectReference Include="..\local-node-host\Harborline.LocalNodeHost.csproj" />
  </ItemGroup>
</Project>
