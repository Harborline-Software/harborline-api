<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.PropertyEquipment</PackageId>
    <AssemblyName>Harborline.Api.Blocks.PropertyEquipment</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.PropertyEquipment</RootNamespace>
    <Description>Property-Equipment domain block — Equipment entity (FK to Property), EquipmentClass discriminator, EquipmentLifecycleEvent append-only log, in-memory repository + event store, and IHarborlineEntityModule contribution. Cluster sibling under the property-operations cluster (`blocks-property-*` naming convention). Renamed from blocks-property-assets per UPF Rule 4 to disambiguate from foundation-tier `Harborline.Api.Foundation.Assets.Common`. Vehicle subtype + Trip events + EquipmentConditionAssessment integration + OCR ingest deferred to follow-up hand-offs.</Description>
    <PackageTags>property-equipment;equipment;real-estate;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.PropertyEquipment.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\blocks-properties\Harborline.Blocks.Properties.csproj" />
  </ItemGroup>
</Project>
