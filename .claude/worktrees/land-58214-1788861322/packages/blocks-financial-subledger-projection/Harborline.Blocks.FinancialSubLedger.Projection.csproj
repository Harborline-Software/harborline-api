<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialSubLedger.Projection</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialSubLedger.Projection</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialSubLedger.Projection</RootNamespace>
    <Description>HIGH-tier ISubLedgerReadModel implementation for the generic subsidiary-ledger primitive (ADR 0120 PR-B). ProjectReferences blocks-financial-ar + -ap + -payments to read open items and payment applications. The heavy reference closure is isolated here so LOW-tier consumers (packs, offline node) never transitively pull AR/AP/Payments. Tenant isolation: every read path filters on the passed TenantId — no ambient ITenantContext dependency.</Description>
    <PackageTags>subsidiary-ledger;subledger;projection;read-model;ar;ap;payments;blocks;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CS1574/CS0419: XML doc crefs reference sibling types in blocks-financial-ar and -ap. -->
    <NoWarn>CS1591;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialSubLedger.Projection.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <!-- LOW identity assembly — SubLedgerAccount + ISubLedgerReadModel interface +
         SubLedgerPosition/SubLedgerEntry/AgingSummary view types. -->
    <ProjectReference Include="..\blocks-financial-subledger\Harborline.Blocks.FinancialSubLedger.csproj" />
    <!-- AR cluster — Invoice + InvoiceStatus + IInvoiceRepository. -->
    <ProjectReference Include="..\blocks-financial-ar\Harborline.Blocks.FinancialAr.csproj" />
    <!-- AP cluster — Bill + BillStatus + IBillRepository. -->
    <ProjectReference Include="..\blocks-financial-ap\Harborline.Blocks.FinancialAp.csproj" />
    <!-- Payments cluster — Payment + PaymentApplication + IPaymentRepository + IPaymentApplicationRepository. -->
    <ProjectReference Include="..\blocks-financial-payments\Harborline.Blocks.FinancialPayments.csproj" />
  </ItemGroup>
</Project>
