@* FF10 (task #154) — cascades IFormFactorService to descendants and drives its lifecycle.
   Idiomatic Blazor mirror of the ui-react runtime's provider-less hook family: here a single
   provider component owns InitializeAsync() + the Changed -> StateHasChanged bridge so consumers
   just declare `[CascadingParameter] IFormFactorService? FormFactor` and read `.Current`. *@
@namespace Harborline.Api.UIAdapters.Blazor.FormFactor
@implements IAsyncDisposable
@inject IFormFactorService FormFactor

<CascadingValue Value="FormFactor" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            FormFactor.Changed += OnFormFactorChanged;
            await FormFactor.InitializeAsync();
        }
    }

    // Not IsFixed: the cascaded VALUE (the service instance) never changes, but its Current
    // property does — StateHasChanged() re-runs this component's render, which re-propagates the
    // (same-reference) CascadingValue to subscribers, who then re-read the mutated Current.
    private void OnFormFactorChanged() => InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        FormFactor.Changed -= OnFormFactorChanged;
        return ValueTask.CompletedTask;
    }
}
