@namespace Harborline.Api.UIAdapters.Blazor.Components.Utility
@inherits HarborlineComponentBase

<button type="button"
        class="@CombineClasses("sf-pdf-export")"
        style="@CombineStyles("min-width:24px;min-height:24px;")"
        disabled="@(Disabled || Busy)"
        aria-busy="@(Busy ? "true" : "false")"
        @attributes="AdditionalAttributes"
        @onclick="ExportAsync">
    @(Busy ? BusyLabel : Label)
</button>

@code {
    /// <summary>Displayed button label.</summary>
    [Parameter] public string Label { get; set; } = "Export PDF";

    /// <summary>Displayed while the host performs the export.</summary>
    [Parameter] public string BusyLabel { get; set; } = "Exporting…";

    /// <summary>Whether an export is in progress.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Whether the export action is unavailable.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Optional suggested file name.</summary>
    [Parameter] public string FileName { get; set; } = "export.pdf";

    /// <summary>Raised with the host-owned file name.</summary>
    [Parameter] public EventCallback<string> OnExport { get; set; }

    private Task ExportAsync() => Disabled || Busy ? Task.CompletedTask : OnExport.InvokeAsync(FileName);
}
