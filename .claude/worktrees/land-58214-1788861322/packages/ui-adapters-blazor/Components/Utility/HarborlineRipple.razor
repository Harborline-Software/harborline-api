@namespace Harborline.Api.UIAdapters.Blazor.Components.Utility
@inherits HarborlineComponentBase

@*
    HarborlineRipple — pointer-activated ripple effect overlay wrapping any
    element. Parity with ui-react Ripple.

    Purely decorative: the ripple layer is aria-hidden and pointer-events:none
    so it never intercepts interaction with the wrapped child.
*@

<span class="@CombineClasses("sf-ripple")"
      style="@CombineStyles("position:relative;display:inline-block;overflow:hidden;border-radius:inherit;")"
      @onclick="AddRipple"
      @attributes="AdditionalAttributes">
    @ChildContent
    <span class="sf-ripple__layer" aria-hidden="true"
          style="position:absolute;inset:0;pointer-events:none;overflow:hidden;border-radius:inherit;">
        @foreach (var r in _ripples)
        {
            <span @key="r.Id"
                  class="sf-ripple__wave"
                  style="position:absolute;inset-inline-start:@(r.X)px;top:@(r.Y)px;width:@(r.Size)px;height:@(r.Size)px;margin-inline-start:-@(r.Size / 2)px;margin-top:-@(r.Size / 2)px;border-radius:50%;background:currentColor;opacity:.25;animation:sf-ripple-wave @(DurationMs)ms ease-out forwards;"></span>
        }
    </span>
</span>

@if (_ripples.Count > 0)
{
    <style>
        @@keyframes sf-ripple-wave {
            from { transform: scale(0); opacity: .35; }
            to   { transform: scale(1); opacity: 0; }
        }
    </style>
}

@code {
    private sealed record RippleInstance(long Id, double X, double Y, double Size);

    private readonly List<RippleInstance> _ripples = new();
    private long _nextId;

    /// <summary>The wrapped element receiving the ripple.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Ripple animation duration in ms. Default 600.</summary>
    [Parameter] public int DurationMs { get; set; } = 600;

    /// <summary>Ripple diameter in px. Default 240.</summary>
    [Parameter] public double Size { get; set; } = 240;

    private async Task AddRipple(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        var ripple = new RippleInstance(_nextId++, e.OffsetX, e.OffsetY, Size);
        _ripples.Add(ripple);
        StateHasChanged();

        await Task.Delay(DurationMs + 50);
        _ripples.Remove(ripple);
        StateHasChanged();
    }
}
