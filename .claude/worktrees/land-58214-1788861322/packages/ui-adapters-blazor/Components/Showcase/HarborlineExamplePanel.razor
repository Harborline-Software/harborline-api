@using Harborline.Api.UIAdapters.Blazor.Components.Buttons
@using Harborline.Api.UIAdapters.Blazor.Components.Utility
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    HarborlineExamplePanel — per-catalog-leaf demo-page shell.

    ADR 0022. Used by every component-demo page in kitchen-sink (and, later,
    compat-telerik's demo host and any other provider library). One panel per
    catalog leaf — one URL, one focused demo. Composes with existing
    DemoSection for pages that have multiple sub-examples.
*@

<div class="sf-example-panel @(IsAspirational ? "sf-example-panel--aspirational" : "")">

    @* Header: breadcrumb, title, narrative *@
    <header class="sf-example-panel-header">
        @if (Breadcrumb is { Length: > 0 })
        {
            <HarborlineBreadcrumb Class="sf-example-panel-breadcrumb">
                @for (int i = 0; i < Breadcrumb.Length; i++)
                {
                    var crumb = Breadcrumb[i];
                    var isLast = i == Breadcrumb.Length - 1;
                    <HarborlineBreadcrumbItem IsActive="@isLast">@crumb</HarborlineBreadcrumbItem>
                }
            </HarborlineBreadcrumb>
        }
        <h1 class="sf-example-panel-title">
            @Title
            @if (IsAspirational)
            {
                <span class="sf-example-panel-aspirational-badge">ASPIRATIONAL</span>
            }
        </h1>
        @if (Narrative is not null)
        {
            <div class="sf-example-panel-narrative">
                @Narrative
            </div>
        }
    </header>

    @if (IsAspirational)
    {
        <section class="sf-example-panel-aspirational-body">
            <p><strong>Harborline component:</strong> not yet built.</p>
            @if (!string.IsNullOrEmpty(IntakeUrl))
            {
                <p><strong>Tracked under:</strong> <a href="@IntakeUrl" target="_blank" rel="noopener">@IntakeUrl</a></p>
            }
            @if (!string.IsNullOrEmpty(ParityReferenceUrl))
            {
                <p><strong>Parity reference:</strong> <a href="@ParityReferenceUrl" target="_blank" rel="noopener">@ParityReferenceUrl</a></p>
            }
            @if (AspirationalNotes is not null)
            {
                <div class="sf-example-panel-aspirational-notes">
                    @AspirationalNotes
                </div>
            }
        </section>
    }
    else
    {
        @* Toolbar: tab controls (left), theme controls (right) *@
        <div class="sf-example-panel-toolbar">
            @* Inline min-width/min-height satisfies WCAG 2.2 SC 2.5.8 (target-size)
               without relying on theme CSS, which the bUnit-axe harness does not
               load. The .razor.css already declares the same floor; the inline
               style is the structural minimum that travels with the markup. *@
            <div class="sf-example-panel-tabs"
                 role="tablist"
                 aria-label="@($"{Title} view")"
                 @ref="_tabsRef">
                <button type="button"
                        id="@GetTabId(Tab.Example)"
                        class="sf-example-panel-tab @(_activeTab == Tab.Example ? "sf-example-panel-tab--active" : "")"
                        style="min-width:24px;min-height:24px;"
                        role="tab"
                        aria-selected="@IsTabSelected(Tab.Example)"
                        aria-controls="@PanelId"
                        tabindex="@GetTabIndex(Tab.Example)"
                        @onclick="() => SetTab(Tab.Example)"
                        @onkeydown="eventArgs => HandleTabKeyDown(eventArgs, Tab.Example)"
                        @ref="_exampleTabRef">
                    @PanelLabels.Preview
                </button>
                <button type="button"
                        id="@GetTabId(Tab.Controls)"
                        class="sf-example-panel-tab @(_activeTab == Tab.Controls ? "sf-example-panel-tab--active" : "")"
                        style="min-width:24px;min-height:24px;"
                        role="tab"
                        aria-selected="@IsTabSelected(Tab.Controls)"
                        aria-controls="@PanelId"
                        tabindex="@GetTabIndex(Tab.Controls)"
                        @onclick="() => SetTab(Tab.Controls)"
                        @onkeydown="eventArgs => HandleTabKeyDown(eventArgs, Tab.Controls)"
                        @ref="_controlsTabRef">
                    @PanelLabels.Controls
                </button>
                <button type="button"
                        id="@GetTabId(Tab.Output)"
                        class="sf-example-panel-tab @(_activeTab == Tab.Output ? "sf-example-panel-tab--active" : "")"
                        style="min-width:24px;min-height:24px;"
                        role="tab"
                        aria-selected="@IsTabSelected(Tab.Output)"
                        aria-controls="@PanelId"
                        tabindex="@GetTabIndex(Tab.Output)"
                        @onclick="() => SetTab(Tab.Output)"
                        @onkeydown="eventArgs => HandleTabKeyDown(eventArgs, Tab.Output)"
                        @ref="_outputTabRef">
                    @PanelLabels.Output
                </button>
                @if (Sources is { Count: > 0 })
                {
                    <button type="button"
                            id="@GetTabId(Tab.Source)"
                            class="sf-example-panel-tab @(_activeTab == Tab.Source ? "sf-example-panel-tab--active" : "")"
                            style="min-width:24px;min-height:24px;"
                            role="tab"
                            aria-selected="@IsTabSelected(Tab.Source)"
                            aria-controls="@PanelId"
                            tabindex="@GetTabIndex(Tab.Source)"
                            @onclick="() => SetTab(Tab.Source)"
                            @onkeydown="eventArgs => HandleTabKeyDown(eventArgs, Tab.Source)"
                            @ref="_sourceTabRef">
                        @PanelLabels.Code
                    </button>
                }
            </div>
            @if (HasResourceActions)
            {
                <div class="sf-example-panel-actions">
                @if (!string.IsNullOrEmpty(PlaygroundUrl))
                {
                    <a class="sf-example-panel-action sf-example-panel-action--primary" href="@PlaygroundUrl">Open in playground</a>
                }
                @if (!string.IsNullOrEmpty(SpecificationUrl))
                {
                    <a class="sf-example-panel-action" href="@SpecificationUrl">Specification</a>
                }
                @if (!string.IsNullOrEmpty(GitHubUrl))
                {
                    <a class="sf-example-panel-action" style="min-width:24px;min-height:24px;" href="@GitHubUrl" target="_blank" rel="noopener">
                        Source
                        <HarborlineIcon Name="external-link" Size="IconSize.Small" />
                    </a>
                }
                </div>
            }
        </div>

        @* Content: EXAMPLE tab or VIEW SOURCE tab *@
        @if (_activeTab == Tab.Example)
        {
            <div id="@PanelId"
                 class="sf-example-panel-body"
                 role="tabpanel"
                 aria-labelledby="@GetTabId(_activeTab)"
                 tabindex="0">
                @Example
            </div>
        }
        else if (_activeTab == Tab.Controls)
        {
            <div id="@PanelId"
                 class="sf-example-panel-configurator"
                 role="tabpanel"
                 aria-labelledby="@GetTabId(_activeTab)"
                 tabindex="0">
                @if (Configurator is not null || ThemeControls is not null)
                {
                    @Configurator
                    @ThemeControls
                }
                else
                {
                    <p class="sf-example-panel-empty">This example has no configurable parameters.</p>
                }
            </div>
        }
        else if (_activeTab == Tab.Output)
        {
            <div id="@PanelId"
                 class="sf-example-panel-output"
                 role="tabpanel"
                 aria-labelledby="@GetTabId(_activeTab)"
                 tabindex="0"
                 aria-live="polite">
                @if (Output is not null)
                {
                    @Output
                }
                else
                {
                    <p class="sf-example-panel-empty">Events and returned values will appear here when the example exposes output.</p>
                }
            </div>
        }
        else
        {
            <div id="@PanelId"
                 class="sf-example-panel-source"
                 role="tabpanel"
                 aria-labelledby="@GetTabId(_activeTab)"
                 tabindex="0">
                <div class="sf-example-panel-source-header">
                    <div class="sf-example-panel-source-tabs">
                        @for (int i = 0; i < Sources!.Count; i++)
                        {
                            var idx = i;
                            var file = Sources[idx];
                            <button type="button"
                                    class="sf-example-panel-source-tab @(_activeSourceIndex == idx ? "sf-example-panel-source-tab--active" : "")"
                                    style="min-width:24px;min-height:24px;"
                                    @onclick="() => SetActiveSource(idx)">
                                @file.Name
                            </button>
                        }
                    </div>
                    <button type="button"
                            class="sf-example-panel-action"
                            style="min-width:24px;min-height:24px;"
                            @onclick="CopyActiveSourceAsync"
                            aria-label="@_copyLabel"
                            aria-live="polite">
                        <HarborlineIcon Name="copy" Size="IconSize.Small" />
                        <span>@_copyLabel</span>
                    </button>
                </div>
                <div class="sf-example-panel-source-viewer">
                    <pre class="sf-example-panel-pre"><code class="language-@GetLanguage(Sources[_activeSourceIndex])" @ref="_codeRef">@Sources[_activeSourceIndex].Content</code></pre>
                </div>
            </div>
        }

        @* Footer: tokens-guidelines link (decision D2) *@
        <footer class="sf-example-panel-footer">
            <a href="@TokensDocsUrl" class="sf-example-panel-footer-link" target="_blank" rel="noopener">
                Style with design tokens
                <HarborlineIcon Name="arrow-right" Size="IconSize.Small" />
            </a>
        </footer>
    }

</div>

@code {
    /// <summary>Title displayed in the panel header (e.g. "Button / Overview").</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Breadcrumb segments. Last segment is rendered active.</summary>
    [Parameter] public string[]? Breadcrumb { get; set; }

    /// <summary>Narrative prose rendered above the toolbar.</summary>
    [Parameter] public RenderFragment? Narrative { get; set; }

    /// <summary>Live example rendered in the EXAMPLE tab.</summary>
    [Parameter] public RenderFragment? Example { get; set; }

    /// <summary>Optional configurator sub-toolbar above the example (prop controls).</summary>
    [Parameter] public RenderFragment? Configurator { get; set; }

    [Parameter] public RenderFragment? Output { get; set; }

    /// <summary>Source files exposed in the VIEW SOURCE tab. Empty or null hides the tab.</summary>
    [Parameter] public IReadOnlyList<HarborlineSourceFile>? Sources { get; set; }

    /// <summary>GitHub URL to the primary source file. Null hides the EDIT ON GITHUB action.</summary>
    [Parameter] public string? GitHubUrl { get; set; }

    [Parameter] public string? PlaygroundUrl { get; set; }

    [Parameter] public string? SpecificationUrl { get; set; }

    /// <summary>Slot for theme/provider controls, rendered right-aligned in the toolbar.</summary>
    [Parameter] public RenderFragment? ThemeControls { get; set; }

    /// <summary>Link target for the "Style with design tokens" footer (decision D2).</summary>
    [Parameter] public string TokensDocsUrl { get; set; }
        = "https://github.com/Harborline-Software/shipyard/blob/main/_shared/design/tokens-guidelines.md";

    /// <summary>
    /// Render this panel as an aspirational placeholder (component not yet built).
    /// Hides tabs and source viewer; shows the intake and parity-reference links.
    /// </summary>
    [Parameter] public bool IsAspirational { get; set; }

    /// <summary>URL to the tracked intake document (aspirational mode only).</summary>
    [Parameter] public string? IntakeUrl { get; set; }

    /// <summary>Upstream parity reference URL (aspirational mode only).</summary>
    [Parameter] public string? ParityReferenceUrl { get; set; }

    /// <summary>Free-form prose for aspirational pages: "When this lands, the demo will show ...".</summary>
    [Parameter] public RenderFragment? AspirationalNotes { get; set; }

    /// <summary>Optional localized tab labels supplied by a host layout.</summary>
    [CascadingParameter] public HarborlineExamplePanelLabels? Labels { get; set; }

    private HarborlineExamplePanelLabels PanelLabels => Labels ?? new HarborlineExamplePanelLabels();

    private enum Tab { Example, Controls, Output, Source }
    private static readonly Tab[] TabsWithoutSource = [Tab.Example, Tab.Controls, Tab.Output];
    private static readonly Tab[] TabsWithSource = [Tab.Example, Tab.Controls, Tab.Output, Tab.Source];

    private readonly string _tabSetId = $"sf-example-panel-{Guid.NewGuid():N}";
    private Tab _activeTab = Tab.Example;
    private int _activeSourceIndex;
    private bool _pendingHighlight;
    private IJSObjectReference? _a11yModule;
    private IJSObjectReference? _clipboardModule;
    private string? _copyLabelOverride;
    private ElementReference _tabsRef;
    private ElementReference _exampleTabRef;
    private ElementReference _controlsTabRef;
    private ElementReference _outputTabRef;
    private ElementReference _sourceTabRef;
    private ElementReference _codeRef;

    private string PanelId => $"{_tabSetId}-panel";
    private bool HasResourceActions => !string.IsNullOrEmpty(PlaygroundUrl)
        || !string.IsNullOrEmpty(SpecificationUrl)
        || !string.IsNullOrEmpty(GitHubUrl);

    private string GetTabId(Tab tab) => $"{_tabSetId}-{tab.ToString().ToLowerInvariant()}-tab";
    private string IsTabSelected(Tab tab) => _activeTab == tab ? "true" : "false";
    private int GetTabIndex(Tab tab) => _activeTab == tab ? 0 : -1;

    private void SetTab(Tab tab)
    {
        _activeTab = tab;
        if (tab == Tab.Source) _pendingHighlight = true;
    }

    private async Task HandleTabKeyDown(KeyboardEventArgs eventArgs, Tab currentTab)
    {
        var tabs = Sources is { Count: > 0 } ? TabsWithSource : TabsWithoutSource;
        var currentIndex = Array.IndexOf(tabs, currentTab);
        var nextIndex = eventArgs.Key switch
        {
            "ArrowRight" => (currentIndex + 1) % tabs.Length,
            "ArrowLeft" => (currentIndex - 1 + tabs.Length) % tabs.Length,
            "Home" => 0,
            "End" => tabs.Length - 1,
            _ => -1,
        };

        if (currentIndex < 0 || nextIndex < 0) return;

        var nextTab = tabs[nextIndex];
        SetTab(nextTab);
        await InvokeAsync(StateHasChanged);
        await GetTabReference(nextTab).FocusAsync();
    }

    private ElementReference GetTabReference(Tab tab) => tab switch
    {
        Tab.Example => _exampleTabRef,
        Tab.Controls => _controlsTabRef,
        Tab.Output => _outputTabRef,
        Tab.Source => _sourceTabRef,
        _ => throw new ArgumentOutOfRangeException(nameof(tab)),
    };

    private void SetActiveSource(int index)
    {
        _activeSourceIndex = index;
        _pendingHighlight = true;
        _copyLabelOverride = null;
    }

    private string _copyLabel => _copyLabelOverride ?? PanelLabels.CopyCode;

    /// <summary>
    /// Copies the visible source file to the clipboard through the package's own clipboard module.
    /// Ticket 267: this replaced an inline <c>onclick</c> that called a browser global no module in
    /// this package (or any sibling repository) defined, so the button did nothing.
    /// </summary>
    private async Task CopyActiveSourceAsync()
    {
        if (Sources is not { Count: > 0 }) return;

        try
        {
            _clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                Harborline.Api.UIAdapters.Blazor.Internal.Interop.HarborlineJsModuleLoader.Resolve(
                    "js/harborline-clipboard-download.js"));
            await _clipboardModule.InvokeVoidAsync("writeText", Sources[_activeSourceIndex].Content);
            _copyLabelOverride = PanelLabels.CopyCodeSucceeded;
        }
        catch (JSException)
        {
            _copyLabelOverride = PanelLabels.CopyCodeFailed;
        }
        catch (InvalidOperationException)
        {
            // Prerendering: no JS runtime yet. The button is inert until the circuit is live.
            _copyLabelOverride = PanelLabels.CopyCodeFailed;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !IsAspirational)
        {
            try
            {
                _a11yModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    Harborline.Api.UIAdapters.Blazor.Internal.Interop.HarborlineJsModuleLoader.Resolve("js/harborline-a11y.js"));
                await _a11yModule.InvokeVoidAsync("preventExampleTabNavigationScroll", _tabsRef);
            }
            catch (JSException) { /* JS module not shipped / prerendering race */ }
            catch (InvalidOperationException) { /* prerender */ }
        }

        if (_pendingHighlight)
        {
            _pendingHighlight = false;
            try { await JS.InvokeVoidAsync("Prism.highlightElement", _codeRef); }
            catch { /* Prism not loaded; code is still readable */ }
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_clipboardModule is not null)
        {
            try { await _clipboardModule.DisposeAsync(); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }

        if (_a11yModule is null) return;

        try
        {
            await _a11yModule.InvokeVoidAsync("removeExampleTabNavigationScroll", _tabsRef);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }

        try { await _a11yModule.DisposeAsync(); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private static string GetLanguage(HarborlineSourceFile file) => file.Name switch
    {
        var n when n.EndsWith(".razor", StringComparison.OrdinalIgnoreCase) => "razor",
        var n when n.EndsWith(".cs", StringComparison.OrdinalIgnoreCase) => "csharp",
        var n when n.EndsWith(".css", StringComparison.OrdinalIgnoreCase) => "css",
        var n when n.EndsWith(".json", StringComparison.OrdinalIgnoreCase) => "json",
        var n when n.EndsWith(".yaml", StringComparison.OrdinalIgnoreCase)
                || n.EndsWith(".yml", StringComparison.OrdinalIgnoreCase) => "yaml",
        _ => "text",
    };
}
