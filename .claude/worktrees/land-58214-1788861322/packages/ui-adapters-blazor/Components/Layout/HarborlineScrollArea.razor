@namespace Harborline.Api.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase

<div class="@CombineClasses("sf-scroll-area", $"sf-scroll-area--{Orientation.ToLowerInvariant()}")" style="@CombineStyles(ScrollStyle)" role="region" aria-label="@AriaLabel" tabindex="0" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public string? AriaLabel { get; set; } = "Scrollable content";
    [Parameter] public string Orientation { get; set; } = "vertical";
    [Parameter] public string? MaxHeight { get; set; } = "20rem";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ScrollStyle => Orientation.Equals("horizontal", StringComparison.OrdinalIgnoreCase)
        ? $"overflow-x:auto;max-width:100%;{(MaxHeight is null ? "" : $"max-height:{MaxHeight};")}"
        : $"overflow-y:auto;max-height:{MaxHeight ?? "none"};";
}
