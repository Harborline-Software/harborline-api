@namespace Harborline.Api.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase
<div class="@CombineClasses("sf-app-layout")" style="@CombineStyles()" @attributes="AdditionalAttributes">
    @if (Header is not null)
    {
        <div class="sf-app-layout__header">@Header</div>
    }
    <div class="sf-app-layout__content">@ChildContent</div>
</div>
@code { [Parameter] public RenderFragment? Header { get; set; } [Parameter] public RenderFragment? ChildContent { get; set; } }
