@namespace Harborline.Api.UIAdapters.Blazor.Components.Structural
@inherits HarborlineComponentBase

<div class="@CombineClasses("sf-list-toolbar")"
     role="toolbar"
     aria-label="@(AriaLabel ?? "List toolbar")"
     @attributes="AdditionalAttributes">
    @if (Search is not null)
    {
        <div class="sf-list-toolbar__search">@Search</div>
    }
    @if (Filters is not null)
    {
        <div class="sf-list-toolbar__filters">@Filters</div>
    }
    @if (Actions is not null)
    {
        <div class="sf-list-toolbar__actions">@Actions</div>
    }
    @if (HasActiveFilters && OnClear.HasDelegate)
    {
        <button type="button" class="sf-list-toolbar__clear" @onclick="OnClear">Clear filters</button>
    }
</div>

@code {
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public RenderFragment? Search { get; set; }
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool HasActiveFilters { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
}
