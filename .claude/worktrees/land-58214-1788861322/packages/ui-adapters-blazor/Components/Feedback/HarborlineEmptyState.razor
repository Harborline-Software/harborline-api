@namespace Harborline.Api.UIAdapters.Blazor.Components.Feedback
@inherits HarborlineComponentBase

<div class="@CombineClasses("sf-empty-state")" style="@CombineStyles()" @attributes="AdditionalAttributes">
    <span class="sf-empty-state__icon" aria-hidden="true">@IconProvider.GetIconMarkup(IconName, IconSize.Medium)</span>
    <p class="sf-empty-state__title">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="sf-empty-state__description">@Description</p>
    }
    @if (ActionLabel is not null)
    {
        <HarborlineButton Variant="ButtonVariant.Secondary" OnClick="HandleAction">@ActionLabel</HarborlineButton>
    }
</div>

@code {
    [Parameter] public EmptyStateVariant Variant { get; set; } = EmptyStateVariant.Informational;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }

    private string IconName => Variant switch
    {
        EmptyStateVariant.Positive => "circle-check",
        EmptyStateVariant.Actionable => "circle-plus",
        _ => "info",
    };

    private Task HandleAction(MouseEventArgs _) => OnAction.InvokeAsync();
}
