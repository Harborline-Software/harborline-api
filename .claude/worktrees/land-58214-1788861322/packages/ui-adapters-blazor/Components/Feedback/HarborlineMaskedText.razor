@namespace Harborline.Api.UIAdapters.Blazor.Components.Feedback
@inherits HarborlineComponentBase

@*
    HarborlineMaskedText — obfuscated sensitive value with reveal-on-click toggle.
    Parity with ui-react MaskedText (Value, VisibleChars, MaskChar, Label).

    The reveal control is a toggle button: aria-pressed tracks the revealed
    state and the accessible name never contains the secret itself.
*@

<span class="@CombineClasses("sf-masked-text")"
      style="@CombineStyles("display:inline-flex;align-items:center;gap:.5rem;")"
      @attributes="AdditionalAttributes">
    <code class="sf-masked-text__value"
          style="font-family:var(--font-family-mono, monospace);font-size:.85rem;letter-spacing:.05em;"
          aria-label="@(Label ?? "Masked value")">@DisplayValue</code>
    <button type="button"
            class="sf-masked-text__toggle"
            style="min-width:24px;min-height:24px;border:1px solid var(--color-border);background:transparent;border-radius:.25rem;padding:.1rem .45rem;font-size:.75rem;cursor:pointer;"
            aria-pressed="@(_revealed ? "true" : "false")"
            aria-label="@ToggleAriaLabel"
            @onclick="Toggle">
        @(_revealed ? "Hide" : "Reveal")
    </button>
</span>

@code {
    private bool _revealed;

    /// <summary>The sensitive value to mask.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    /// <summary>How many trailing characters remain visible while masked. Default 4.</summary>
    [Parameter] public int VisibleChars { get; set; } = 4;

    /// <summary>Character used for the masked portion. Default '•'.</summary>
    [Parameter] public char MaskChar { get; set; } = '•';

    /// <summary>Accessible label for the value (e.g. "Card number"). Used in the toggle's aria-label.</summary>
    [Parameter] public string? Label { get; set; }

    private string DisplayValue
    {
        get
        {
            if (_revealed) return Value;
            var visible = Math.Clamp(VisibleChars, 0, Value.Length);
            return new string(MaskChar, Value.Length - visible) + Value[^visible..];
        }
    }

    private string ToggleAriaLabel
    {
        get
        {
            var noun = string.IsNullOrEmpty(Label) ? "masked value" : Label!;
            return _revealed ? $"Hide {noun}" : $"Reveal {noun}";
        }
    }

    private void Toggle() => _revealed = !_revealed;
}
