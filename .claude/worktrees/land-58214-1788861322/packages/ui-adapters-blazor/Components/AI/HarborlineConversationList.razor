@namespace Harborline.Api.UIAdapters.Blazor.Components.AI
@inherits HarborlineComponentBase

<section class="@CombineClasses("sf-conversation-list")"
         style="@CombineStyles()"
         aria-label="@(AriaLabel ?? "Conversations")"
         @attributes="AdditionalAttributes">
    @if (Conversations is { Count: > 0 })
    {
        <div class="sf-conversation-list__header">
            <h2>@(Heading ?? "Conversations")</h2>
            @if (OnNew.HasDelegate)
            {
                <button type="button" style="min-width:24px;min-height:24px;" @onclick="NewAsync">New conversation</button>
            }
        </div>
        <ul>
            @foreach (var conversation in Conversations)
            {
                <li class="sf-conversation-list__item">
                    <button type="button"
                            class="sf-conversation-list__select"
                            style="min-width:24px;min-height:24px;"
                            aria-current="@(string.Equals(ActiveId, conversation.Id, StringComparison.Ordinal) ? "true" : null)"
                            @onclick="() => SelectAsync(conversation.Id)">
                        <span>@conversation.Title</span>
                        @if (!string.IsNullOrWhiteSpace(conversation.Preview))
                        {
                            <small>@conversation.Preview</small>
                        }
                        <time>@conversation.Timestamp</time>
                    </button>
                    @if (OnRename.HasDelegate)
                    {
                        <button type="button"
                                style="min-width:24px;min-height:24px;"
                                aria-label="Rename @conversation.Title"
                                @onclick="() => RenameAsync(conversation)">Rename</button>
                    }
                    @if (OnDelete.HasDelegate)
                    {
                        <button type="button"
                                style="min-width:24px;min-height:24px;"
                                aria-label="Delete @conversation.Title"
                                @onclick="() => DeleteAsync(conversation.Id)">Delete</button>
                    }
                </li>
            }
        </ul>
    }
    else if (Conversations is not null)
    {
        <p>@(EmptyText ?? "No conversations yet.")</p>
        @if (OnNew.HasDelegate)
        {
            <button type="button" style="min-width:24px;min-height:24px;" @onclick="NewAsync">New conversation</button>
        }
    }
    else
    {
        <ul>@ChildContent</ul>
    }
</section>

@code {
    /// <summary>Optional conversation summaries. Null preserves the child-content API.</summary>
    [Parameter] public IReadOnlyList<ConversationSummary>? Conversations { get; set; }

    /// <summary>Currently selected conversation id.</summary>
    [Parameter] public string? ActiveId { get; set; }

    /// <summary>Raised when a conversation is selected.</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Raised when the user requests a new conversation.</summary>
    [Parameter] public EventCallback OnNew { get; set; }

    /// <summary>Raised when a conversation should be renamed.</summary>
    [Parameter] public EventCallback<ConversationRenameEventArgs> OnRename { get; set; }

    /// <summary>Raised when a conversation should be deleted.</summary>
    [Parameter] public EventCallback<string> OnDelete { get; set; }

    /// <summary>Accessible region label. Falls back to Conversations when null.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Visible heading.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>Empty state text.</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Legacy/manual child content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task SelectAsync(string id) => OnSelect.InvokeAsync(id);

    private Task NewAsync() => OnNew.InvokeAsync();

    private Task RenameAsync(ConversationSummary conversation)
        => OnRename.InvokeAsync(new ConversationRenameEventArgs(conversation.Id, conversation.Title));

    private Task DeleteAsync(string id) => OnDelete.InvokeAsync(id);
}
