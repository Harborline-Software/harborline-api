@namespace Harborline.Api.UIAdapters.Blazor.Components.DataDisplay
@inherits HarborlineComponentBase

<section class="@CombineClasses("sf-code-block")"
         style="@CombineStyles("overflow:hidden;border:1px solid var(--color-border);border-radius:.375rem;background:var(--color-muted);")"
         aria-label="@(FileName ?? Language ?? "Code")"
         @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(FileName) || !string.IsNullOrWhiteSpace(Language))
    {
        <header class="sf-code-block__header" style="display:flex;align-items:center;justify-content:space-between;padding:.5rem .75rem;border-block-end:1px solid var(--color-border);">
            <span>@(FileName ?? Language)</span>
            <button type="button" style="min-width:24px;min-height:24px;" @onclick="CopyAsync">@(Copied ? "Copied" : "Copy")</button>
        </header>
    }
    <pre class="sf-code-block__code" tabindex="0" style="overflow:auto;margin:0;padding:.75rem;font-family:var(--font-family-mono,monospace);"><code>@if (ShowLineNumbers)
        {
            @for (var i = 0; i < Lines.Length; i++)
            {
                <span class="sf-code-block__line"><span aria-hidden="true" style="display:inline-block;min-inline-size:2rem;color:var(--color-muted-foreground);">@(i + 1)</span>@Lines[i]</span>
            }
        }
        else
        {
            @Code
        }</code></pre>
</section>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = string.Empty;
    [Parameter] public string? Language { get; set; }
    [Parameter] public string? FileName { get; set; }
    [Parameter] public bool ShowLineNumbers { get; set; }
    [Parameter] public EventCallback OnCopy { get; set; }

    private bool Copied { get; set; }
    private string[] Lines => Code.Split('\n');

    private async Task CopyAsync()
    {
        Copied = true;
        await OnCopy.InvokeAsync();
    }
}
