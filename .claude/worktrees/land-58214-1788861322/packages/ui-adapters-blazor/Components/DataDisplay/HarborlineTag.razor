@namespace Harborline.Api.UIAdapters.Blazor.Components.DataDisplay
@inherits HarborlineComponentBase

@*
    HarborlineTag — taxonomy/filter chip. Parity with ui-react Tag
    (label, color, size, onRemove, disabled).
*@

<span class="@CombineClasses($"sf-tag sf-tag--{Color} sf-tag--{SizeSuffix}")"
      style="@CombineStyles($"display:inline-flex;align-items:center;gap:.3rem;border-radius:9999px;font-weight:500;{SizeStyle}background:{Palette.Background};color:{Palette.Foreground};")"
      aria-disabled="@(Disabled ? "true" : null)"
      @attributes="AdditionalAttributes">
    <span class="sf-tag__label">@Label</span>
    @if (OnRemove.HasDelegate)
    {
        <button type="button"
                class="sf-tag__remove"
                style="border:none;background:transparent;cursor:@(Disabled ? "not-allowed" : "pointer");color:inherit;opacity:@(Disabled ? ".4" : ".7");font-size:.9em;line-height:1;padding:0;"
                aria-label="@($"Remove {Label}")"
                disabled="@Disabled"
                @onclick="HandleRemove">✕</button>
    }
</span>

@code {
    private static readonly Dictionary<string, (string Background, string Foreground)> _palette = new(StringComparer.OrdinalIgnoreCase)
    {
        ["gray"] = ("#f3f4f6", "#374151"),
        ["blue"] = ("#dbeafe", "#1e40af"),
        ["green"] = ("#dcfce7", "#166534"),
        ["amber"] = ("#fef3c7", "#92400e"),
        ["red"] = ("#fee2e2", "#991b1b"),
        ["purple"] = ("#f3e8ff", "#6b21a8"),
        ["teal"] = ("#ccfbf1", "#115e59"),
    };

    /// <summary>Visible chip text.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Palette color: gray, blue, green, amber, red, purple, teal. Default gray.</summary>
    [Parameter] public string Color { get; set; } = "gray";

    /// <summary>Chip size: Small or Medium.</summary>
    [Parameter] public TagSize Size { get; set; } = TagSize.Medium;

    /// <summary>When set, renders a remove button firing this callback.</summary>
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>Disables the remove button.</summary>
    [Parameter] public bool Disabled { get; set; }

    private (string Background, string Foreground) Palette =>
        _palette.TryGetValue(Color, out var p) ? p : _palette["gray"];

    private string SizeSuffix => Size == TagSize.Small ? "sm" : "md";

    private string SizeStyle => Size == TagSize.Small
        ? "font-size:.7rem;padding:.1rem .5rem;"
        : "font-size:.8rem;padding:.15rem .65rem;";

    private Task HandleRemove() => Disabled || !OnRemove.HasDelegate
        ? Task.CompletedTask
        : OnRemove.InvokeAsync();
}
