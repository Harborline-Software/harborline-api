@namespace Harborline.Api.UIAdapters.Blazor.Components.DataDisplay
@inherits HarborlineComponentBase

<mark class="@CombineClasses($"sf-highlight sf-highlight--{ColorClass}")"
      style="@CombineStyles("background:var(--color-selected);color:var(--color-foreground);")"
      @attributes="AdditionalAttributes">@ChildContent</mark>

@code {
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string ColorClass => Color.Trim().ToLowerInvariant() switch
    {
        "warning" or "success" or "danger" => Color.Trim().ToLowerInvariant(),
        _ => "primary",
    };
}
