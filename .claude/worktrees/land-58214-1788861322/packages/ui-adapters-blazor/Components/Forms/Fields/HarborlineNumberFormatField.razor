@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Fields
@inherits HarborlineFieldBase

<HarborlineField Text="@Text" Id="@FieldId" Hint="@Hint" Error="@Error"
               Required="@EffectiveRequired" Disabled="@EffectiveDisabled"
               Class="@Class" Style="@Style" AdditionalAttributes="@AdditionalAttributes">
    <div class="@CssProvider.TextBoxClass(HasError, EffectiveDisabled) sf-number-format-field">
        @if (!string.IsNullOrEmpty(Prefix))
        {
            <span class="sf-number-format-field__prefix" aria-hidden="true">@Prefix</span>
        }
        <input type="text"
               inputmode="decimal"
               value="@DisplayValue"
               placeholder="@Placeholder"
               disabled="@EffectiveDisabled"
               readonly="@ReadOnly"
               aria-label="@EffectiveAriaLabel"
               aria-invalid="@AriaInvalid"
               aria-required="@AriaRequired"
               aria-describedby="@DescribedBy"
               @onfocus="HandleFocus"
               @onblur="HandleBlur"
               @onchange="HandleChange" />
        @if (!string.IsNullOrEmpty(Suffix))
        {
            <span class="sf-number-format-field__suffix" aria-hidden="true">@Suffix</span>
        }
    </div>
</HarborlineField>

@code {
    /// <summary>The raw decimal value as a string (invariant "." separator), preserving precision.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Inline adornment rendered before the input (e.g. a currency symbol).</summary>
    [Parameter] public string? Prefix { get; set; }

    /// <summary>Inline adornment rendered after the input (e.g. "%").</summary>
    [Parameter] public string? Suffix { get; set; }

    [Parameter] public int MaximumFractionDigits { get; set; } = 2;
    [Parameter] public int MinimumFractionDigits { get; set; }
    [Parameter] public bool UseGrouping { get; set; } = true;

    /// <summary>Culture used for the blurred display formatting. Defaults to the current UI culture.</summary>
    [Parameter] public string? CultureName { get; set; }

    /// <summary>Optional inclusive bounds applied when the input is committed.</summary>
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }

    private bool _isFocused;

    private System.Globalization.CultureInfo Culture => CultureName is null
        ? System.Globalization.CultureInfo.CurrentUICulture
        : System.Globalization.CultureInfo.GetCultureInfo(CultureName);

    private string DisplayValue
    {
        get
        {
            if (_isFocused)
            {
                return Value;
            }

            if (decimal.TryParse(Value, System.Globalization.NumberStyles.Number,
                    System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                var pattern = (UseGrouping ? "#,##0" : "0")
                    + (MaximumFractionDigits > 0
                        ? "." + new string('0', MinimumFractionDigits)
                            + new string('#', Math.Max(0, MaximumFractionDigits - MinimumFractionDigits))
                        : string.Empty);
                return parsed.ToString(pattern, Culture);
            }

            return Value;
        }
    }

    private void HandleFocus() => _isFocused = true;

    private void HandleBlur() => _isFocused = false;

    private async Task HandleChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        if (decimal.TryParse(raw, System.Globalization.NumberStyles.Number, Culture, out var parsed))
        {
            if (Min.HasValue && parsed < Min.Value) parsed = Min.Value;
            if (Max.HasValue && parsed > Max.Value) parsed = Max.Value;
            Value = parsed.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
        else
        {
            Value = raw;
        }

        await ValueChanged.InvokeAsync(Value);
    }
}
