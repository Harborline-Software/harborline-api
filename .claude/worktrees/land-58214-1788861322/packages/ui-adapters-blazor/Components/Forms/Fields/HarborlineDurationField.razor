@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Fields
@inherits HarborlineFieldBase

<HarborlineField Text="@Text" Id="@FieldId" Hint="@Hint" Error="@Error"
               Required="@EffectiveRequired" Disabled="@EffectiveDisabled"
               Class="@Class" Style="@Style" AdditionalAttributes="@AdditionalAttributes">
    <div class="sf-duration-field" role="group"
         aria-label="@EffectiveAriaLabel"
         aria-describedby="@DescribedBy">
        <HarborlineNumericInput TValue="int" Value="@Hours" ValueChanged="@(v => SetUnit(v, Minutes, Seconds))"
                              Min="0" Disabled="@EffectiveDisabled" IsInvalid="@HasError"
                              aria-label="@HoursLabel" />
        <HarborlineNumericInput TValue="int" Value="@Minutes" ValueChanged="@(v => SetUnit(Hours, v, Seconds))"
                              Min="0" Max="59" Disabled="@EffectiveDisabled" IsInvalid="@HasError"
                              aria-label="@MinutesLabel" />
        @if (ShowSeconds)
        {
            <HarborlineNumericInput TValue="int" Value="@Seconds" ValueChanged="@(v => SetUnit(Hours, Minutes, v))"
                                  Min="0" Max="59" Disabled="@EffectiveDisabled" IsInvalid="@HasError"
                                  aria-label="@SecondsLabel" />
        }
    </div>
</HarborlineField>

@code {
    /// <summary>Total duration in seconds, mirroring the React DurationField value contract.</summary>
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    /// <summary>"hm" (default) or "hms" — whether the seconds stepper is rendered.</summary>
    [Parameter] public string Format { get; set; } = "hm";

    /// <summary>Localizable codes (or labels) for the unit steppers.</summary>
    [Parameter] public string HoursLabel { get; set; } = "forms.durationField.hours";
    [Parameter] public string MinutesLabel { get; set; } = "forms.durationField.minutes";
    [Parameter] public string SecondsLabel { get; set; } = "forms.durationField.seconds";

    private bool ShowSeconds => string.Equals(Format, "hms", StringComparison.OrdinalIgnoreCase);

    private int Hours => Value / 3600;
    private int Minutes => Value % 3600 / 60;
    private int Seconds => Value % 60;

    private async Task SetUnit(int hours, int minutes, int seconds)
    {
        Value = Math.Max(0, hours) * 3600 + Math.Clamp(minutes, 0, 59) * 60 + Math.Clamp(seconds, 0, 59);
        await ValueChanged.InvokeAsync(Value);
    }
}
