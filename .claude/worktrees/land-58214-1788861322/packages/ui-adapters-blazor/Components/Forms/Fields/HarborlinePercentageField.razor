@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Fields
@inherits HarborlineFieldBase

<HarborlineNumberFormatField Text="@Text" Id="@Id" Hint="@Hint" Error="@Error"
                           Required="@Required" Disabled="@Disabled"
                           AriaLabel="@AriaLabel"
                           Class="@Class" Style="@Style" AdditionalAttributes="@AdditionalAttributes"
                           Value="@Value" ValueChanged="@ValueChanged"
                           Suffix="%" Placeholder="@Placeholder"
                           MaximumFractionDigits="@MaximumFractionDigits"
                           UseGrouping="false" CultureName="@CultureName"
                           Min="@Min" Max="@Max" ReadOnly="@ReadOnly" />

@code {
    /// <summary>The raw percentage as a string (invariant "." separator). Clamped to Min–Max on commit.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? CultureName { get; set; }
    [Parameter] public int MaximumFractionDigits { get; set; } = 2;

    /// <summary>Inclusive bounds; the React PercentageField default clamp is 0–100.</summary>
    [Parameter] public decimal? Min { get; set; } = 0m;
    [Parameter] public decimal? Max { get; set; } = 100m;
    [Parameter] public bool ReadOnly { get; set; }
}
