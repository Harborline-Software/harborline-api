@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Fields
@typeparam TItem
@typeparam TValue
@inherits HarborlineFieldBase

<HarborlineField Text="@Text" Id="@FieldId" Hint="@Hint" Error="@Error"
               Required="@EffectiveRequired" Disabled="@EffectiveDisabled"
               Class="@Class" Style="@Style" AdditionalAttributes="@AdditionalAttributes">
    <HarborlineComboBox TItem="TItem" TValue="TValue" Data="@Data"
                      TextField="@TextField" ValueField="@ValueField"
                      Value="@Value" ValueChanged="@ValueChanged"
                      Placeholder="@Placeholder" Disabled="@EffectiveDisabled"
                      IsInvalid="@HasError" ShowClearButton="@ShowClearButton"
                      aria-label="@EffectiveAriaLabel"
                      aria-invalid="@AriaInvalid"
                      aria-required="@AriaRequired"
                      aria-describedby="@DescribedBy" />
</HarborlineField>

@code {
    [Parameter] public IEnumerable<TItem> Data { get; set; } = Enumerable.Empty<TItem>();
    [Parameter] public string? TextField { get; set; }
    [Parameter] public string? ValueField { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ShowClearButton { get; set; }
}
