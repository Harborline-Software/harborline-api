@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Containers
@inherits HarborlineComponentBase

<fieldset class="@CombineClasses("sf-form-section", Disabled ? "sf-form-section--disabled" : null)"
          style="@CombineStyles()" disabled="@(Disabled ? "disabled" : null)"
          @attributes="AdditionalAttributes">
    <legend>@Title</legend>
    @if (Description is not null)
    {
        <div class="sf-form-section__description">@Description</div>
    }
    <div class="sf-form-section__content"
         style="grid-template-columns:repeat(@Columns, minmax(0, 1fr)); gap:@Gap;">
        @ChildContent
    </div>
</fieldset>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Columns { get; set; } = 1;
    [Parameter] public string Gap { get; set; } = "1rem";
    [Parameter] public bool Disabled { get; set; }
}
