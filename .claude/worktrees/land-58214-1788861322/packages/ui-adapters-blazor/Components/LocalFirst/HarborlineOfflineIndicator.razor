@namespace Harborline.Api.UIAdapters.Blazor.Components.LocalFirst
@inherits HarborlineComponentBase

@*
    HarborlineOfflineIndicator — offline warning strip. Parity with ui-react
    OfflineIndicator (message + offline detection).

    Connectivity is parameter-driven (Offline) so hosts wire their own
    transport signal (SignalR circuit state, navigator.onLine interop, sync
    engine heartbeat). Renders nothing while online.
*@

@if (Offline)
{
    <div class="@CombineClasses("sf-offline-indicator")"
         style="@CombineStyles("display:flex;align-items:center;gap:.5rem;border-radius:.375rem;background:var(--color-warning-soft);border:1px solid var(--color-warning);color:var(--color-foreground);padding:.5rem 1rem;font-size:.875rem;")"
         role="alert"
         aria-label="@(AriaLabel ?? Message)"
         @attributes="AdditionalAttributes">
        <span aria-hidden="true">⚠</span>
        <span>@Message</span>
    </div>
}

@code {
    /// <summary>Whether the host is currently offline. Default false (renders nothing).</summary>
    [Parameter] public bool Offline { get; set; }

    /// <summary>Message shown while offline.</summary>
    [Parameter] public string Message { get; set; } = "You are offline. Changes will sync when reconnected.";

    /// <summary>Accessible label override for the alert.</summary>
    [Parameter] public string? AriaLabel { get; set; }
}
