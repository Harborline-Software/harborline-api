@inherits HarborlineComponentBase

<button class="@CombineClasses(CssProvider.ButtonClass(Variant, Size, FillMode, Rounded, IsDisabled), IsIconOnly ? "sf-button--icon-only" : null)"
        style="@CombineStyles()"
        type="@ButtonType.ToString().ToLowerInvariant()"
        disabled="@IsDisabled"
        aria-busy="@(Loading ? "true" : null)"
        form="@Form"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="@CombineClasses("sf-button__loading-indicator", CssProvider.SpinnerClass(SpinnerSize.Small))"
              aria-hidden="true"></span>
    }
    else if (LeadingIcon != null || Icon != null)
    {
        <span class="sf-button__icon">@(LeadingIcon ?? Icon)</span>
    }
    @ChildContent
    @if (TrailingIcon != null)
    {
        <span class="sf-button__icon sf-button__icon--trailing">@TrailingIcon</span>
    }
</button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter] public FillMode FillMode { get; set; } = FillMode.Solid;
    [Parameter] public RoundedMode Rounded { get; set; } = RoundedMode.Medium;

    /// <summary>Whether the button is enabled. Defaults to true.</summary>
    [Parameter] public bool Enabled { get; set; } = true;

    /// <summary>Shows a leading progress indicator and makes the button inert.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The HTML button type (Button, Submit, Reset). Defaults to Button.</summary>
    [Parameter] public ButtonType ButtonType { get; set; } = ButtonType.Button;

    /// <summary>Associates the button with a form element by id.</summary>
    [Parameter] public string? Form { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional content rendered before the button label.</summary>
    [Parameter] public RenderFragment? LeadingIcon { get; set; }

    /// <summary>Optional content rendered after the button label.</summary>
    [Parameter] public RenderFragment? TrailingIcon { get; set; }

    /// <summary>Legacy alias for <see cref="LeadingIcon"/>.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>
    /// True when the button renders only an Icon (no text/ChildContent).
    /// Emits the sf-button--icon-only modifier so providers can apply square
    /// icon-button sizing (aspect-ratio 1:1, matched to density tier).
    /// </summary>
    private bool IsDisabled => !Enabled || Loading;
    private bool IsIconOnly => (LeadingIcon != null || Icon != null) && ChildContent == null;
}
