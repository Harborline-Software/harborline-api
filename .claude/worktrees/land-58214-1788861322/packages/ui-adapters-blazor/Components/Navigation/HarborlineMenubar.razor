@namespace Harborline.Api.UIAdapters.Blazor.Components.Navigation
@inherits HarborlineComponentBase
<div class="@CombineClasses("sf-menubar")" style="@CombineStyles()" role="menubar" aria-label="@(AriaLabel ?? "Application")" @attributes="AdditionalAttributes" @onkeydown="HandleKeyDown">
    @foreach (var menu in Items)
    {
        <button type="button"
                id="@MenuId(menu)"
                role="menuitem"
                aria-haspopup="menu"
                aria-expanded="@((_openId == menu.Id).ToString().ToLowerInvariant())"
                aria-controls="@PopupId(menu)"
                aria-disabled="@(menu.Disabled ? "true" : null)"
                style="min-width:24px;min-height:24px;"
                @key="menu.Id"
                @onclick="() => Toggle(menu)">
            @menu.Label
        </button>
    }
    @foreach (var menu in Items.Where(m => m.Id == _openId))
    {
        <div id="@PopupId(menu)" class="sf-menubar__menu" role="menu" aria-labelledby="@MenuId(menu)">
            @RenderItems(menu.Items)
        </div>
    }
</div>
@code {
    private readonly string _id = $"sf-menubar-{Guid.NewGuid():N}";
    private string? _openId;
    private string? _openSubId;

    /// <summary>The top-level menus, each carrying its entries in <see cref="MenubarItem.Items"/>.</summary>
    [Parameter] public IReadOnlyList<MenubarItem> Items { get; set; } = [];

    /// <summary>Raised when a command entry is activated.</summary>
    [Parameter] public EventCallback<MenubarItem> ItemSelected { get; set; }

    /// <summary>Raised when a checkbox or radio entry is toggled; the item reflects the requested state.</summary>
    [Parameter] public EventCallback<MenubarItem> ItemToggled { get; set; }

    /// <summary>Accessible name of the menubar. Falls back to "Application".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private string MenuId(MenubarItem menu) => $"{_id}-menu-{menu.Id}";

    private string PopupId(MenubarItem menu) => $"{_id}-popup-{menu.Id}";

    private void Toggle(MenubarItem menu)
    {
        if (menu.Disabled)
        {
            return;
        }

        _openId = _openId == menu.Id ? null : menu.Id;
        _openSubId = null;
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            if (_openSubId != null)
            {
                _openSubId = null;
            }
            else
            {
                _openId = null;
            }
        }
    }

    private async Task ActivateAsync(MenubarItem item)
    {
        if (item.Disabled)
        {
            return;
        }
        switch (item.Type)
        {
            case MenubarItemType.Sub:
                _openSubId = _openSubId == item.Id ? null : item.Id;
                return;
            case MenubarItemType.Checkbox:
            case MenubarItemType.Radio:
                await ItemToggled.InvokeAsync(item);
                return;
            default:
                await ItemSelected.InvokeAsync(item);
                _openId = null;
                _openSubId = null;
                return;
        }
    }

    private RenderFragment RenderItems(IReadOnlyList<MenubarItem> items) => builder =>
    {
        var seq = 0;
        foreach (var item in items)
        {
            if (item.Type == MenubarItemType.Separator)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "role", "separator");
                builder.AddAttribute(seq++, "class", "sf-menubar__separator");
                builder.CloseElement();
                continue;
            }

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "role", item.Type switch
            {
                MenubarItemType.Checkbox => "menuitemcheckbox",
                MenubarItemType.Radio => "menuitemradio",
                _ => "menuitem",
            });
            if (item.Type is MenubarItemType.Checkbox or MenubarItemType.Radio)
            {
                builder.AddAttribute(seq++, "aria-checked", item.Checked.ToString().ToLowerInvariant());
            }
            if (item.Type == MenubarItemType.Sub)
            {
                builder.AddAttribute(seq++, "aria-haspopup", "menu");
                builder.AddAttribute(seq++, "aria-expanded", (_openSubId == item.Id).ToString().ToLowerInvariant());
            }
            if (item.Disabled)
            {
                builder.AddAttribute(seq++, "aria-disabled", "true");
            }
            builder.AddAttribute(seq++, "class", "sf-menubar__item");
            builder.AddAttribute(seq++, "style", "min-width:24px;min-height:24px;");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ActivateAsync(item)));
            builder.SetKey(item.Id);
            builder.AddContent(seq++, item.Label);
            builder.CloseElement();

            if (item.Type == MenubarItemType.Sub && _openSubId == item.Id)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "role", "menu");
                builder.AddAttribute(seq++, "aria-label", item.Label);
                builder.AddAttribute(seq++, "class", "sf-menubar__submenu");
                builder.AddContent(seq++, RenderItems(item.Items));
                builder.CloseElement();
            }
        }
    };
}
