@namespace Harborline.Api.UIAdapters.Blazor.Components.Navigation
@inherits HarborlineComponentBase
<section class="@CombineClasses("sf-activity-log")" style="@CombineStyles()" aria-label="@(AriaLabel ?? "Activity log")" @attributes="AdditionalAttributes">
    @if (Items is not null)
    {
        @if (Layout == ActivityLogLayout.Table)
        {
            <table>
                <thead><tr><th scope="col">When</th><th scope="col">Actor</th><th scope="col">Activity</th><th scope="col">Target</th></tr></thead>
                <tbody>
                    @foreach (var item in VisibleItems)
                    {
                        <tr><td>@item.Timestamp.ToString("g")</td><td>@item.Actor</td><td>@item.Action</td><td>@item.Target</td></tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <ol class="sf-activity-log__list">
                @foreach (var item in VisibleItems)
                {
                    <li><time datetime="@item.Timestamp.ToString("O")">@item.Timestamp.ToString("g")</time><strong>@item.Actor</strong><span>@item.Action · @item.Target</span></li>
                }
            </ol>
        }
        @if (HasMore)
        {
            <button type="button" @onclick="ShowMoreAsync">@ShowMoreLabel</button>
        }
    }
    else
    {
        <ul>@ChildContent</ul>
    }
</section>
@code {
    [Parameter] public string? AriaLabel { get; set; } = "Activity log";
    [Parameter] public ActivityLogLayout Layout { get; set; } = ActivityLogLayout.List;
    [Parameter] public IReadOnlyList<ActivityLogEntry>? Items { get; set; }
    [Parameter] public int PageSize { get; set; } = 5;
    [Parameter] public EventCallback OnShowMore { get; set; }
    [Parameter] public string ShowMoreLabel { get; set; } = "Show more";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private int _visibleCount;
    private IEnumerable<ActivityLogEntry> VisibleItems => Items?.Take(_visibleCount) ?? [];
    private bool HasMore => Items is not null && _visibleCount < Items.Count;

    protected override void OnParametersSet()
    {
        if (_visibleCount == 0) _visibleCount = Math.Max(1, PageSize);
    }

    private async Task ShowMoreAsync()
    {
        _visibleCount += Math.Max(1, PageSize);
        await OnShowMore.InvokeAsync();
    }
}
