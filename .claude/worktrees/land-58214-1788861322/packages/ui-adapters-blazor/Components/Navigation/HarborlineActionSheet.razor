@namespace Harborline.Api.UIAdapters.Blazor.Components.Navigation
@inherits HarborlineComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Open)
{
    <div class="sf-action-sheet-backdrop" role="presentation" @onclick="CloseAsync">
        <div id="@_dialogId" class="sf-action-sheet" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1" @ref="_dialogRef" @onclick:stopPropagation="true">
            <div class="sf-action-sheet__header"><h2 id="@_titleId">@Title</h2><button type="button" @onclick="CloseAsync" aria-label="@CloseLabel">×</button></div>
            @if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }
            <ul>
                @foreach (var item in Items ?? [])
                {
                    <li><button type="button" disabled="@item.Disabled" class="@(item.Destructive ? "sf-action-sheet__item sf-action-sheet__item--destructive" : "sf-action-sheet__item")" @onclick="() => SelectAsync(item)">@item.Label</button></li>
                }
            </ul>
            @ChildContent
        </div>
    </div>
}

@code {
    private static readonly string A11yModulePath = Harborline.Api.UIAdapters.Blazor.Internal.Interop.HarborlineJsModuleLoader.Resolve("js/harborline-dialog-a11y.js");
    private readonly string _dialogId = $"sf-action-sheet-{Guid.NewGuid():N}";
    private readonly string _titleId = $"sf-action-sheet-title-{Guid.NewGuid():N}";
    private ElementReference _dialogRef;
    private IJSObjectReference? _a11yModule;
    private DotNetObjectReference<HarborlineActionSheet>? _dotNetRef;
    private bool _a11yAttached;
    private bool _wasOpen;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Actions";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public IReadOnlyList<ActionSheetItem>? Items { get; set; }
    [Parameter] public EventCallback<ActionSheetItem> OnItemSelected { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_wasOpen) { await AttachA11yAsync(); _wasOpen = true; }
        else if (!Open && _wasOpen) { await DetachA11yAsync(); _wasOpen = false; }
    }

    private async Task SelectAsync(ActionSheetItem item)
    {
        if (item.Disabled) return;
        await OnItemSelected.InvokeAsync(item);
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (!Open) return;
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    private async Task AttachA11yAsync()
    {
        try
        {
            _a11yModule ??= await JS.InvokeAsync<IJSObjectReference>("import", A11yModulePath);
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _a11yModule.InvokeVoidAsync("attach", _dialogId, _dialogRef, _dotNetRef, new { closeOnEsc = true, escMethod = nameof(OnEscFromJs) });
            _a11yAttached = true;
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task DetachA11yAsync()
    {
        if (!_a11yAttached || _a11yModule is null) return;
        try { await _a11yModule.InvokeVoidAsync("detach", _dialogId); } catch (JSException) { } catch (InvalidOperationException) { }
        _a11yAttached = false;
    }

    [JSInvokable] public Task OnEscFromJs() => CloseAsync();

    public async ValueTask DisposeAsync()
    {
        await DetachA11yAsync();
        if (_a11yModule is not null) await _a11yModule.DisposeAsync();
        _dotNetRef?.Dispose();
    }
}
