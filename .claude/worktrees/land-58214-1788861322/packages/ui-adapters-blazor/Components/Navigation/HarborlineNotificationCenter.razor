@namespace Harborline.Api.UIAdapters.Blazor.Components.Navigation
@inherits HarborlineComponentBase
<div class="@CombineClasses("sf-notification-center")" style="@CombineStyles()" @attributes="AdditionalAttributes"><button id="@_triggerId" type="button" aria-label="@AriaLabel" aria-expanded="@Open.ToString().ToLowerInvariant()" aria-controls="@_contentId" @onclick="Toggle" @onkeydown="HandleKeyDown">@TriggerText</button>@if (Open) { <div id="@_contentId" role="region" aria-labelledby="@_triggerId" aria-label="@ListAriaLabel">@ChildContent</div> }</div>
@code {
    private readonly string _triggerId = $"sf-notification-trigger-{Guid.NewGuid():N}";
    private readonly string _contentId = $"sf-notification-content-{Guid.NewGuid():N}";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Notifications";
    [Parameter] public string ListAriaLabel { get; set; } = "Notification list";
    [Parameter] public string TriggerText { get; set; } = "Notifications";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private async Task Toggle() { Open = !Open; await OpenChanged.InvokeAsync(Open); }
    private async Task HandleKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape" && Open) { Open = false; await OpenChanged.InvokeAsync(false); } }
}
