@namespace Harborline.Api.UIAdapters.Blazor.Components.Navigation
@inherits HarborlineComponentBase
<nav class="@CombineClasses("sf-mega-menu")" style="@CombineStyles()" aria-label="@(AriaLabel ?? "Main")" @attributes="AdditionalAttributes" @onkeydown="HandleKeyDown">
    <ul role="menubar" class="sf-mega-menu__triggers">
        @foreach (var trigger in Triggers)
        {
            <li role="none" @key="trigger.Id">
                <button type="button"
                        role="menuitem"
                        id="@TriggerId(trigger)"
                        aria-haspopup="menu"
                        aria-expanded="@((_openId == trigger.Id).ToString().ToLowerInvariant())"
                        aria-controls="@PanelId(trigger)"
                        style="min-width:24px;min-height:24px;"
                        @onclick="() => Toggle(trigger.Id)">
                    @trigger.Label
                </button>
            </li>
        }
    </ul>
    @foreach (var trigger in Triggers.Where(t => t.Id == _openId))
    {
        <div id="@PanelId(trigger)" class="sf-mega-menu__panel" role="menu" aria-labelledby="@TriggerId(trigger)">
            @foreach (var column in trigger.Columns)
            {
                <div class="sf-mega-menu__column" role="none">
                    <p class="sf-mega-menu__column-title">@column.Title</p>
                    <div class="sf-mega-menu__links" role="none">
                        @foreach (var link in column.Links)
                        {
                            @if (!string.IsNullOrEmpty(link.Href))
                            {
                                <a href="@link.Href" role="menuitem" style="min-width:24px;min-height:24px;display:inline-block;" @onclick="() => LinkSelected.InvokeAsync(link)">@LinkContent(link)</a>
                            }
                            else
                            {
                                <button type="button" role="menuitem" style="min-width:24px;min-height:24px;" @onclick="() => LinkSelected.InvokeAsync(link)">@LinkContent(link)</button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</nav>
@code {
    private readonly string _id = $"sf-mega-menu-{Guid.NewGuid():N}";
    private string? _openId;

    /// <summary>The top-level triggers and their panel columns.</summary>
    [Parameter] public IReadOnlyList<MegaMenuTrigger> Triggers { get; set; } = [];

    /// <summary>Raised when a panel link is activated.</summary>
    [Parameter] public EventCallback<MegaMenuLink> LinkSelected { get; set; }

    /// <summary>Accessible name of the navigation landmark. Falls back to "Main".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private string TriggerId(MegaMenuTrigger trigger) => $"{_id}-trigger-{trigger.Id}";

    private string PanelId(MegaMenuTrigger trigger) => $"{_id}-panel-{trigger.Id}";

    private void Toggle(string id) => _openId = _openId == id ? null : id;

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _openId = null;
        }
    }

    private RenderFragment LinkContent(MegaMenuLink link) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "sf-mega-menu__link-label");
        builder.AddContent(2, link.Label);
        builder.CloseElement();
        if (!string.IsNullOrEmpty(link.Badge))
        {
            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "sf-mega-menu__badge");
            builder.AddContent(5, link.Badge);
            builder.CloseElement();
        }
        if (!string.IsNullOrEmpty(link.Description))
        {
            builder.OpenElement(6, "span");
            builder.AddAttribute(7, "class", "sf-mega-menu__link-description");
            builder.AddContent(8, link.Description);
            builder.CloseElement();
        }
    };
}
