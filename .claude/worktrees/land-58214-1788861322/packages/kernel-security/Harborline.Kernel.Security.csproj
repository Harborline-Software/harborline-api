<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel.Security</PackageId>
    <AssemblyName>Harborline.Api.Kernel.Security</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel.Security</RootNamespace>
    <Description>Role attestation and per-role symmetric key distribution for the Harborline local-node architecture (paper §11.3). Provides Ed25519-signed attestation bundles, X25519 sealed-box key wrapping, and a role-key manager that persists unwrapped keys in the OS keystore.</Description>
    <PackageTags>harborline;kernel;security;attestation;crypto</PackageTags>
    <!-- Stub interfaces and XML-doc gaps will be filled during review hardening.
         CS1591 kept noisy-but-off until the first stable release, matching the
         Foundation and Kernel facade packages. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NSec.Cryptography" />
    <!-- ML-KEM-768 (FIPS-203) for the PQC hybrid sealed box, KEM suite #2 (ADR 0004 §1). -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <!-- Card #3204: ui-core is deliberately NOT referenced. It was scaffolded in as a
         "kernel-facade cross-link" at package creation and no kernel-security source ever
         consumed a Harborline.Api.UICore type. The unused edge was load-bearing in the wrong
         direction: it put a UI-contracts package in the published closure of every
         kernel-security consumer (blocks-crew-comms inherited it via the ADR 0152 seed edge,
         PR #3198 finding F-3) and it is the cycle ui-core's own csproj cites as the reason it
         cannot reference foundation-recovery. Do not re-add without a real type dependency. -->
    <ProjectReference Include="..\kernel\Harborline.Kernel.csproj" />
    <ProjectReference Include="..\foundation-localfirst\Harborline.Foundation.LocalFirst.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the sibling test project from library compilation. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Kernel.Security.Tests" />
  </ItemGroup>
</Project>
