<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.DataExchangeDefinitions</PackageId>
    <AssemblyName>Harborline.Api.Foundation.DataExchangeDefinitions</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.DataExchangeDefinitions</RootNamespace>
    <Description>Foundation-tier substrate for tenant-scoped, versioned data-exchange definitions (control ticket 076). A DataExchangeDefinition is a binding from a stable key and semantic version to a host-registered exchange kind plus its settings - never a connector framework or a mapping DSL - and the portability-export path (ADR 0014) is out of scope. Hosts the DefinitionEnvelope-wired DataExchangeDefinition record, the IDataExchangeDefinitionRegistry pinned-tuple CRUD + governance contract, the IDataExchangeDefinitionDescriptorRegistry admission seam (host-supplied; runtime adapter registration is deliberately NOT the wire-validity authority), and the IDataExchangeDefinitionCanonicalizer seam with a pass-through reference implementation.</Description>
    <PackageTags>harborline;foundation;data-exchange;definitions;governance;ticket-076</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
</Project>
