<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialTax</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialTax</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialTax</RootNamespace>
    <Description>Tax-domain entities (TaxJurisdiction hierarchy, TaxCode, TaxRate history, TaxFormLineMap) and calculation engine (OnSubtotal / Compound / Inclusive) for Harborline — first pass, in-memory services and stable contracts; persistence + UI ship in later hand-offs.</Description>
    <PackageTags>tax;sales-tax;vat;jurisdiction;tax-form-line-map;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialTax.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-events\Harborline.Foundation.Events.csproj" />
    <ProjectReference Include="..\foundation-import\Harborline.Foundation.Import.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
  </ItemGroup>
</Project>
