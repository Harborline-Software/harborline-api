{
  "openapi": "3.1.1",
  "info": {
    "title": "Harborline application adapter API",
    "version": "2.0.0",
    "description": "HTTP projection of typed HarborlineApplicationPort operations."
  },
  "paths": {
    "/api/local-node/sync-status": {
      "get": {
        "operationId": "carrier.application.getSyncStatus",
        "security": [
          {
            "carrierSession": []
          },
          {
            "webSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Observed local-node exchange status and recency evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/carrier-protocol.schema.json#/$defs/HarborlineSyncStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "carrierSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Host-owned bearer session metadata; never a request DTO field."
      },
      "webSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-web_session",
        "description": "HttpOnly same-origin web-client session cookie."
      }
    }
  }
}
