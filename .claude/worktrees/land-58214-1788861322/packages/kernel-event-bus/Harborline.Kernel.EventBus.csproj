<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel.EventBus</PackageId>
    <AssemblyName>Harborline.Api.Kernel.EventBus</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel.EventBus</RootNamespace>
    <Description>Harborline kernel §3.6 Event Bus — in-process reference implementation using System.Threading.Channels with per-entity ordering, Ed25519-signed events, and idempotent delivery.</Description>
    <PackageTags>harborline;kernel;events;event-bus;channels</PackageTags>
    <!-- NU1510 suppressed: direct PackageRefs below are required after preview.4
         NuGet resolution shift (PR #11) but flagged as transitively pruneable. -->
    <NoWarn>$(NoWarn);CS1591;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Kernel.EventBus.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\kernel\Harborline.Kernel.csproj" />
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
</Project>
