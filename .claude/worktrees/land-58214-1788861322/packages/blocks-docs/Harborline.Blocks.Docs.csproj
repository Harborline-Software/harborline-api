<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Docs</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Docs</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Docs</RootNamespace>
    <Description>Document-attachment substrate for Harborline — Attachment entity, StorageRef discriminated union, status state machine, and repository contract. Cross-cluster surface consumed by AR invoices, AP bills, leases, inspections, and work orders. First pass: entity primitives only; service + IBlobStore wiring + cross-cluster DocumentRef arrive in PRs 2–6.</Description>
    <PackageTags>docs;attachments;blobs;sha256;cross-cluster;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;NU1510;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Docs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
  </ItemGroup>
</Project>
