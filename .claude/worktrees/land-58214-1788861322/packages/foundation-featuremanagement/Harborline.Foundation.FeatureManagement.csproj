<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.FeatureManagement</PackageId>
    <AssemblyName>Harborline.Api.Foundation.FeatureManagement</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.FeatureManagement</RootNamespace>
    <Description>Feature-evaluation surface with a catalog + OpenFeature-style provider seam + entitlement + edition resolvers. Composes into a single evaluator. No vendor dependency. See ADR 0009.</Description>
    <PackageTags>harborline;foundation;features;feature-flags;entitlements;openfeature</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-wayfinder\Harborline.Foundation.Wayfinder.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.FeatureManagement.Tests" />
  </ItemGroup>
</Project>
