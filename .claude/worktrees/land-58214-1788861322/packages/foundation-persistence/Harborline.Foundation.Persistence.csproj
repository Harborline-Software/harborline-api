<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.Persistence</PackageId>
    <AssemblyName>Harborline.Api.Foundation.Persistence</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.Persistence</RootNamespace>
    <Description>EF-Core-adjacent persistence abstractions for Harborline: IHarborlineEntityModule (module-entity registration pattern, ADR 0015) and shared tenant-query-filter extensions (ADR 0008).</Description>
    <PackageTags>harborline;foundation;persistence;efcore;modules</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Persistence.Tests" />
  </ItemGroup>
</Project>
