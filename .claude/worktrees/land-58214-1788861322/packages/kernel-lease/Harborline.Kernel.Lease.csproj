<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel.Lease</PackageId>
    <AssemblyName>Harborline.Api.Kernel.Lease</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel.Lease</RootNamespace>
    <Description>Flease-inspired distributed lease coordinator for Harborline CP-class record writes (paper §6.3; sync-daemon-protocol §6). Rides the LEASE_REQUEST / LEASE_GRANT / LEASE_RELEASE / LEASE_DENIED messages defined in Harborline.Api.Kernel.Sync over the shared ISyncDaemonTransport. Grants a lease when a quorum of peers acknowledge the request (default ceil(N/2)+1); blocks writes when quorum is unreachable. Leases auto-expire (default 30 s) so a node that goes offline releases at expiry rather than holding the resource indefinitely.</Description>
    <PackageTags>harborline;kernel;lease;flease;quorum;cp</PackageTags>
    <!-- Parity with sibling kernel-* packages: CS1591 is suppressed until the
         first stable release so type-forwarded and stub surfaces don't drown
         the build in missing-xmldoc warnings. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\ui-core\Harborline.UICore.csproj" />
    <ProjectReference Include="..\kernel\Harborline.Kernel.csproj" />
    <ProjectReference Include="..\kernel-sync\Harborline.Kernel.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the sibling test project from library compilation. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Kernel.Lease.Tests" />
  </ItemGroup>
</Project>
