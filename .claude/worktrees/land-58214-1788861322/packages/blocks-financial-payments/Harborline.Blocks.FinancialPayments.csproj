<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialPayments</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialPayments</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialPayments</RootNamespace>
    <Description>Payment + PaymentApplication substrate for Harborline — cash-movement entities, direction-matching invariant, and in-memory repositories. First pass: entity model + repository contracts + DI extension. Posting (PR 2), application service (PR 3), and ERPNext importer (PR 4) arrive in follow-on PRs.</Description>
    <PackageTags>payments;accounts-receivable;accounts-payable;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;NU1510;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialPayments.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-events\Harborline.Foundation.Events.csproj" />
    <ProjectReference Include="..\foundation-import\Harborline.Foundation.Import.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <ProjectReference Include="..\blocks-financial-ar\Harborline.Blocks.FinancialAr.csproj" />
    <ProjectReference Include="..\blocks-financial-ap\Harborline.Blocks.FinancialAp.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
  </ItemGroup>
</Project>
