<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Migration.Erpnext</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Migration.Erpnext</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Migration.Erpnext</RootNamespace>
    <Description>A0 ERPNext extraction adapter (read side) — the cross-cluster host package for the ERPNext-&gt;Harborline importer's source-read half (ADR 0100, Workstream A0). Owns the IErpnextSourceExtractor seam (read-only; IAsyncEnumerable of the frozen Erpnext*Source DTOs), the v1 sole impl MariaDbDumpExtractor (composes the foundation-import ISourceReader/SourceRow primitives — no reimplemented dump parsing, no DB connection), the versioned ERPNext-v15 ErpnextDocTypeMap (unknown DocTypes routed to a counted _unmapped census, never silently dropped), and the USD-only single-currency guard. Sits ABOVE the blocks-* clusters in the DAG so it can reference all seven Migration DTO namespaces up the graph; no cluster depends on it.</Description>
    <PackageTags>harborline;migration;erpnext;extraction;import;clean-room;blocks</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NU1510 suppressed: the direct Microsoft.Extensions.DependencyInjection.Abstractions
         PackageReference is required for IServiceCollection in the DI extension, but NuGet
         flags it as "will not be pruned" because it's transitively available from a cluster
         ProjectReference. Removing the ref breaks the build (CS0246); keeping it trips NU1510
         which WarningsAsErrors escalates. Keep the ref, suppress the warning. -->
    <NoWarn>CS1591;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Migration.Erpnext.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- foundation-import primitives this adapter COMPOSES (ISourceReader / SourceRow /
         MariaDbDumpSourceReader / ImportCensus) — no reimplementation of dump parsing. -->
    <ProjectReference Include="..\foundation-import\Harborline.Foundation.Import.csproj" />
    <!-- The seven cluster Migration DTO namespaces this cross-cluster extractor populates
         (referenced UP the DAG; no cluster references back — the .NET-arch (G) acyclic geometry). -->
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <ProjectReference Include="..\blocks-financial-ar\Harborline.Blocks.FinancialAr.csproj" />
    <ProjectReference Include="..\blocks-financial-ap\Harborline.Blocks.FinancialAp.csproj" />
    <ProjectReference Include="..\blocks-financial-payments\Harborline.Blocks.FinancialPayments.csproj" />
    <ProjectReference Include="..\blocks-financial-periods\Harborline.Blocks.FinancialPeriods.csproj" />
    <ProjectReference Include="..\blocks-financial-tax\Harborline.Blocks.FinancialTax.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
