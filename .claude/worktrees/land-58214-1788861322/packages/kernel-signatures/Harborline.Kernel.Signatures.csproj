<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel.Signatures</PackageId>
    <AssemblyName>Harborline.Api.Kernel.Signatures</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel.Signatures</RootNamespace>
    <Description>Harborline kernel signature-capture substrate (ADR 0054). Captures legally-binding signature events with content-hash binding, append-only revocation log, UETA/E-SIGN consent gate, and pluggable device-attestation surface. Sibling to kernel-audit + kernel-security. W#21 Phase 1 ships the contract surface + InMemory implementations; native iOS PencilKit + CryptoKit integration deferred to W#23 (iOS Field-Capture App).</Description>
    <PackageTags>harborline;kernel;signatures;ueta;e-sign;adr-0054</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Kernel.Signatures.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <ProjectReference Include="..\foundation-taxonomy\Harborline.Foundation.Taxonomy.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
  </ItemGroup>
</Project>
