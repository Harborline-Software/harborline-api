    {
      "key": "general.invoice",
      "kind": "TemplateDefinition",
      "version": "1.0.0",
      "content": {
        "key": "general.invoice",
        "version": "1.0.0",
        "documentType": "invoice",
        "recordType": { "type": "invoice", "version": "1" },
        "locale": { "kind": "fixed", "tag": "en-US" },
        "style": { "brandName": "Harborline Software" },
        "structure": [
          {
            "kind": "header",
            "lines": [
              { "runs": [ { "literal": "Invoice " }, { "binding": "field.invoiceNumber" } ] },
              { "runs": [ { "literal": "Issued " }, { "binding": "field.issueDate", "format": "date" } ] },
              { "runs": [ { "literal": "Due " }, { "binding": "field.dueDate", "format": "date" } ] }
            ]
          },
          {
            "kind": "fieldGrid",
            "label": "Bill to",
            "lines": [
              { "runs": [ { "literal": "Customer: " }, { "binding": "field.customer.name" } ] },
              { "runs": [ { "literal": "Email: " }, { "binding": "field.customer.email" } ] }
            ]
          },
          {
            "kind": "repeatingRegion",
            "label": "Line items",
            "repeatSection": "lineItems",
            "columns": [
              { "header": "Description", "binding": "row.description" },
              { "header": "Qty", "binding": "row.quantity", "format": "integer", "align": "end" },
              { "header": "Unit price", "binding": "row.unitPrice", "format": "currency", "align": "end" },
              { "header": "Amount", "binding": "row.amount", "format": "currency", "align": "end" }
            ]
          },
          {
            "kind": "fieldGrid",
            "label": "Totals",
            "lines": [
              { "runs": [ { "literal": "Subtotal: " }, { "binding": "field.subtotal", "format": "currency" } ] },
              { "runs": [ { "literal": "Tax: " }, { "binding": "field.taxTotal", "format": "currency" } ] },
              { "runs": [ { "literal": "Total: " }, { "binding": "field.total", "format": "currency" } ] }
            ]
          },
          {
            "kind": "footer",
            "label": "Notes",
            "showWhen": { "expression": "{\"!!\":[{\"var\":\"field.notes\"}]}" },
            "lines": [
              { "runs": [ { "binding": "field.notes" } ] }
            ]
          }
        ]
      }
    }
  ],
