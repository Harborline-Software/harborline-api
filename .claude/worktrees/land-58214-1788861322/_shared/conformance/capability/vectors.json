  {
    "id": "pack-collection-authored-order",
    "surface": "pack",
    "operation": "resolve-summary",
    "description": "Merge keyed collections in authored order while overriding an existing key in place.",
    "input": { "seed": ["vertical"], "catalog": [
      { "name": "kernel", "version": "1.0.0", "scopeTier": "kernel", "provides": [], "composesOver": [], "defaults": { "accounts": [{ "id": "zulu", "v": 1 }, { "id": "alpha", "v": 1 }, { "id": "mike", "v": 1 }] }, "defaultMergeKeys": { "accounts": "id" } },
      { "name": "vertical", "version": "1.0.0", "scopeTier": "vertical", "provides": [], "composesOver": [{ "name": "kernel", "versionConstraint": ">=1.0.0 <2.0.0" }], "defaults": { "accounts": [{ "id": "zulu", "v": 2 }, { "id": "bravo", "v": 1 }] }, "defaultMergeKeys": { "accounts": "id" } }
    ] },
    "expected": {
      "packs": ["kernel", "vertical"],
      "defaults": { "accounts": [{ "id": "zulu", "v": 2 }, { "id": "alpha", "v": 1 }, { "id": "mike", "v": 1 }, { "id": "bravo", "v": 1 }] },
      "defaultProvenance": [{ "key": "accounts", "providedBy": "vertical", "overrode": ["kernel"] }]
    }
  },
  {
    "id": "pack-ap-override-cascade",
    "surface": "pack",
    "operation": "resolve-summary",
    "description": "Apply AP defaults from kernel through platform service to vertical, with the most-specific value winning.",
    "input": { "seed": ["vertical"], "catalog": [
      { "name": "kernel", "version": "1.0.0", "scopeTier": "kernel", "provides": [], "composesOver": [], "defaults": { "mode": "kernel" } },
      { "name": "platform", "version": "1.0.0", "scopeTier": "horizontal", "flavor": "platform-service", "provides": [], "composesOver": [{ "name": "kernel", "versionConstraint": "^1.0.0" }], "defaults": { "mode": "platform" } },
      { "name": "vertical", "version": "1.0.0", "scopeTier": "vertical", "provides": [], "composesOver": [{ "name": "platform", "versionConstraint": "^1.0.0" }], "defaults": { "mode": "vertical" } }
    ] },
    "expected": {
      "packs": ["kernel", "platform", "vertical"],
      "defaults": { "mode": "vertical" },
      "defaultProvenance": [{ "key": "mode", "providedBy": "vertical", "overrode": ["kernel", "platform"] }]
    }
  },
