[
  {
    "id": "m3-normalize-success",
    "surface": "m3",
    "operation": "normalize",
    "description": "Preserve a valid success envelope while applying the fallback job id only when needed.",
    "input": {
      "native": {
        "jobId": "job-native-1",
        "status": "succeeded",
        "progress": 1,
        "artifacts": [],
        "usage": { "unit": "call", "quantity": 1, "costMicros": null, "tier": "local" },
        "error": null
      },
      "fallbackJobId": "job-fallback-1"
    },
    "expected": {
      "jobId": "job-native-1",
      "status": "succeeded",
      "progress": 1,
      "artifacts": [],
      "usage": { "unit": "call", "quantity": 1, "costMicros": null, "tier": "local" },
      "error": null
    }
  },
  {
