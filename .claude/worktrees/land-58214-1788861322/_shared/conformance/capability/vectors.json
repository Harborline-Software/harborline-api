    }
  },
  {
    "id": "resolution-degraded-floor",
    "surface": "resolution",
    "operation": "resolve",
    "description": "A surviving slow local floor resolves successfully but reports degraded fallback state.",
    "input": {
      "composition": { "solutionId": "carrier", "capabilities": [{ "capabilityId": "image", "membership": "core" }] },
      "entitled": true,
      "providers": [{ "providerId": "cpu-floor", "tier": "local", "isFloor": true, "speedHint": "slow" }],
      "licensePass": true,
      "configuration": "default"
    },
    "expected": {
      "result": { "resolutionState": "degraded", "chosenProviderId": "cpu-floor", "selectionReason": "fallback-floor", "isFallback": true, "tier": "local", "speedHint": "slow", "reason": "resolved 'image' to the local floor 'cpu-floor' (a faster provider exists but did not win)" },
      "calls": ["entitlement", "hardware", "license", "configuration"]
    }
  },
  {
    "id": "resolution-license-short-circuit",
    "surface": "resolution",
    "operation": "resolve",
    "description": "Hardware-fit providers blocked by the provider-license gate resolve to locked-entitlement and skip configuration.",
    "input": {
      "composition": { "solutionId": "carrier", "capabilities": [{ "capabilityId": "image", "membership": "core" }] },
      "entitled": true,
      "providers": [{ "providerId": "gpu-fast", "tier": "local", "isFloor": false, "speedHint": "fast" }],
      "licensePass": false,
      "configuration": "default"
    },
    "expected": {
      "result": { "resolutionState": "locked-entitlement", "chosenProviderId": null, "selectionReason": "entitlement-gated", "isFallback": false, "tier": "local", "speedHint": "moderate", "reason": "every provider for 'image' is blocked by the provider-license gate" },
      "calls": ["entitlement", "hardware", "license"]
    }
  },
