  {
    "id": "redaction-credential-shapes",
    "surface": "redaction",
    "operation": "redact-text",
    "description": "Redact bearer, assignment, provider-key, and connection-string credential shapes.",
    "input": {
      "text": "Bearer abcdefgh; apiKey=abcd1234; token: tok1234; sk-testkey1234567890; Password=dbpass123"
    },
    "expected": "[REDACTED]; [REDACTED]; [REDACTED]; [REDACTED]; [REDACTED]"
  },
  {
    "id": "redaction-registered-secret",
    "surface": "redaction",
    "operation": "redact-text",
    "description": "Redact a caller-registered secret literal without redacting short values.",
    "input": { "text": "provider returned opaque-secret-123 and id=abc", "secrets": ["opaque-secret-123", "id"] },
    "expected": "provider returned [REDACTED] and id=abc"
  },
  {
    "id": "redaction-nested-correlation-preserved",
    "surface": "redaction",
    "operation": "redact-deep",
    "description": "Walk nested objects and arrays while preserving correlationId verbatim.",
    "input": {
      "value": {
        "authorization": "Bearer abcdefgh",
        "nested": { "secret": "opaque-secret", "correlationId": "corr-103" },
        "values": ["opaque-secret", 7, { "token": "token=tok1234" }],
        "correlationId": "corr-103"
      },
      "secrets": ["opaque-secret"]
    },
    "expected": {
      "authorization": "[REDACTED]",
      "nested": { "secret": "[REDACTED]", "correlationId": "corr-103" },
      "values": ["[REDACTED]", 7, { "token": "[REDACTED]" }],
      "correlationId": "corr-103"
    }
  },
  {
    "id": "resolution-available-order",
    "surface": "resolution",
    "operation": "resolve",
    "description": "Run all five D7 stages in order and choose the fastest non-floor provider.",
    "input": {
      "composition": { "solutionId": "carrier", "capabilities": [{ "capabilityId": "image", "membership": "core" }] },
      "entitled": true,
      "providers": [
        { "providerId": "cpu-floor", "tier": "local", "isFloor": true, "speedHint": "slow" },
        { "providerId": "gpu-fast", "tier": "local", "isFloor": false, "speedHint": "fast" }
      ],
      "licensePass": true,
      "configuration": "default"
    },
    "expected": {
      "result": { "resolutionState": "available", "chosenProviderId": "gpu-fast", "selectionReason": "preferred-by-policy", "isFallback": false, "tier": "local", "speedHint": "fast", "reason": "resolved 'image' to 'gpu-fast'" },
      "calls": ["entitlement", "hardware", "license", "license", "configuration"]
    }
  },
  {
    "id": "resolution-not-in-edition",
    "surface": "resolution",
    "operation": "resolve",
    "description": "Membership is checked first and an absent capability short-circuits every later stage.",
    "input": {
      "composition": { "solutionId": "carrier", "capabilities": [] },
      "entitled": true,
      "providers": [],
      "licensePass": true,
      "configuration": "default"
    },
    "expected": {
      "result": { "resolutionState": "not-in-edition", "chosenProviderId": null, "selectionReason": "entitlement-gated", "isFallback": false, "tier": "local", "speedHint": "moderate", "reason": "capability 'image' is not part of edition 'carrier'" },
      "calls": []
    }
  },
  {
    "id": "resolution-upsell",
    "surface": "resolution",
    "operation": "resolve",
    "description": "An unentitled core capability resolves to upsell after membership and before hardware.",
    "input": {
      "composition": { "solutionId": "carrier", "capabilities": [{ "capabilityId": "image", "membership": "core" }] },
      "entitled": false,
