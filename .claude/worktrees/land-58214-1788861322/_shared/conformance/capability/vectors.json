    }
  },
  {
    "id": "resolution-unavailable-hardware",
    "surface": "resolution",
    "operation": "resolve",
    "description": "An entitled capability with no fitting provider resolves to unavailable-hardware.",
    "input": {
      "composition": { "solutionId": "carrier", "capabilities": [{ "capabilityId": "image", "membership": "core" }] },
      "entitled": true,
      "providers": [],
      "licensePass": true,
      "configuration": "default"
    },
