<Project>
  <!--
    Plan 2 Task 4.4 — late-binding portion of the XLIFF cascade.

    Directory.Build.targets evaluates AFTER the project's SDK loads, which means
    $(Configuration) is now set (Debug or Release). The .props side handled
    ProjectReference (build-order forcing); this side handles:

      1. Pointing the UsingTask AssemblyFile at the source-tree DLL path
         instead of the NuGet's tasks/ folder.
      2. Importing the .targets that registers the tasks and defines
         HarborlineExportXliff / HarborlineImportXliff targets.

    Both gated on the same convention as the analyzer cascade: the project has a
    Resources/Localization/ folder and is not the tooling project itself.
  -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\Resources\Localization')
                            And '$(MSBuildProjectName)' != 'Harborline.Tooling.LocalizationXliff'
                            And '$(MSBuildProjectName)' != 'Harborline.Tooling.LocalizationXliff.Tests'">
    <_HarborlineLocXliffTaskAssembly>$(MSBuildThisFileDirectory)tooling\Harborline.Tooling.LocalizationXliff\bin\$(Configuration)\netstandard2.0\Harborline.Api.Tooling.LocalizationXliff.dll</_HarborlineLocXliffTaskAssembly>
    <!-- Pin the XLIFF artifact directory next to the .resx source. The .targets
         file's default (localization/xliff/) collides on Windows with case-only
         differences when a project has a marker-class folder named Localization/.
         Resources/Localization/xliff/ keeps every localization asset under one
         tree and avoids the case-collision. -->
    <HarborlineXliffDirectory>$(MSBuildProjectDirectory)\Resources\Localization\xliff</HarborlineXliffDirectory>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)tooling\Harborline.Tooling.LocalizationXliff\build\Harborline.Tooling.LocalizationXliff.targets"
          Condition="Exists('$(MSBuildProjectDirectory)\Resources\Localization')
                     And '$(MSBuildProjectName)' != 'Harborline.Tooling.LocalizationXliff'
                     And '$(MSBuildProjectName)' != 'Harborline.Tooling.LocalizationXliff.Tests'" />

  <!--
    ADR 0164 D6 — MinVer lives HERE, not in Directory.Build.props.
    The .props file is imported BEFORE a project sets its own properties, so IsPackable and
    ManagePackageVersionsCentrally are not yet known there. Adding MinVer unconditionally from
    .props put it on every project including the analyzers, which set
    ManagePackageVersionsCentrally=false, so a bare PackageReference has no version at all and
    the restore fails with NU1015.
    The .targets file is imported at the END, after those properties are set, so both can be honoured.
    PrivateAssets=all keeps a build-time version calculator out of every consumer's graph.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' And '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true' And '$(ManagePackageVersionsCentrally)' != 'true'">
    <!-- Central versions are off here, so the version must be stated inline. -->
    <PackageReference Include="MinVer" Version="6.1.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <!--
    ADR 0013 enforcement gate — the item half of the banned-API wiring. The
    membership predicate ($(_HarborlineBannedApiTarget)) is computed in
    Directory.Build.props; only the reference itself lives here.

    It lives in .targets for exactly the reason MinVer does (ADR 0164 D6 above):
    a bare PackageReference draws its version from Directory.Packages.props, so
    it is only legal where central package management is on. A project opting out
    sets ManagePackageVersionsCentrally=false in its own body, which .props is
    imported too early to observe — emitting the reference there produced a
    version-less PackageReference and failed restore with NU1015.

    The only such project outside the analyzers (already excluded by name) is
    tests/package-consumer, which opts out deliberately so it consumes the packed
    nupkgs the way an external consumer would. The repo's internal lint gate has
    no place in that simulated-external project regardless.
  -->
  <ItemGroup Condition="'$(_HarborlineBannedApiTarget)' == 'true' And '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt"
                     Visible="false" />
  </ItemGroup>
</Project>
