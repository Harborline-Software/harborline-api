<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Carried from this repository's pre-merge root props (ticket 008 step 0.5). Scoped here
         rather than at root: a root-level 1591 suppression would silently relax the XML-doc
         requirement for all 93 incoming projects, which the source deliberately enforces. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <HarborlinePackageVersion Condition="'$(HarborlinePackageVersion)' == ''">0.1.0-preview.1</HarborlinePackageVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Harborline.Api.Contracts" Version="$(HarborlinePackageVersion)" />
    <PackageReference Include="Harborline.Api.Client" Version="$(HarborlinePackageVersion)" />
    <PackageReference Include="Harborline.Api.Testing" Version="$(HarborlinePackageVersion)" />
  </ItemGroup>
</Project>
