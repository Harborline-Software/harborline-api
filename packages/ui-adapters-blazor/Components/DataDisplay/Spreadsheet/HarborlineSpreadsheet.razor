@namespace Harborline.Api.UIAdapters.Blazor.Components.DataDisplay.Spreadsheet
@using Harborline.Api.UIAdapters.Blazor.Enums
@inherits HarborlineComponentBase

<div id="@_gridId" class="@CombineClasses("sf-spreadsheet")"
     style="@CombineStyles(SizeStyle())"
     role="grid"
     aria-label="@(AriaLabel ?? "Spreadsheet")"
     @attributes="AdditionalAttributes">
    @* Explicit role="rowgroup"/role="row" attributes are required because the inner
       <table> element introduces an implicit role="table" inside the role="grid"
       container — without them, axe's aria-required-children rule cannot resolve
       <tr> descendants as the grid's row children. *@
    <table class="sf-spreadsheet__table" role="presentation" style="@TableStyle()">
        <thead role="rowgroup">
            <tr role="row">
                <th class="sf-spreadsheet__corner" scope="col" style="@HeaderCellStyle(-1)"></th>
                @for (var c = 0; c < EffectiveColumns; c++)
                {
                    <th class="sf-spreadsheet__col-header" scope="col" style="@HeaderCellStyle(c)">@ColumnLetter(c)</th>
                }
            </tr>
        </thead>
        <tbody role="rowgroup">
            @for (var r = 0; r < EffectiveRows; r++)
            {
                var rowIndex = r;
                <tr role="row">
                    <th class="sf-spreadsheet__row-header" scope="row" style="@RowHeaderStyle(rowIndex)">@(rowIndex + 1)</th>
                    @for (var c = 0; c < EffectiveColumns; c++)
                    {
                        var colIndex = c;
                        var selected = IsSelected(rowIndex, colIndex);
                        var cell = GetCell(rowIndex, colIndex);
                        var align = cell.Align ?? cell.Type switch
                        {
                            SpreadsheetCellType.Number => "right",
                            SpreadsheetCellType.Boolean => "center",
                            SpreadsheetCellType.Date => "right",
                            _ => "left",
                        };
                        <td class="@("sf-spreadsheet__cell" + (selected ? " sf-spreadsheet__cell--selected" : ""))"
                            role="gridcell"
                            style="@($"text-align:{align};{CellStyle(cell)}{DataCellStyle(rowIndex, colIndex)}")">
                            @if (ReadOnly)
                            {
                                <span class="sf-spreadsheet__readonly">@RenderCell(rowIndex, colIndex)</span>
                            }
                            else
                            {
                                <input type="text"
                                       class="sf-spreadsheet__input"
                                       style="@($"min-width:24px;min-height:24px;{CellStyle(cell)}")"
                                       value="@(selected ? EditValue(rowIndex, colIndex) : RenderCell(rowIndex, colIndex))"
                                       @onfocus="() => HandleCellFocused(rowIndex, colIndex)"
                                       @onchange="e => HandleCellCommitted(rowIndex, colIndex, e.Value?.ToString())"
                                       aria-label="@SpreadsheetAddress.ToA1(rowIndex, colIndex)" />
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Sheets is { Count: > 0 })
{
    <div class="sf-spreadsheet__sheet-tabs" role="tablist" aria-label="@((AriaLabel ?? "Spreadsheet") + " sheets")"
         style="display:flex;gap:2px;margin-top:2px;">
        @for (var s = 0; s < Sheets.Count; s++)
        {
            var sheetIndex = s;
            var isActive = sheetIndex == EffectiveSheetIndex;
            <button type="button"
                    class="sf-btn mar-btn--flat @(isActive ? "mar-btn--primary" : "")"
                    role="tab"
                    aria-selected="@(isActive ? "true" : "false")"
                    aria-controls="@_gridId"
                    style="min-width:24px;min-height:24px;"
                    @onclick="() => SelectSheetAsync(sheetIndex)">@Sheets[sheetIndex].Name</button>
        }
    </div>
}
