@namespace Harborline.Api.UIAdapters.Blazor.Components.DataDisplay
@inherits HarborlineComponentBase

@*
    HarborlineBadgeContainer — position anchor box so an overlay badge can sit
    on a corner of the wrapped element. Parity with ui-react BadgeContainer.
*@

<span class="@CombineClasses("sf-badge-container")"
      style="@CombineStyles("position:relative;display:inline-flex;")"
      @attributes="AdditionalAttributes">
    @ChildContent
</span>

@code {
    /// <summary>The anchor element plus any overlay badge(s).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
