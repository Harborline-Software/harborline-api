@namespace Harborline.Api.UIAdapters.Blazor.Components.DataDisplay
@inherits HarborlineComponentBase

@*
    HarborlineNotificationDot — corner overlay dot wrapping any child element.
    Parity with ui-react NotificationDot (semantic colors, pulse, hidden).
*@

<span class="@CombineClasses($"sf-notification-dot sf-notification-dot--{ColorSuffix}")"
      style="@CombineStyles("position:relative;display:inline-flex;")"
      @attributes="AdditionalAttributes">
    @ChildContent
    @if (!Hidden)
    {
        <span class="sf-notification-dot__dot"
              role="status"
              aria-label="@ResolvedAriaLabel"
              style="position:absolute;top:-3px;inset-inline-end:-3px;width:.55rem;height:.55rem;border-radius:50%;border:2px solid var(--sf-surface, #fff);background:@Hex;@(Pulse ? "animation:sf-notification-dot-pulse 1.6s ease-in-out infinite;" : string.Empty)"></span>
    }
</span>

@if (Pulse && !Hidden)
{
    <style>
        @@keyframes sf-notification-dot-pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .35; }
        }
    </style>
}

@code {
    /// <summary>Semantic color: default, primary, success, warning, danger.</summary>
    [Parameter] public string Color { get; set; } = "default";

    /// <summary>The wrapped anchor element.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Hides the dot while keeping the anchor rendered.</summary>
    [Parameter] public bool Hidden { get; set; }

    /// <summary>Pulses the dot.</summary>
    [Parameter] public bool Pulse { get; set; }

    /// <summary>Accessible label for the dot. Falls back to "New notification".</summary>
    [Parameter] public string? AriaLabelText { get; set; }

    /// <summary>Preferred accessible name; falls back to the notification label.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private string ResolvedAriaLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? (string.IsNullOrWhiteSpace(AriaLabelText) ? "New notification" : AriaLabelText!)
        : AriaLabel!;

    private string ColorSuffix => Color.ToLowerInvariant() switch
    {
        "primary" or "success" or "warning" or "danger" => Color.ToLowerInvariant(),
        _ => "default",
    };

    private string Hex => ColorSuffix switch
    {
        "primary" => "#2563eb",
        "success" => "#16a34a",
        "warning" => "#d97706",
        "danger" => "#dc2626",
        _ => "#6b7280",
    };
}
