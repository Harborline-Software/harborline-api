    private static string Fmt(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // ── Stacking / rendering helpers ──────────────────────────────────

    private static bool IsStackable(ChartSeriesType type) =>
        type is ChartSeriesType.Column or ChartSeriesType.Bar or ChartSeriesType.Area;

    /// <summary>
    /// Computes per-series stacking baselines and effective values. Series with Stack=true and a
    /// stackable type accumulate per (type, StackGroup). Stack100 groups normalize each category
    /// to a 0-100 scale. Returns null entries for series that do not stack.
    /// </summary>
    private static (double[]?[] Bases, double[]?[] Values, double Min, double Max) ComputeStacking(
        List<HarborlineChartSeries> visibleSeries,
        List<IReadOnlyList<ChartDataPoint>> allPoints)
    {
        var bases = new double[]?[visibleSeries.Count];
        var values = new double[]?[visibleSeries.Count];
        double stackedMin = 0;
        double stackedMax = 0;

        var groups = visibleSeries
            .Select((series, index) => (Series: series, Index: index))
            .Where(t => t.Series.Stack && IsStackable(t.Series.Type))
            .GroupBy(t => (t.Series.Type, Group: t.Series.StackGroup ?? ""));

        foreach (var group in groups)
        {
            var members = group.ToList();
            int pointCount = members.Max(m => allPoints[m.Index].Count);
            if (pointCount == 0) continue;
            bool percent = members.Any(m => m.Series.Stack100);

            var positiveTotals = new double[pointCount];
            var negativeTotals = new double[pointCount];
            if (percent)
            {
                foreach (var m in members)
                {
                    var pts = allPoints[m.Index];
                    for (int k = 0; k < pts.Count; k++)
                    {
                        if (pts[k].Value >= 0) positiveTotals[k] += pts[k].Value;
                        else negativeTotals[k] += Math.Abs(pts[k].Value);
                    }
                }
            }

            var positiveCumulative = new double[pointCount];
            var negativeCumulative = new double[pointCount];
            foreach (var m in members)
            {
                var pts = allPoints[m.Index];
                var memberBases = new double[pts.Count];
                var memberValues = new double[pts.Count];
                for (int k = 0; k < pts.Count; k++)
                {
                    double v = pts[k].Value;
                    if (percent)
                    {
                        var total = v >= 0 ? positiveTotals[k] : negativeTotals[k];
                        v = total == 0 ? 0 : Math.Abs(v) / total * 100 * Math.Sign(v);
                    }

                    memberBases[k] = v >= 0 ? positiveCumulative[k] : negativeCumulative[k];
                    memberValues[k] = v;
                    if (v >= 0) positiveCumulative[k] += v;
                    else negativeCumulative[k] += v;
                }
                bases[m.Index] = memberBases;
                values[m.Index] = memberValues;
            }

            stackedMax = Math.Max(stackedMax, positiveCumulative.Max());
            stackedMin = Math.Min(stackedMin, negativeCumulative.Min());
        }

        return (bases, values, stackedMin, stackedMax);
    }

    private static double ValueToY(double value, double marginTop, double plotHeight, double minY, double yRange) =>
        marginTop + plotHeight - (plotHeight * (value - minY) / yRange);

    private static double ValueToX(double value, double marginLeft, double plotWidth, double minY, double yRange) =>
        marginLeft + (plotWidth * (value - minY) / yRange);

    /// <summary>Catmull-Rom spline through the points, emitted as SVG cubic bezier segments.</summary>
    private static string SmoothSegments(List<(double x, double y)> p)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < p.Count - 1; i++)
        {
            var p0 = p[Math.Max(i - 1, 0)];
            var p1 = p[i];
            var p2 = p[i + 1];
            var p3 = p[Math.Min(i + 2, p.Count - 1)];
            double c1x = p1.x + (p2.x - p0.x) / 6;
            double c1y = p1.y + (p2.y - p0.y) / 6;
            double c2x = p2.x - (p3.x - p1.x) / 6;
            double c2y = p2.y - (p3.y - p1.y) / 6;
            sb.Append($" C {Fmt(c1x)} {Fmt(c1y)}, {Fmt(c2x)} {Fmt(c2y)}, {Fmt(p2.x)} {Fmt(p2.y)}");
        }
        return sb.ToString();
    }

    private static string? DashArray(ChartDashType dashType) => dashType switch
    {
        ChartDashType.Dash => "6,4",
        ChartDashType.Dot => "2,3",
        ChartDashType.DashDot => "6,4,2,4",
        ChartDashType.LongDash => "10,4",
        _ => null
    };

