        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        HarborlineChartSeries series, double x, double y, string anchor, double value)
    {
        if (!series.ShowLabels) return;
        builder.OpenElement(190, "text");
        builder.AddAttribute(191, "x", Fmt(x));
        builder.AddAttribute(192, "y", Fmt(y));
        builder.AddAttribute(193, "text-anchor", anchor);
        builder.AddAttribute(194, "font-size", "10");
        builder.AddAttribute(195, "fill", "var(--mar-chart-text)");
        builder.AddAttribute(196, "class", "mar-chart-label");
        builder.AddAttribute(197, "aria-hidden", "true");
        builder.AddContent(198, string.Format(
            System.Globalization.CultureInfo.InvariantCulture,
            series.LabelFormat ?? "{0:N0}",
            value));
        builder.CloseElement();
    }
