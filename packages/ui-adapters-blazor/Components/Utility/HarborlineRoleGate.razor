@namespace Harborline.Api.UIAdapters.Blazor.Components.Utility
@inherits HarborlineComponentBase

@*
    HarborlineRoleGate — renders children only when the current role is in the
    allow-list; otherwise renders the optional fallback. Parity with ui-react
    RoleGate (role, allow, children, fallback).

    Demo/gallery gate only — real authorization decisions belong to the PBAC
    substrate, never a client-side visibility check.
*@

@if (IsAllowed)
{
    @ChildContent
}
else
{
    @Fallback
}

@code {
    /// <summary>The current principal's role.</summary>
    [Parameter, EditorRequired] public string Role { get; set; } = string.Empty;

    /// <summary>Roles permitted to see the content.</summary>
    [Parameter, EditorRequired] public IReadOnlyCollection<string> Allow { get; set; } = Array.Empty<string>();

    /// <summary>Content rendered when the role is allowed.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Content rendered when the role is not allowed. Default: nothing.</summary>
    [Parameter] public RenderFragment? Fallback { get; set; }

    private bool IsAllowed => Allow.Contains(Role, StringComparer.Ordinal);
}
