@namespace Harborline.Api.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Open)
{
    <div class="@CombineClasses("sf-sheet-backdrop")"
         style="@CombineStyles()"
         role="presentation"
         @onclick="Close"
         @attributes="AdditionalAttributes">
        <div id="@_dialogId"
             class="sf-sheet"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             aria-describedby="@(string.IsNullOrEmpty(Description) ? null : _descriptionId)"
             tabindex="-1"
             @ref="_dialogRef"
             @onclick:stopPropagation="true">
            <div class="sf-sheet__header">
                <h2 id="@_titleId">@Title</h2>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p id="@_descriptionId">@Description</p>
                }
                <button type="button" aria-label="@CloseLabel" @onclick="Close">×</button>
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    private static readonly string A11yModulePath = Harborline.Api.UIAdapters.Blazor.Internal.Interop.HarborlineJsModuleLoader.Resolve("js/harborline-dialog-a11y.js");
    private readonly string _dialogId = $"sf-sheet-{Guid.NewGuid():N}";
    private readonly string _titleId = $"sf-sheet-title-{Guid.NewGuid():N}";
    private readonly string _descriptionId = $"sf-sheet-description-{Guid.NewGuid():N}";
    private ElementReference _dialogRef;
    private IJSObjectReference? _a11yModule;
    private DotNetObjectReference<HarborlineSheet>? _dotNetRef;
    private bool _a11yAttached;
    private bool _wasOpen;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Panel";
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_wasOpen)
        {
            await AttachA11yAsync();
            _wasOpen = true;
        }
        else if (!Open && _wasOpen)
        {
            await DetachA11yAsync();
            _wasOpen = false;
        }
    }

    private async Task AttachA11yAsync()
    {
        if (_a11yAttached) return;
        try
        {
            _a11yModule ??= await JS.InvokeAsync<IJSObjectReference>("import", A11yModulePath);
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _a11yModule.InvokeVoidAsync(
                "attach",
                _dialogId,
                _dialogRef,
                _dotNetRef,
                new { closeOnEsc = true, escMethod = nameof(OnEscFromJs) });
            _a11yAttached = true;
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task DetachA11yAsync()
    {
        if (!_a11yAttached || _a11yModule is null) return;
        try
        {
            await _a11yModule.InvokeVoidAsync("detach", _dialogId);
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        _a11yAttached = false;
    }

    [JSInvokable]
    public async Task OnEscFromJs() => await Close();

    private async Task Close()
    {
        if (!Open) return;
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await DetachA11yAsync();
            if (_a11yModule is not null) await _a11yModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        _dotNetRef?.Dispose();
    }
}
