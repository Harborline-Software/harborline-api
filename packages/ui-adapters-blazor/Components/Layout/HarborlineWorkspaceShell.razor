@namespace Harborline.Api.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase
<div class="@CombineClasses("sf-workspace-shell", SidebarOpen ? null : "sf-workspace-shell--sidebar-collapsed", PanelOpen ? "sf-workspace-shell--panel-open" : null)"
     style="@CombineStyles("display:flex;flex-direction:column;min-height:0;height:100%;")"
     @attributes="AdditionalAttributes">
    <div class="sf-workspace-shell__header" role="region" aria-label="@(HeaderAriaLabel ?? "Workspace header")">
        @if (Sidebar != null)
        {
            <button type="button"
                    class="sf-workspace-shell__sidebar-toggle"
                    aria-expanded="@SidebarOpen.ToString().ToLowerInvariant()"
                    aria-controls="@_sidebarId"
                    aria-label="@(SidebarToggleAriaLabel ?? "Toggle sidebar")"
                    style="min-width:24px;min-height:24px;"
                    @onclick="ToggleSidebarAsync">@SidebarToggleText</button>
        }
        @Header
        @if (Panel != null)
        {
            <button type="button"
                    class="sf-workspace-shell__panel-toggle"
                    aria-expanded="@PanelOpen.ToString().ToLowerInvariant()"
                    aria-controls="@_panelId"
                    aria-label="@(PanelToggleAriaLabel ?? "Toggle details panel")"
                    style="min-width:24px;min-height:24px;"
                    @onclick="TogglePanelAsync">@PanelToggleText</button>
        }
    </div>
    <div class="sf-workspace-shell__body" style="display:flex;flex:1;min-height:0;">
        @if (Sidebar != null)
        {
            <nav id="@_sidebarId" class="sf-workspace-shell__sidebar" aria-label="@(SidebarAriaLabel ?? "Workspace")" hidden="@(!SidebarOpen)">@Sidebar</nav>
        }
        <div id="@_mainId" class="sf-workspace-shell__main" role="region" aria-label="@(MainAriaLabel ?? "Workspace content")" style="flex:1;min-width:0;">@ChildContent</div>
        @if (Panel != null)
        {
            <aside id="@_panelId" class="sf-workspace-shell__panel" aria-label="@(PanelAriaLabel ?? "Details")" hidden="@(!PanelOpen)">@Panel</aside>
        }
    </div>
</div>
@code {
    private readonly string _sidebarId = $"sf-workspace-shell-sidebar-{Guid.NewGuid():N}";
    private readonly string _mainId = $"sf-workspace-shell-main-{Guid.NewGuid():N}";
    private readonly string _panelId = $"sf-workspace-shell-panel-{Guid.NewGuid():N}";

    /// <summary>Header region content (title, switcher, global actions).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Sidebar region content.</summary>
    [Parameter] public RenderFragment? Sidebar { get; set; }

    /// <summary>Main region content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional details panel content shown at the trailing edge.</summary>
    [Parameter] public RenderFragment? Panel { get; set; }

    /// <summary>Whether the sidebar is expanded.</summary>
    [Parameter] public bool SidebarOpen { get; set; } = true;

    /// <summary>Raised when the sidebar toggle changes state.</summary>
    [Parameter] public EventCallback<bool> SidebarOpenChanged { get; set; }

    /// <summary>Whether the details panel is expanded.</summary>
    [Parameter] public bool PanelOpen { get; set; }

    /// <summary>Raised when the panel toggle changes state.</summary>
    [Parameter] public EventCallback<bool> PanelOpenChanged { get; set; }

    /// <summary>Accessible name of the header region. Falls back to "Workspace header".</summary>
    [Parameter] public string? HeaderAriaLabel { get; set; }

    /// <summary>Accessible name of the sidebar navigation. Falls back to "Workspace".</summary>
    [Parameter] public string? SidebarAriaLabel { get; set; }

    /// <summary>Accessible name of the main region. Falls back to "Workspace content".</summary>
    [Parameter] public string? MainAriaLabel { get; set; }

    /// <summary>Accessible name of the details panel. Falls back to "Details".</summary>
    [Parameter] public string? PanelAriaLabel { get; set; }

    /// <summary>Accessible name of the sidebar toggle. Falls back to "Toggle sidebar".</summary>
    [Parameter] public string? SidebarToggleAriaLabel { get; set; }

    /// <summary>Accessible name of the panel toggle. Falls back to "Toggle details panel".</summary>
    [Parameter] public string? PanelToggleAriaLabel { get; set; }

    /// <summary>Visible text of the sidebar toggle.</summary>
    [Parameter] public string SidebarToggleText { get; set; } = "☰";

    /// <summary>Visible text of the panel toggle.</summary>
    [Parameter] public string PanelToggleText { get; set; } = "⋮";

    private async Task ToggleSidebarAsync()
    {
        SidebarOpen = !SidebarOpen;
        await SidebarOpenChanged.InvokeAsync(SidebarOpen);
    }

    private async Task TogglePanelAsync()
    {
        PanelOpen = !PanelOpen;
        await PanelOpenChanged.InvokeAsync(PanelOpen);
    }
}
