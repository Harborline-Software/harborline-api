@namespace Harborline.Api.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase
<header class="@CombineClasses("sf-page-header")" style="@CombineStyles()" aria-labelledby="@_titleId" @attributes="AdditionalAttributes">
    @if (Breadcrumb != null)
    {
        <div class="sf-page-header__breadcrumb">@Breadcrumb</div>
    }
    <div class="sf-page-header__row">
        <div class="sf-page-header__titles">
            @if (!string.IsNullOrEmpty(Eyebrow))
            {
                <p class="sf-page-header__eyebrow">@Eyebrow</p>
            }
            @Heading
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="sf-page-header__description">@Description</p>
            }
        </div>
        @if (Actions != null)
        {
            <div class="sf-page-header__actions" role="group" aria-label="@(ActionsAriaLabel ?? "Page actions")">@Actions</div>
        }
    </div>
    @if (ChildContent != null)
    {
        <div class="sf-page-header__extra">@ChildContent</div>
    }
</header>
@code {
    private readonly string _titleId = $"sf-page-header-title-{Guid.NewGuid():N}";

    /// <summary>The page title text.</summary>
    [Parameter] public string Title { get; set; } = string.Empty;

    /// <summary>Heading level rendered for <see cref="Title"/> (1–6). Defaults to 1.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 1;

    /// <summary>Small text rendered above the title.</summary>
    [Parameter] public string? Eyebrow { get; set; }

    /// <summary>Supporting description rendered under the title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Optional breadcrumb slot rendered above the title row.</summary>
    [Parameter] public RenderFragment? Breadcrumb { get; set; }

    /// <summary>Optional actions slot rendered at the end of the title row.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Accessible name of the actions group. Falls back to "Page actions".</summary>
    [Parameter] public string? ActionsAriaLabel { get; set; }

    /// <summary>Extra content rendered under the title row (tabs, filters, metadata).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private RenderFragment Heading => builder =>
    {
        var level = Math.Clamp(HeadingLevel, 1, 6);
        builder.OpenElement(0, $"h{level}");
        builder.AddAttribute(1, "id", _titleId);
        builder.AddAttribute(2, "class", "sf-page-header__title");
        builder.AddContent(3, Title);
        builder.CloseElement();
    };
}
