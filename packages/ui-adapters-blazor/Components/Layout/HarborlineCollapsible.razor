@namespace Harborline.Api.UIAdapters.Blazor.Components.Layout
@inherits HarborlineComponentBase
<section class="@CombineClasses("sf-collapsible")" style="@CombineStyles()" @attributes="AdditionalAttributes"><button id="@_triggerId" type="button" aria-expanded="@Open.ToString().ToLowerInvariant()" aria-controls="@_contentId" @onclick="Toggle">@Label</button>@if (Open) { <div id="@_contentId" role="region" aria-labelledby="@_triggerId">@ChildContent</div> }</section>
@code { private readonly string _triggerId = $"sf-collapsible-trigger-{Guid.NewGuid():N}"; private readonly string _contentId = $"sf-collapsible-content-{Guid.NewGuid():N}"; [Parameter] public bool Open { get; set; } [Parameter] public EventCallback<bool> OpenChanged { get; set; } [Parameter] public string Label { get; set; } = "Toggle"; [Parameter] public RenderFragment? ChildContent { get; set; } private async Task Toggle() { Open = !Open; await OpenChanged.InvokeAsync(Open); } }
