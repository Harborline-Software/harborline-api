@namespace Harborline.Api.UIAdapters.Blazor.Components.Feedback
@inherits HarborlineComponentBase

@if (Variant == LoadingStateVariant.Inline)
{
    <p class="@CombineClasses("sf-loading-state sf-loading-state--inline")" role="status" aria-live="polite" style="@CombineStyles()" @attributes="AdditionalAttributes">@Label</p>
}
else
{
    <div class="@CombineClasses("sf-loading-state sf-loading-state--page")" role="status" aria-live="polite" style="@CombineStyles()" @attributes="AdditionalAttributes">@Label</div>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public LoadingStateVariant Variant { get; set; } = LoadingStateVariant.Page;
}
