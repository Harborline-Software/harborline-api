@namespace Harborline.Api.UIAdapters.Blazor.Components.Feedback
@inherits HarborlineComponentBase

@*
    HarborlineHoverCard — rich hover preview card. Parity with ui-react
    HoverCard/HoverCardTrigger/HoverCardContent, flattened into one component
    with TriggerContent + ChildContent slots.

    Opens on pointer-enter (after OpenDelay) or keyboard focus; closes on
    pointer-leave (after CloseDelay), blur, or Escape. aria-expanded is
    rendered lowercase.
*@

<span class="@CombineClasses("sf-hover-card")"
      style="@CombineStyles("position:relative;display:inline-block;")"
      @onmouseenter="ScheduleOpen"
      @onmouseleave="ScheduleClose"
      @onfocusin="OpenNow"
      @onfocusout="CloseNow"
      @onkeydown="HandleKeyDown"
      @attributes="AdditionalAttributes">
    <span class="sf-hover-card__trigger"
          tabindex="0"
          role="button"
          aria-label="Hover card"
          aria-expanded="@(_open ? "true" : "false")"
          aria-describedby="@(_open ? _contentId : null)">
        @TriggerContent
    </span>
    @if (_open)
    {
        <div id="@_contentId"
             class="sf-hover-card__content"
             role="tooltip"
             style="position:absolute;top:calc(100% + .4rem);inset-inline-start:0;z-index:50;min-width:16rem;max-width:22rem;background:var(--color-card);border:1px solid var(--color-border);border-radius:.5rem;box-shadow:var(--color-shadow);padding:.85rem;">
            @ChildContent
        </div>
    }
</span>

@code {
    private static int _instanceCounter;
    private readonly string _contentId = $"sf-hover-card-{Interlocked.Increment(ref _instanceCounter)}";

    private bool _open;
    private CancellationTokenSource? _pending;

    /// <summary>The always-visible trigger element.</summary>
    [Parameter, EditorRequired] public RenderFragment? TriggerContent { get; set; }

    /// <summary>The card content shown while open.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Delay in ms before the card opens on hover. Default 400.</summary>
    [Parameter] public int OpenDelay { get; set; } = 400;

    /// <summary>Delay in ms before the card closes after the pointer leaves. Default 200.</summary>
    [Parameter] public int CloseDelay { get; set; } = 200;

    private void ScheduleOpen() => Schedule(open: true, OpenDelay);
    private void ScheduleClose() => Schedule(open: false, CloseDelay);

    private void OpenNow() => Set(true);
    private void CloseNow() => Set(false);

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Set(false);
        else if (e.Key is "Enter" or " ") Set(true);
    }

    private void Schedule(bool open, int delayMs)
    {
        _pending?.Cancel();
        var cts = new CancellationTokenSource();
        _pending = cts;
        _ = Task.Delay(Math.Max(0, delayMs), cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _ = InvokeAsync(() => Set(open));
        }, TaskScheduler.Default);
    }

    private void Set(bool open)
    {
        _pending?.Cancel();
        if (_open == open) return;
        _open = open;
        StateHasChanged();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing) _pending?.Cancel();
        base.Dispose(disposing);
    }
}
