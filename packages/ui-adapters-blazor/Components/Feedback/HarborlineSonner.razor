@namespace Harborline.Api.UIAdapters.Blazor.Components.Feedback
@inherits HarborlineComponentBase

<section class="@CombineClasses($"sf-sonner sf-sonner--{PositionClass}")"
         style="@CombineStyles("position:fixed;z-index:80;display:flex;flex-direction:column;gap:.5rem;max-width:24rem;")"
         aria-label="Notifications"
         @attributes="AdditionalAttributes">
    @foreach (var toast in Toasts.Take(Math.Max(1, VisibleToasts)))
    {
        var isError = toast.Variant == SonnerToastVariant.Error;
        <article class="@CombineClasses($"sf-sonner__toast sf-sonner__toast--{toast.Variant.ToString().ToLowerInvariant()}")"
                 style="@CombineStyles("border:1px solid var(--color-border);border-radius:.375rem;background:var(--color-card);color:var(--color-foreground);padding:.75rem;")"
                 role="@(isError ? "alert" : "status")">
            <div class="sf-sonner__message">@toast.Message</div>
            @if (!string.IsNullOrWhiteSpace(toast.Description))
            {
                <div class="sf-sonner__description">@toast.Description</div>
            }
            <div class="sf-sonner__actions">
                @if (!string.IsNullOrWhiteSpace(toast.ActionLabel))
                {
                    <button type="button" style="min-width:24px;min-height:24px;" @onclick="() => OnAction.InvokeAsync(toast)">@toast.ActionLabel</button>
                }
                @if (CloseButton)
                {
                    <button type="button"
                            style="min-width:24px;min-height:24px;"
                            aria-label="Dismiss notification"
                            @onclick="() => OnDismiss.InvokeAsync(toast.Id)">×</button>
                }
            </div>
        </article>
    }
</section>

@code {
    /// <summary>Current host-owned toast entries.</summary>
    [Parameter] public IReadOnlyList<SonnerToastItem> Toasts { get; set; } = Array.Empty<SonnerToastItem>();

    /// <summary>Maximum number of visible entries.</summary>
    [Parameter] public int VisibleToasts { get; set; } = 3;

    /// <summary>Whether each toast has a dismiss button.</summary>
    [Parameter] public bool CloseButton { get; set; } = true;

    /// <summary>Logical placement: top/bottom + start/center/end.</summary>
    [Parameter] public string Position { get; set; } = "bottom-end";

    /// <summary>Raised with the id of a dismissed toast.</summary>
    [Parameter] public EventCallback<string> OnDismiss { get; set; }

    /// <summary>Raised when a toast action is selected.</summary>
    [Parameter] public EventCallback<SonnerToastItem> OnAction { get; set; }

    private string PositionClass => Position.Trim().ToLowerInvariant() switch
    {
        "top-start" => "top-start",
        "top-center" => "top-center",
        "top-end" => "top-end",
        "bottom-start" => "bottom-start",
        "bottom-center" => "bottom-center",
        _ => "bottom-end",
    };
}
