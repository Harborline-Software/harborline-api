@namespace Harborline.Api.UIAdapters.Blazor.Components.Structural
@inherits HarborlineComponentBase

<div class="@CombineClasses("sf-saved-views-menu")" @attributes="AdditionalAttributes">
    <label class="sf-saved-views-menu__label" for="@_selectId">@(Label ?? "Saved view")</label>
    <select id="@_selectId" class="sf-saved-views-menu__select" aria-label="@(AriaLabel ?? Label ?? "Saved view")" @onchange="OnSelectionChanged">
        <option value="">Choose a view</option>
        @foreach (var view in Views)
        {
            <option value="@view.Name">@view.Name</option>
        }
    </select>
    @if (OnSave.HasDelegate)
    {
        <button type="button" class="sf-saved-views-menu__save" @onclick="SaveCurrent">Save current</button>
    }
    @if (CurrentState is not null)
    {
        <span class="sf-saved-views-menu__summary">@CurrentState.Summary</span>
    }
</div>

@code {
    private readonly string _selectId = $"harborline-saved-view-{Guid.NewGuid():N}";

    [Parameter] public IReadOnlyList<HarborlineSavedView> Views { get; set; } = Array.Empty<HarborlineSavedView>();
    [Parameter] public HarborlineSavedViewState? CurrentState { get; set; }
    [Parameter] public EventCallback<HarborlineSavedView> ViewApplied { get; set; }
    [Parameter] public EventCallback<HarborlineSavedView> OnSave { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private async Task OnSelectionChanged(ChangeEventArgs args)
    {
        var name = args.Value?.ToString();
        var view = Views.FirstOrDefault(candidate => candidate.Name == name);
        if (view is not null)
            await ViewApplied.InvokeAsync(view);
    }

    private Task SaveCurrent() => CurrentState is null
        ? Task.CompletedTask
        : OnSave.InvokeAsync(new HarborlineSavedView("Current view", CurrentState));
}
