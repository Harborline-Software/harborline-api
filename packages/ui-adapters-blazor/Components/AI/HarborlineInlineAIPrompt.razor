@namespace Harborline.Api.UIAdapters.Blazor.Components.AI
@inherits HarborlineComponentBase

@if (Show)
{
    <section class="@CombineClasses($"sf-inline-aiprompt sf-inline-aiprompt--{SizeClass}")"
             style="@CombineStyles(PositionStyle)"
             role="dialog"
             aria-label="Inline AI prompt"
             @attributes="AdditionalAttributes">
        <div class="sf-inline-aiprompt__body">
            <textarea class="sf-inline-aiprompt__editor"
                      rows="3"
                      aria-label="Inline prompt"
                      placeholder="@Placeholder"
                      disabled="@Disabled"
                      value="@Value"
                      @oninput="HandleInput"
                      @onkeydown="HandleKeyDown"></textarea>

            @if (Suggestions is { Count: > 0 })
            {
                <div class="sf-inline-aiprompt__suggestions" role="toolbar" aria-label="Prompt suggestions">
                    @foreach (var suggestion in Suggestions)
                    {
                        <button type="button"
                                class="sf-inline-aiprompt__chip"
                                style="min-width:24px;min-height:24px;"
                                disabled="@Disabled"
                                @onclick="() => ApplySuggestionAsync(suggestion)">
                            @suggestion
                        </button>
                    }
                </div>
            }

            @if (Commands is { Count: > 0 })
            {
                <div class="sf-inline-aiprompt__commands" role="toolbar" aria-label="Prompt commands">
                    @foreach (var command in Commands)
                    {
                        <button type="button"
                                class="sf-inline-aiprompt__command"
                                style="min-width:24px;min-height:24px;"
                                disabled="@Disabled"
                                @onclick="() => ExecuteCommandAsync(command)">
                            @command.Text
                        </button>
                    }
                </div>
            }
        </div>

        <div class="sf-inline-aiprompt__actions">
            @if (Streaming)
            {
                <button type="button"
                        class="sf-inline-aiprompt__cancel"
                        style="min-width:24px;min-height:24px;"
                        disabled="@Disabled"
                        @onclick="CancelAsync">Cancel</button>
            }
            else
            {
                <button type="button"
                        class="sf-inline-aiprompt__submit"
                        style="min-width:24px;min-height:24px;"
                        disabled="@(Disabled || string.IsNullOrWhiteSpace(Value))"
                        @onclick="SubmitAsync">Apply</button>
            }
            <button type="button"
                    class="sf-inline-aiprompt__dismiss"
                    style="min-width:24px;min-height:24px;"
                    disabled="@Disabled"
                    @onclick="DismissAsync">Close</button>
        </div>

        @if (Outputs is { Count: > 0 })
        {
            <div class="sf-inline-aiprompt__outputs" aria-label="AI outputs">
                @foreach (var output in Outputs)
                {
                    <article class="sf-inline-aiprompt__output"
                             aria-live="@(output.Status == InlineAIPromptOutputStatus.Streaming ? "off" : "polite")">
                        @if (OutputTemplate is not null)
                        {
                            @OutputTemplate(output)
                        }
                        else
                        {
                            <div class="sf-inline-aiprompt__output-prompt">@output.Prompt</div>
                            <div class="sf-inline-aiprompt__output-response">
                                @(output.Status == InlineAIPromptOutputStatus.Pending ? "Thinking…" : output.Response)
                            </div>
                            <div class="sf-inline-aiprompt__output-actions" role="toolbar" aria-label="Output actions">
                                <button type="button" style="min-width:24px;min-height:24px;" @onclick="() => CopyAsync(output)">Copy</button>
                                <button type="button" style="min-width:24px;min-height:24px;" @onclick="() => DiscardAsync(output)">Discard</button>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    /// <summary>Whether the inline prompt is visible. Two-way bound.</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>Two-way binding callback for <see cref="Show"/>.</summary>
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }

    /// <summary>Prompt text. Two-way bound.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Two-way binding callback for <see cref="Value"/>.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Raised when the prompt is submitted.</summary>
    [Parameter] public EventCallback<InlineAIPromptEventArgs> OnInline { get; set; }

    /// <summary>Quick actions that populate the prompt.</summary>
    [Parameter] public IReadOnlyList<string>? Suggestions { get; set; }

    /// <summary>Canonical size: <c>sm</c>, <c>md</c>, or <c>lg</c>.</summary>
    [Parameter] public string Size { get; set; } = "md";

    /// <summary>Disables editor and action controls.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Displayed while the host is generating an output.</summary>
    [Parameter] public bool Streaming { get; set; }

    /// <summary>Output cards supplied by the host. No inference is performed by the adapter.</summary>
    [Parameter] public IReadOnlyList<InlineAIPromptOutput>? Outputs { get; set; }

    /// <summary>Optional output renderer.</summary>
    [Parameter] public RenderFragment<InlineAIPromptOutput>? OutputTemplate { get; set; }

    /// <summary>Optional command buttons.</summary>
    [Parameter] public IReadOnlyList<InlineAIPromptCommand>? Commands { get; set; }

    /// <summary>Raised when a command button is selected.</summary>
    [Parameter] public EventCallback<InlineAIPromptCommand> OnCommandExecute { get; set; }

    /// <summary>Raised when the host should cancel an in-flight generation.</summary>
    [Parameter] public EventCallback OnPromptCancel { get; set; }

    /// <summary>Raised when Copy is selected for an output.</summary>
    [Parameter] public EventCallback<InlineAIPromptOutput> OnCopy { get; set; }

    /// <summary>Raised when Discard is selected for an output.</summary>
    [Parameter] public EventCallback<InlineAIPromptOutput> OnDiscard { get; set; }

    /// <summary>Editor placeholder.</summary>
    [Parameter] public string Placeholder { get; set; } = "Ask for a rewrite…";

    /// <summary>When true, positions the surface as an anchored popover.</summary>
    [Parameter] public bool Anchored { get; set; }

    /// <summary>Optional CSS positioning value such as <c>top: 3rem; inset-inline-start: 1rem</c>.</summary>
    [Parameter] public string? AnchorStyle { get; set; }

    private string SizeClass => Size.Trim().ToLowerInvariant() switch
    {
        "sm" or "small" => "sm",
        "lg" or "large" => "lg",
        _ => "md",
    };

    private string? PositionStyle => Anchored
        ? $"position:absolute;z-index:30;{AnchorStyle}"
        : AnchorStyle;

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SubmitAsync();
    }

    private async Task ApplySuggestionAsync(string suggestion)
    {
        if (Disabled) return;
        Value = suggestion;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SubmitAsync()
    {
        if (Disabled || Streaming || string.IsNullOrWhiteSpace(Value)) return;
        var args = new InlineAIPromptEventArgs(Value);
        await OnInline.InvokeAsync(args);
        if (!args.IsCancelled) await DismissAsync();
    }

    private Task CancelAsync() => OnPromptCancel.InvokeAsync();

    private Task ExecuteCommandAsync(InlineAIPromptCommand command)
        => OnCommandExecute.InvokeAsync(command);

    private Task CopyAsync(InlineAIPromptOutput output) => OnCopy.InvokeAsync(output);

    private Task DiscardAsync(InlineAIPromptOutput output) => OnDiscard.InvokeAsync(output);

    private async Task DismissAsync()
    {
        Show = false;
        await ShowChanged.InvokeAsync(Show);
    }
}
