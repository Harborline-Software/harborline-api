@namespace Harborline.Api.UIAdapters.Blazor.Components.LocalFirst
@inherits HarborlineComponentBase

<nav class="@Classes"
     style="@CombineStyles()"
     role="navigation"
     aria-label="Team switcher"
     @attributes="AdditionalAttributes">
    <HarborlineDropDownList TItem="TeamSwitcherOption"
                          TValue="string"
                          Data="@State.Teams"
                          TextField="@nameof(TeamSwitcherOption.DisplayName)"
                          ValueField="@nameof(TeamSwitcherOption.Id)"
                          Value="@State.ActiveTeamId"
                          ValueChanged="HandleTeamChangedAsync"
                          Placeholder="Select a team"
                          aria-label="Active team">
        <ItemTemplate Context="team">
            <span class="sf-team-switcher__option">
                <span class="sf-team-switcher__name">@team.DisplayName</span>
                @if (team.IsLegacyPrimary)
                {
                    <span class="sf-team-switcher__tag">(primary)</span>
                }
                @if (team.UnreadCount > 0)
                {
                    <span class="sf-team-switcher__count"
                          aria-label="@($"{team.UnreadCount} unread")">@FormatCount(team.UnreadCount)</span>
                }
            </span>
        </ItemTemplate>
    </HarborlineDropDownList>

    <footer class="sf-team-switcher__footer">
        @if (State.AggregateUnread > 0)
        {
            <div class="sf-team-switcher__aggregate" aria-live="polite">
                <span class="sf-team-switcher__aggregate-label">Total unread</span>
                <span class="sf-team-switcher__aggregate-count">@FormatCount(State.AggregateUnread)</span>
            </div>
        }
        <button type="button"
                class="sf-team-switcher__add"
                @onclick="HandleAddClickAsync">
            <span class="sf-team-switcher__add-glyph" aria-hidden="true">+</span>
            <span class="sf-team-switcher__add-label">Add team</span>
        </button>
    </footer>
</nav>
