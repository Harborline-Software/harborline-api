@inherits HarborlineComponentBase

<button class="@CombineClasses(CssProvider.ButtonClass(Variant, Size, FillMode.Solid, RoundedMode.Medium, !Enabled || Loading))"
        style="@CombineStyles()"
        type="button"
        disabled="@(!Enabled || Loading)"
        aria-label="@AriaLabel"
        aria-busy="@(Loading ? "true" : null)"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="@CssProvider.SpinnerClass(SpinnerSize.Small)" aria-hidden="true"></span>
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @IconProvider.GetIconMarkup(Icon, IconSize.Medium)
    }
</button>

@code {
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Secondary;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The accessible name. Required: an icon-only button has no visible label text, so this is
    /// its sole accessible name (IconButton.Accessibility contract section 1). Matches the React
    /// reference, where <c>aria-label</c> is a required, non-optional prop.
    /// </summary>
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
