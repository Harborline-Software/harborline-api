@namespace Harborline.Api.UIAdapters.Blazor.Components.Buttons
@inherits HarborlineComponentBase

<div class="@CombineClasses(FilterCss)"
     style="@CombineStyles()"
     role="listbox"
     aria-multiselectable="@Multiple.ToString().ToLowerInvariant()"
     aria-label="@(AriaLabel ?? "Filter options")"
     @onkeydown="HandleKeyDown"
     @attributes="AdditionalAttributes">
    @foreach (var option in _options)
    {
        var captured = option;
        var selected = IsSelected(option.Value);
        var index = _options.IndexOf(option);
        <div class="sf-filterchips__chip @(selected ? "mar-filterchips__chip--selected" : "")"
             role="option"
             aria-selected="@selected.ToString().ToLowerInvariant()"
             aria-disabled="@(!Enabled ? "true" : null)"
             tabindex="@(index == _activeIndex ? 0 : -1)"
             @onclick="() => Select(captured.Value)"
             @onfocus="() => _activeIndex = index">
            <span>@option.Label</span>
            @if (option.Count is { } count)
            {
                <span class="sf-filterchips__count" aria-hidden="true">@count</span>
            }
        </div>
    }
</div>

@code {
    private int _activeIndex;
    private List<FilterChipOption> _options = [];
    private HashSet<string> _selectedValues = [];

    [Parameter] public IEnumerable<FilterChipOption>? Options { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public List<string> Values { get; set; } = [];
    [Parameter] public EventCallback<List<string>> ValuesChanged { get; set; }
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    private string FilterCss => Enabled ? "mar-filterchips" : "mar-filterchips mar-filterchips--disabled";

    protected override void OnParametersSet()
    {
        _options = (Options ?? []).ToList();
        var initialValues = Multiple
            ? (IEnumerable<string>)(Values ?? [])
            : Value is null ? Enumerable.Empty<string>() : [Value];
        _selectedValues = initialValues.ToHashSet(StringComparer.Ordinal);
        _activeIndex = _options.Count == 0 ? 0 : Math.Clamp(_activeIndex, 0, _options.Count - 1);
    }

    private bool IsSelected(string value) => _selectedValues.Contains(value);

    private async Task Select(string value)
    {
        if (!Enabled) return;
        if (Multiple)
        {
            if (!_selectedValues.Add(value)) _selectedValues.Remove(value);
            Values = _options.Select(option => option.Value)
                .Where(_selectedValues.Contains)
                .ToList();
            await ValuesChanged.InvokeAsync(Values);
        }
        else
        {
            Value = IsSelected(value) ? null : value;
            _selectedValues = Value is null ? [] : [Value];
            await ValueChanged.InvokeAsync(Value);
        }
        await OnChange.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (_options.Count == 0) return;
        switch (args.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                _activeIndex = (_activeIndex + 1) % _options.Count;
                break;
            case "ArrowLeft":
            case "ArrowUp":
                _activeIndex = (_activeIndex - 1 + _options.Count) % _options.Count;
                break;
            case "Home":
                _activeIndex = 0;
                break;
            case "End":
                _activeIndex = _options.Count - 1;
                break;
            case "Enter":
            case " ":
                await Select(_options[_activeIndex].Value);
                break;
        }
    }
}
