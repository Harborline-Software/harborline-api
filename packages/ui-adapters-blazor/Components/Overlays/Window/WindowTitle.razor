@namespace Harborline.Api.UIAdapters.Blazor.Components.Overlays
@* WindowTitle — semantic child component for HarborlineWindow title content. *@

@ChildContent

@code {
    [CascadingParameter] internal HarborlineWindow? ParentWindow { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (ParentWindow is null)
            throw new InvalidOperationException("WindowTitle must be placed inside a HarborlineWindow.");
        ParentWindow.SetTitleFragment(ChildContent);
    }
}
