@namespace Harborline.Api.UIAdapters.Blazor.Components.Overlays
@* WindowActions — container for WindowAction child components in a HarborlineWindow. *@

@ChildContent

@code {
    [CascadingParameter] internal HarborlineWindow? ParentWindow { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (ParentWindow is null)
            throw new InvalidOperationException("WindowActions must be placed inside a HarborlineWindow.");
        ParentWindow.SetUsingChildActions(true);
    }
}
