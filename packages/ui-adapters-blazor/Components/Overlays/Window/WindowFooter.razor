@namespace Harborline.Api.UIAdapters.Blazor.Components.Overlays
@* WindowFooter — semantic child component for HarborlineWindow footer content. *@

@ChildContent

@code {
    [CascadingParameter] internal HarborlineWindow? ParentWindow { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (ParentWindow is null)
            throw new InvalidOperationException("WindowFooter must be placed inside a HarborlineWindow.");
        ParentWindow.SetFooterFragment(ChildContent);
    }
}
