@namespace Harborline.Api.UIAdapters.Blazor.Components.Overlays
@* WindowContent — semantic child component for HarborlineWindow body content. *@

@ChildContent

@code {
    [CascadingParameter] internal HarborlineWindow? ParentWindow { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (ParentWindow is null)
            throw new InvalidOperationException("WindowContent must be placed inside a HarborlineWindow.");
        ParentWindow.SetContentFragment(ChildContent);
    }
}
