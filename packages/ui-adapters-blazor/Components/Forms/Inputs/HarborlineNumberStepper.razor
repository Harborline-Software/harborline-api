@inherits HarborlineComponentBase

<div class="@CombineClasses(StepperCss)"
     style="@CombineStyles()"
     role="group"
     aria-label="@(AriaLabel ?? Label ?? "Number stepper")"
     @attributes="AdditionalAttributes">
    <button type="button"
            class="sf-numberstepper__btn sf-numberstepper__btn--decrement"
            aria-label="Decrease @(Label ?? "value")"
            disabled="@(!Enabled || Value <= Min)"
            @onclick="Decrement">&minus;</button>
    <input id="@InputId"
           type="number"
           inputmode="numeric"
           class="sf-numberstepper__value"
           role="spinbutton"
           aria-valuenow="@Value"
           aria-valuemin="@Min"
           aria-valuemax="@Max"
           aria-label="@(AriaLabel ?? Label ?? "Number stepper")"
           min="@Min"
           max="@Max"
           step="@EffectiveStep"
           value="@Value"
           readonly="@(!Enabled)"
           disabled="@(!Enabled)"
           @onchange="HandleInput"
           @onkeydown="HandleKeyDown" />
    <button type="button"
            class="sf-numberstepper__btn sf-numberstepper__btn--increment"
            aria-label="Increase @(Label ?? "value")"
            disabled="@(!Enabled || Value >= Max)"
            @onclick="Increment">+</button>
</div>

@code {
    /// <summary>The current value. Powers <c>@@bind-Value</c>.</summary>
    [Parameter] public int Value { get; set; }

    /// <summary>Fires when the value changes via the buttons, keyboard, or direct entry.</summary>
    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    /// <summary>Fires when the value changes, matching the React <c>onChange</c> surface.</summary>
    [Parameter] public EventCallback<int> OnChange { get; set; }

    [Parameter] public int Min { get; set; } = int.MinValue;
    [Parameter] public int Max { get; set; } = int.MaxValue;

    /// <summary>Amount added or removed per step. Defaults to 1.</summary>
    [Parameter] public int Step { get; set; } = 1;

    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;

    private readonly string _generatedInputId = $"sf-numberstepper-{Guid.NewGuid():N}";
    private string InputId => Id ?? _generatedInputId;
    private int EffectiveStep => Math.Max(1, Math.Abs(Step));

    private string StepperCss
    {
        get
        {
            var cls = "mar-numberstepper";
            cls += Size switch
            {
                ButtonSize.Small => " mar-numberstepper--sm",
                ButtonSize.Large => " mar-numberstepper--lg",
                _ => string.Empty,
            };
            if (!Enabled) cls += " mar-numberstepper--disabled";
            return cls;
        }
    }

    private Task Increment() => SetValue((long)Value + EffectiveStep);

    private Task Decrement() => SetValue((long)Value - EffectiveStep);

    private Task HandleInput(ChangeEventArgs args)
    {
        return long.TryParse(args.Value?.ToString(), out var parsed)
            ? SetValue(parsed)
            : SetValue(Value);
    }

    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key switch
    {
        "ArrowUp" => Increment(),
        "ArrowDown" => Decrement(),
        _ => Task.CompletedTask,
    };

    private async Task SetValue(long candidate)
    {
        if (!Enabled) return;
        var clamped = (int)Math.Clamp(candidate, Min, Max);
        if (clamped == Value) return;
        Value = clamped;
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync(Value);
    }
}
