@inherits HarborlineComponentBase

<div class="@CombineClasses("mar-inlineedit")"
     style="@CombineStyles()"
     @attributes="AdditionalAttributes">
    @if (_editing)
    {
        <input type="text"
               class="sf-inlineedit__input"
               aria-label="@(AriaLabel ?? "Inline edit")"
               value="@_draft"
               maxlength="@MaxLength"
               disabled="@(!Enabled)"
               @oninput="HandleInput"
               @onkeydown="HandleKeyDown"
               @onblur="Confirm" />
    }
    else
    {
        <button type="button"
                class="sf-inlineedit__display @(string.IsNullOrEmpty(Value) ? "mar-inlineedit__display--empty" : "")"
                aria-label="@(AriaLabel ?? "Inline edit")"
                disabled="@(!Enabled)"
                @onclick="BeginEdit">
            @(string.IsNullOrEmpty(Value) ? Placeholder ?? "Click to edit" : Value)
        </button>
    }
</div>

@code {
    private bool _editing;
    private string _draft = string.Empty;

    /// <summary>The confirmed value. Powers <c>@@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Fires when an edit is confirmed with Enter or blur. Escape cancels without firing.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Alias for confirm semantics, matching the React <c>onConfirm</c> surface.</summary>
    [Parameter] public EventCallback<string?> OnConfirm { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    private void BeginEdit()
    {
        if (!Enabled) return;
        _draft = Value ?? string.Empty;
        _editing = true;
    }

    private void HandleInput(ChangeEventArgs args)
    {
        _draft = args.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter":
                await Confirm();
                break;
            case "Escape":
                _editing = false;
                break;
        }
    }

    private async Task Confirm()
    {
        if (!_editing) return;
        _editing = false;
        var confirmed = _draft.Trim();
        if (confirmed.Length == 0 || confirmed == (Value ?? string.Empty)) return;
        Value = confirmed;
        await ValueChanged.InvokeAsync(Value);
        await OnConfirm.InvokeAsync(Value);
    }
}
