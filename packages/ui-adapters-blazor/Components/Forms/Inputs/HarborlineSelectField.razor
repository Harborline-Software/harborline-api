@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Inputs
@inherits HarborlineComponentBase

<select id="@Name"
        name="@Name"
        class="@CombineClasses(CssProvider.SelectClass(Error))"
        value="@Value"
        disabled="@Disabled"
        aria-invalid="@(Error ? "true" : null)"
        @onchange="HandleChange"
        @attributes="AdditionalAttributes">
    @if (string.IsNullOrEmpty(Value))
    {
        <option value="" disabled>@Placeholder</option>
    }
    @foreach (var option in Options)
    {
        <option value="@option.Value">@option.Label</option>
    }
</select>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<SelectFieldOption> Options { get; set; } = Array.Empty<SelectFieldOption>();
    [Parameter] public string Placeholder { get; set; } = "Select…";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Error { get; set; }

    private async Task HandleChange(ChangeEventArgs args)
    {
        Value = args.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
