@inherits HarborlineComponentBase

<div class="@CombineClasses(PickerCss)"
     style="@CombineStyles()"
     role="group"
     aria-label="@(AriaLabel ?? Label ?? "Month and year picker")"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="sf-monthyearpicker__label">
            @Label@if (Required)
            {<span class="sf-monthyearpicker__required" aria-hidden="true"> *</span>}
        </span>
    }
    <div class="sf-monthyearpicker__header">
        <button type="button"
                class="sf-monthyearpicker__nav"
                aria-label="Previous year"
                disabled="@(!Enabled || !CanNavigateTo(_displayYear - 1))"
                @onclick="() => _displayYear--">&lsaquo;</button>
        <span class="sf-monthyearpicker__year" aria-live="polite">@_displayYear</span>
        <button type="button"
                class="sf-monthyearpicker__nav"
                aria-label="Next year"
                disabled="@(!Enabled || !CanNavigateTo(_displayYear + 1))"
                @onclick="() => _displayYear++">&rsaquo;</button>
    </div>
    <div class="sf-monthyearpicker__grid" role="listbox" aria-label="Month" @onkeydown="HandleGridKeyDown">
        @for (var month = 1; month <= 12; month++)
        {
            var candidate = month;
            var key = FormatKey(_displayYear, candidate);
            var isSelected = key == Value;
            var isDisabled = !Enabled || !InRange(key);
            <button type="button"
                    class="sf-monthyearpicker__month @(isSelected ? "mar-monthyearpicker__month--selected" : "")"
                    role="option"
                    aria-selected="@isSelected.ToString().ToLowerInvariant()"
                    aria-disabled="@(isDisabled ? "true" : null)"
                    tabindex="@(candidate == FocusedMonth ? 0 : -1)"
                    disabled="@isDisabled"
                    @onclick="() => SelectMonth(candidate)">
                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(candidate)
            </button>
        }
    </div>
    @if (!string.IsNullOrEmpty(ErrorCode))
    {
        <p class="sf-monthyearpicker__error" role="alert">@ErrorCode</p>
    }
</div>

@code {
    private int _displayYear = DateTime.Today.Year;
    private bool _yearInitialized;

    /// <summary>The selected month as a <c>"yyyy-MM"</c> string. Powers <c>@@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Fires when a month cell is selected.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Fires when a month cell is selected, matching the React <c>onChange</c> surface.</summary>
    [Parameter] public EventCallback<string?> OnChange { get; set; }

    /// <summary>Inclusive lower bound, as a <c>"yyyy-MM"</c> string.</summary>
    [Parameter] public string? MinMonth { get; set; }

    /// <summary>Inclusive upper bound, as a <c>"yyyy-MM"</c> string.</summary>
    [Parameter] public string? MaxMonth { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    /// <summary>A localizable validation code. When set, the picker renders in its error state.</summary>
    [Parameter] public string? ErrorCode { get; set; }

    /// <summary>Month keys that cannot be selected, in <c>yyyy-MM</c> format.</summary>
    [Parameter] public IEnumerable<string>? DisabledMonths { get; set; }

    private int FocusedMonth { get; set; } = 1;

    private string PickerCss
    {
        get
        {
            var cls = "mar-monthyearpicker";
            if (!string.IsNullOrEmpty(ErrorCode)) cls += " mar-monthyearpicker--error";
            if (!Enabled) cls += " mar-monthyearpicker--disabled";
            return cls;
        }
    }

    protected override void OnParametersSet()
    {
        if (_yearInitialized) return;
        if (TryParseKey(Value, out var year, out _)) _displayYear = year;
        else if (TryParseKey(MinMonth, out var minYear, out _) && _displayYear < minYear) _displayYear = minYear;
        else if (TryParseKey(MaxMonth, out var maxYear, out _) && _displayYear > maxYear) _displayYear = maxYear;
        _yearInitialized = true;
    }

    private static string FormatKey(int year, int month) => $"{year:D4}-{month:D2}";

    private static bool TryParseKey(string? key, out int year, out int month)
    {
        year = 0;
        month = 0;
        if (string.IsNullOrEmpty(key)) return false;
        var parts = key.Split('-');
        return parts.Length == 2
            && int.TryParse(parts[0], out year)
            && int.TryParse(parts[1], out month)
            && month is >= 1 and <= 12;
    }

    private bool InRange(string key)
    {
        var afterMin = string.IsNullOrEmpty(MinMonth) || string.CompareOrdinal(key, MinMonth) >= 0;
        var beforeMax = string.IsNullOrEmpty(MaxMonth) || string.CompareOrdinal(key, MaxMonth) <= 0;
        return afterMin && beforeMax && !(DisabledMonths?.Contains(key, StringComparer.Ordinal) ?? false);
    }

    private bool CanNavigateTo(int year)
    {
        if (TryParseKey(MinMonth, out var minYear, out _) && year < minYear) return false;
        if (TryParseKey(MaxMonth, out var maxYear, out _) && year > maxYear) return false;
        return true;
    }

    private async Task SelectMonth(int month)
    {
        if (!Enabled) return;
        var key = FormatKey(_displayYear, month);
        if (!InRange(key)) return;
        FocusedMonth = month;
        Value = key;
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync(Value);
    }

    private async Task HandleGridKeyDown(KeyboardEventArgs args)
    {
        if (!Enabled) return;
        var next = FocusedMonth;
        switch (args.Key)
        {
            case "ArrowRight": next = FocusedMonth == 12 ? 1 : FocusedMonth + 1; break;
            case "ArrowLeft": next = FocusedMonth == 1 ? 12 : FocusedMonth - 1; break;
            case "ArrowDown": next = FocusedMonth > 9 ? FocusedMonth - 9 : FocusedMonth + 3; break;
            case "ArrowUp": next = FocusedMonth <= 3 ? FocusedMonth + 9 : FocusedMonth - 3; break;
            case "Home": next = 1; break;
            case "End": next = 12; break;
            case "Enter":
            case " ":
                await SelectMonth(FocusedMonth);
                return;
            default: return;
        }

        for (var offset = 0; offset < 12; offset++)
        {
            var candidate = ((next - 1 + offset) % 12) + 1;
            if (InRange(FormatKey(_displayYear, candidate)))
            {
                FocusedMonth = candidate;
                break;
            }
        }
    }
}
