@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Fields
@inherits HarborlineFieldBase

<HarborlineField Text="@Text" Id="@FieldId" Hint="@Hint" Error="@Error"
               Required="@EffectiveRequired" Disabled="@EffectiveDisabled"
               Class="@Class" Style="@Style" AdditionalAttributes="@AdditionalAttributes">
    <div class="sf-credit-card-field" role="group"
         aria-label="@EffectiveAriaLabel"
         aria-describedby="@DescribedBy">
        <div class="sf-credit-card-field__number">
            <HarborlineMaskedInput Value="@Value.Number"
                                 ValueChanged="@(v => Update(Value with { Number = v }))"
                                 Mask="0000 0000 0000 0009"
                                 InputMode="numeric" AutoComplete="cc-number"
                                 Placeholder="@NumberPlaceholder"
                                 Enabled="@(!EffectiveDisabled)" IsInvalid="@HasError"
                                 AriaLabel="@NumberLabel" />
            <span class="sf-credit-card-field__brand" data-brand="@Brand.ToString().ToLowerInvariant()">
                @BrandCode
            </span>
        </div>
        <HarborlineTextBox Value="@Value.Name"
                         ValueChanged="@(v => Update(Value with { Name = v }))"
                         Autocomplete="cc-name"
                         Placeholder="@NamePlaceholder"
                         Disabled="@EffectiveDisabled" IsInvalid="@HasError"
                         aria-label="@NameLabel" />
        <div class="sf-credit-card-field__row">
            <HarborlineMaskedInput Value="@Value.Expiry"
                                 ValueChanged="@(v => Update(Value with { Expiry = v }))"
                                 Mask="00/00" IncludeLiterals="true"
                                 InputMode="numeric" AutoComplete="cc-exp"
                                 Placeholder="@ExpiryPlaceholder"
                                 Enabled="@(!EffectiveDisabled)" IsInvalid="@HasError"
                                 AriaLabel="@ExpiryLabel" />
            <HarborlineMaskedInput Value="@Value.Cvc"
                                 ValueChanged="@(v => Update(Value with { Cvc = v }))"
                                 Mask="0009"
                                 InputMode="numeric" AutoComplete="cc-csc"
                                 Placeholder="@CvcPlaceholder"
                                 Enabled="@(!EffectiveDisabled)" IsInvalid="@HasError"
                                 AriaLabel="@CvcLabel" />
        </div>
    </div>
</HarborlineField>

@code {
    [Parameter] public HarborlineCreditCardValue Value { get; set; } = new();
    [Parameter] public EventCallback<HarborlineCreditCardValue> ValueChanged { get; set; }

    /// <summary>Localizable codes (or labels) for the sub-inputs.</summary>
    [Parameter] public string NumberLabel { get; set; } = "forms.creditCardField.number";
    [Parameter] public string NameLabel { get; set; } = "forms.creditCardField.name";
    [Parameter] public string ExpiryLabel { get; set; } = "forms.creditCardField.expiry";
    [Parameter] public string CvcLabel { get; set; } = "forms.creditCardField.cvc";
    [Parameter] public string? NumberPlaceholder { get; set; }
    [Parameter] public string? NamePlaceholder { get; set; }
    [Parameter] public string? ExpiryPlaceholder { get; set; }
    [Parameter] public string? CvcPlaceholder { get; set; }

    /// <summary>Brand detected from the leading digits (Visa / Mastercard / Amex / Discover).</summary>
    public HarborlineCreditCardBrand Brand
    {
        get
        {
            var digits = Value.Number;
            if (digits.Length == 0) return HarborlineCreditCardBrand.Unknown;
            if (digits.StartsWith('4')) return HarborlineCreditCardBrand.Visa;
            if (digits.StartsWith("34") || digits.StartsWith("37")) return HarborlineCreditCardBrand.Amex;
            if (digits.StartsWith('6')) return HarborlineCreditCardBrand.Discover;
            if (digits.Length >= 2
                && int.TryParse(digits[..2], System.Globalization.CultureInfo.InvariantCulture, out var two)
                && (two is >= 51 and <= 55 or >= 22 and <= 27))
            {
                return HarborlineCreditCardBrand.Mastercard;
            }
            return HarborlineCreditCardBrand.Unknown;
        }
    }

    private string BrandCode => Brand == HarborlineCreditCardBrand.Unknown
        ? string.Empty
        : $"forms.creditCardField.brand.{Brand.ToString().ToLowerInvariant()}";

    private Task Update(HarborlineCreditCardValue next)
    {
        Value = next;
        return ValueChanged.InvokeAsync(next);
    }
}
