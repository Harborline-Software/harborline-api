@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Fields
@inherits HarborlineFieldBase

<HarborlineNumberFormatField Text="@Text" Id="@Id" Hint="@Hint" Error="@Error"
                           Required="@Required" Disabled="@Disabled"
                           AriaLabel="@AriaLabel"
                           Class="@Class" Style="@Style" AdditionalAttributes="@AdditionalAttributes"
                           Value="@Value" ValueChanged="@ValueChanged"
                           Prefix="@CurrencySymbol" Placeholder="@Placeholder"
                           MaximumFractionDigits="2" MinimumFractionDigits="2"
                           UseGrouping="true" CultureName="@CultureName"
                           Min="@Min" Max="@Max" ReadOnly="@ReadOnly" />

@code {
    /// <summary>The raw decimal amount as a string (invariant "." separator), preserving precision.</summary>
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>The inline currency adornment. Defaults to "$" to mirror the React CurrencyField.</summary>
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? CultureName { get; set; }
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
}
