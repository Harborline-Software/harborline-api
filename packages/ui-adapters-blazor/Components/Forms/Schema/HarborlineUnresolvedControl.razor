@* The fail-closed unresolved-control affordance (ADR 0055 Rev 10 D-R10.5 parity for the
   .NET adapter, ADR 0167). Rendered by SchemaControlResolver when a field's control hint
   has no registered control AND its declared value kind is structured: a READ-ONLY,
   non-writing <output> — never an editable text input, which would corrupt a structured
   value on submit. Text localizes via the adapter's SharedResource bundle (stable dotted
   key, never hardcoded English). aria-disabled is emitted as the literal string "true"
   (ARIA state attributes from bools render via the lower-invariant string form). *@

@namespace Harborline.Api.UIAdapters.Blazor.Components.Forms.Schema
@using Harborline.Api.Foundation.Localization
@inject IHarborlineLocalizer<Harborline.Api.UIAdapters.Blazor.Localization.SharedResource> Localizer

<output id="@FieldName"
        class="harborline-schema-unresolved-control"
        aria-disabled="@true.ToString().ToLowerInvariant()">
    @Localizer.Format("forms.schema.controlUnavailable", new { control = ControlHint })
</output>

@code {
    /// <summary>The field's candidate-document property name (the affordance's DOM id).</summary>
    [Parameter, EditorRequired] public string FieldName { get; set; } = string.Empty;

    /// <summary>The unresolved control hint, interpolated into the localized message.</summary>
    [Parameter, EditorRequired] public string ControlHint { get; set; } = string.Empty;
}
