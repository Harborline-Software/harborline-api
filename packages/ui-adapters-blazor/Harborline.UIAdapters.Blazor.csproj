<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>Harborline.Api.UIAdapters.Blazor</PackageId>
    <AssemblyName>Harborline.Api.UIAdapters.Blazor</AssemblyName>
    <RootNamespace>Harborline.Api.UIAdapters.Blazor</RootNamespace>
    <Description>Blazor component implementations for Harborline.</Description>
    <PackageTags>blazor;components;razor-class-library;ui-framework;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TODO(HARBORLINE_API_I18N_002): Path A temporary suppression. ui-adapters-blazor's
         SharedResource bundle (default + ar-SA) defines 8 cascade keys that aren't yet
         consumed by any .cs / .razor in this package — scaffolded ahead of consumer wiring.
         Remove this suppression once consumers wire the keys via IStringLocalizer indexer or
         GetString. -->
    <NoWarn>CS1591;HARBORLINE_API_I18N_002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- Providers live in their own Razor class library projects under Providers/<Name>/ -->
    <Compile Remove="Providers/**/*.cs" />
    <Content Remove="Providers/**/*" />
    <None Remove="Providers/**/*" />
    <EmbeddedResource Remove="Providers/**/*" />
    <!-- Icon packages live in their own projects under Icons/<Name>/ -->
    <Compile Remove="Icons/**/*.cs" />
    <Content Remove="Icons/**/*" />
    <None Remove="Icons/**/*" />
    <EmbeddedResource Remove="Icons/**/*" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.UIAdapters.Blazor.Tests" />
    <InternalsVisibleTo Include="Harborline.Api.UIAdapters.Blazor.Server" />
    <!-- Required for NSubstitute to mock internal interfaces in tests -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Host-agnostic Blazor/Razor APIs; deliberately no Microsoft.AspNetCore.App. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-view-definitions\Harborline.Foundation.ViewDefinitions.csproj" />
    <ProjectReference Include="..\ui-core\Harborline.UICore.csproj" />
  </ItemGroup>
</Project>
