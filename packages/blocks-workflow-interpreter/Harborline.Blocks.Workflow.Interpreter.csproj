<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Workflow.Interpreter</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Workflow.Interpreter</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Workflow.Interpreter</RootNamespace>
    <Description>ADR 0135 A1 — the general declarative workflow interpreter (W-8 execution). Executes an authored + admitted + persisted WorkflowDefinition through the ADR 0135 engine: it loads the pinned definition via the re-validating IWorkflowDefinitionExecutionStore (never the lenient authoring face — SC2 F-2) and reaches every side-effect ONLY through the public IWorkflowEffectBroker (AP autonomously; CP through the SoD-gated confirm path — ADR 0143). A SEPARATE assembly from blocks-workflow by design: it composes only the public broker/catalog seams and cannot name the internal effect-factory surface (SC2 F-1 containment, compiler-enforced).</Description>
    <PackageTags>workflow;interpreter;execution;blocks;harborline;adr-0135</PackageTags>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Workflow.Interpreter.Tests" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <!-- The engine core (public seams ONLY: IWorkflowEffectBroker, IWorkflowEffectCatalog,
         IWorkflowDefinitionExecutionStore, the declarative model + wire mapper). NO InternalsVisibleTo
         grant from blocks-workflow → the interpreter CANNOT name the internal effect-factory surface
         (SC2 F-1 containment is a compile-time fact, not a source-scan). -->
    <ProjectReference Include="..\blocks-workflow\Harborline.Blocks.Workflow.csproj" />
    <!-- IPartyContext (server-derived confirmer party) + IPrincipalKindResolver (server-derived IsHuman). -->
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
