<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Reports</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Reports</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Reports</RootNamespace>
    <Description>Read-side report cartridge cluster. Substrate for IReportCartridge&lt;TParams, TResult&gt; + IReportRunner + ReportCartridgeRegistry per Stage 02 §6.1. Cartridges (Trial Balance, AR/AP Aging, P&amp;L by Property, Rent Roll) ship as additive PRs in subsequent hand-offs.</Description>
    <PackageTags>reports;read-side;cartridge;trial-balance;ar-aging;ap-aging;rent-roll;blocks;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Reports.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <!-- W#72 PR 2 — Trial Balance cartridge consumes ledger + periods read surfaces. -->
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <ProjectReference Include="..\blocks-financial-periods\Harborline.Blocks.FinancialPeriods.csproj" />
    <!-- W#72 PR 3 — AR Aging Summary cartridge consumes AR aging + party read surfaces. -->
    <ProjectReference Include="..\blocks-financial-ar\Harborline.Blocks.FinancialAr.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
    <!-- AP Aging Summary cartridge consumes AP aging service (bills/vendors). -->
    <ProjectReference Include="..\blocks-financial-ap\Harborline.Blocks.FinancialAp.csproj" />
    <!-- W#72 PR 6 — Rent Roll v2 cartridge consumes lease service for unit + tenant data. -->
    <ProjectReference Include="..\blocks-leases\Harborline.Blocks.Leases.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
