<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.ViewDefinitions</PackageId>
    <AssemblyName>Harborline.Api.Foundation.ViewDefinitions</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.ViewDefinitions</RootNamespace>
    <Description>Foundation-tier substrate for tenant-scoped, versioned view definitions (control ticket 074). A ViewDefinition is a binding from a stable key and semantic version to a host-registered view kind plus its parameters - never a query language. Hosts the DefinitionEnvelope-wired ViewDefinition record, the IViewDefinitionRegistry pinned-tuple CRUD + governance contract, the IViewDefinitionDescriptorRegistry admission seam (host-supplied; runtime surface registration is deliberately NOT the wire-validity authority), and the IViewDefinitionCanonicalizer seam with a pass-through reference implementation.</Description>
    <PackageTags>harborline;foundation;views;definitions;governance;ticket-074</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
</Project>
