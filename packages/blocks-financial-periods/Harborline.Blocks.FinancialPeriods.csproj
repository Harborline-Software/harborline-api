<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialPeriods</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialPeriods</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialPeriods</RootNamespace>
    <Description>FiscalYear + FiscalPeriod entities + period-close machinery for the Harborline Anchor native financial domain. Foundational; consumed by blocks-financial-ledger's posting algorithm for period-gating.</Description>
    <PackageTags>fiscal-year;fiscal-period;period-close;retained-earnings;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;NU1510;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialPeriods.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-events\Harborline.Foundation.Events.csproj" />
    <ProjectReference Include="..\foundation-import\Harborline.Foundation.Import.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
  </ItemGroup>
</Project>
