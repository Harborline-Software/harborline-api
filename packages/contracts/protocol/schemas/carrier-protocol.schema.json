{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.harborline.software/carrier/2.0/carrier-protocol.schema.json",
  "title": "Harborline and Capability protocol",
  "description": "Canonical, implementation-language-neutral boundary for Harborline, Capability, and native host adapters.",
  "type": "object",
  "$defs": {
    "EmptyRequest": {
      "type": "object",
      "additionalProperties": false
    },
    "EmptyResponse": {
      "type": "object",
      "additionalProperties": false
    },
    "Principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "local-os-user",
            "service"
          ]
        }
      }
    },
    "ProtocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faultDomain",
        "retryable",
        "code",
        "message"
      ],
      "properties": {
        "faultDomain": {
          "type": "string",
          "enum": [
            "input",
            "provider",
            "membrane"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "quantity",
        "tier"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "costMicros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tier": {
          "type": "string",
          "enum": [
            "local",
            "remote",
            "cloud"
          ]
        }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "CapabilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "status",
        "progress",
        "artifacts",
        "usage",
        "error"
      ],
      "properties": {
        "jobId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "running",
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolError"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RuntimeHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "capability",
        "state",
        "detail"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "up",
            "degraded",
            "down"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "HealthReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimes"
      ],
      "properties": {
        "runtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeHealth"
          }
        }
      }
    },
    "ProviderDescriptor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "RuntimeCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "schemaVersion",
        "providers"
      ],
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderDescriptor"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "AnnounceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        }
      }
    },
    "AnnounceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "name",
        "contractVersion",
        "capabilities"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "contractVersion": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeCapability"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "NegotiateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "contractVersion",
        "capabilitySchemaVersions"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        },
        "contractVersion": {
          "type": "string"
        },
        "capabilitySchemaVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "NegotiateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "agreedContractVersion",
        "acceptedCapabilities",
        "reason"
      ],
      "properties": {
        "compatible": {
          "type": "boolean"
        },
        "agreedContractVersion": {
          "type": "string"
        },
        "acceptedCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "AddressRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        }
      }
    },
    "AddressResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeId",
        "mode"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "in-process",
            "local-subprocess",
            "remote-mesh",
            "relay"
          ]
        },
        "baseUrl": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "SecureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "capabilityId",
        "correlationId"
      ],
      "properties": {
        "operationId": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        },
        "correlationId": {
          "type": "string"
        }
      }
    },
    "SecureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "authority",
        "reason"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "authority": {
          "type": "string",
          "enum": [
            "AP",
            "CP"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CapabilityInvokeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "core",
        "correlationId",
        "idempotencyKey"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "core": {
          "type": "object",
          "additionalProperties": true
        },
        "correlationId": {
          "type": "string"
        },
        "idempotencyKey": {
          "type": "string"
        }
      }
    },
    "CapabilityHostInvokeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "core"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "core": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ObserveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "runtimeId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "startup",
            "liveness",
            "readiness"
          ]
        }
      }
    },
    "ResolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId"
      ],
      "properties": {
        "capabilityId": {
          "type": "string"
        }
      }
    },
    "ResolutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chosenProviderId",
        "tier",
        "resolutionState",
        "selectionReason",
        "speedHint",
        "reason",
        "isFallback"
      ],
      "properties": {
        "chosenProviderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "local",
            "remote",
            "cloud"
          ]
        },
        "resolutionState": {
          "type": "string",
          "enum": [
            "available",
            "locked-entitlement",
            "upsell",
            "unavailable-hardware",
            "degraded",
            "not-in-edition"
          ]
        },
        "selectionReason": {
          "type": "string",
          "enum": [
            "only-candidate",
            "preferred-by-policy",
            "hardware-fit",
            "fallback-floor",
            "entitlement-gated"
          ]
        },
        "speedHint": {
          "type": "string",
          "enum": [
            "fast",
            "moderate",
            "slow"
          ]
        },
        "reason": {
          "type": "string"
        },
        "isFallback": {
          "type": "boolean"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ComposeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editionId",
        "capabilityIds"
      ],
      "properties": {
        "editionId": {
          "type": "string"
        },
        "capabilityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ComposeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editionId",
        "acceptedCapabilityIds",
        "rejectedCapabilityIds"
      ],
      "properties": {
        "editionId": {
          "type": "string"
        },
        "acceptedCapabilityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejectedCapabilityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CpDemoRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note"
      ],
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CpDemoMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "confirmed",
        "note",
        "executedAt",
        "proposedBy",
        "confirmedBy"
      ],
      "properties": {
        "command": {
          "type": "string",
          "enum": [
            "demo-cp-op"
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "executedAt": {
          "type": "string"
        },
        "proposedBy": {
          "$ref": "#/$defs/Principal"
        },
        "confirmedBy": {
          "$ref": "#/$defs/Principal"
        }
      }
    },
    "CpDemoResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "status",
        "progress",
        "artifacts",
        "usage",
        "error"
      ],
      "properties": {
        "jobId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "running",
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocolError"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "$ref": "#/$defs/CpDemoMeta"
        }
      }
    },
    "NodeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "baseUrl",
        "sessionToken"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "starting",
            "running",
            "failed",
            "stopped"
          ]
        },
        "baseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "BackupStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "destination",
        "lastSuccessfulBackupAtMs"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "notConfigured",
            "configured"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastSuccessfulBackupAtMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "DataLocationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataDirectory",
        "dataDirectorySource",
        "backup"
      ],
      "properties": {
        "dataDirectory": {
          "type": "string"
        },
        "dataDirectorySource": {
          "type": "string",
          "enum": [
            "applicationData",
            "developmentOverride"
          ]
        },
        "backup": {
          "$ref": "#/$defs/BackupStatus"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "DeviceCapabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "detectedAtMs",
        "osFamily",
        "architecture",
        "systemMemoryBytes",
        "fastMemoryBytes",
        "fastMemoryKind",
        "bandwidthClass",
        "bandwidthEvidence",
        "maximumLocalAiTier",
        "detectionStatus",
        "limitations"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ],
          "maximum": 9007199254740991
        },
        "detectedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "osFamily": {
          "type": "string",
          "enum": [
            "macos",
            "windows",
            "linux",
            "ios",
            "android",
            "unknown"
          ]
        },
        "architecture": {
          "type": "string"
        },
        "systemMemoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fastMemoryBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fastMemoryKind": {
          "type": "string",
          "enum": [
            "unified",
            "dedicatedVram",
            "system",
            "unknown"
          ]
        },
        "bandwidthClass": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        },
        "bandwidthEvidence": {
          "type": "string",
          "enum": [
            "inferred",
            "unknown"
          ]
        },
        "maximumLocalAiTier": {
          "type": "string",
          "enum": [
            "T-E",
            "T-S",
            "T-A",
            "T-R",
            "T-C"
          ]
        },
        "detectionStatus": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bandwidthUnavailable",
              "dedicatedVramUnavailable",
              "fastMemoryUnavailable",
              "hostUnavailable",
              "invalidHostResponse",
              "mobileWorkingSetEstimated",
              "probeFailed"
            ]
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "PeerSyncConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enableMdns",
        "peers",
        "bindAddress"
      ],
      "properties": {
        "enableMdns": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindAddress": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RendererLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "message"
      ],
      "properties": {
        "level": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        }
      }
    },
    "SyncPeerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "label",
        "state",
        "lastReachedAt",
        "offlineDurationMs",
        "isSecurityEvent",
        "errorCode"
      ],
      "properties": {
        "deviceId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "has",
            "will",
            "should",
            "couldnt"
          ]
        },
        "lastReachedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "offlineDurationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "isSecurityEvent": {
          "type": "boolean"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SyncCadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextRoundAt",
        "roundIntervalSeconds"
      ],
      "properties": {
        "nextRoundAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "roundIntervalSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "EnrollmentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "joinedTeamId",
        "reason"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "joinedTeamId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LastPeerExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peerDeviceId",
        "peerLabel",
        "exchangedAt"
      ],
      "properties": {
        "peerDeviceId": {
          "type": "string"
        },
        "peerLabel": {
          "type": "string"
        },
        "exchangedAt": {
          "type": "string"
        }
      }
    },
    "SyncRecency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "currentness",
        "lastExchange"
      ],
      "properties": {
        "basis": {
          "type": "string"
        },
        "currentness": {
          "type": "string"
        },
        "lastExchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastPeerExchange"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HarborlineSyncStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate",
        "asOf",
        "peers",
        "cadence",
        "recency"
      ],
      "properties": {
        "aggregate": {
          "type": "string",
          "enum": [
            "has",
            "will",
            "should",
            "couldnt"
          ]
        },
        "asOf": {
          "type": "string"
        },
        "peers": {
          "type": "array",
          "items": {
