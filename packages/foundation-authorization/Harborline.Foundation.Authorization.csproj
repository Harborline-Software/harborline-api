<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.Authorization</PackageId>
    <AssemblyName>Harborline.Api.Foundation.Authorization</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.Authorization</RootNamespace>
    <Description>Caller-identity + policy-evaluation + transitional tenant-context-facade interfaces. Extracted from Harborline.Api.Foundation in ADR 0091 Step 1 (Revision 2 corrigendum 2026-05-19T11:05Z) so the facade can extend Harborline.Api.Foundation.MultiTenancy.ITenantContext without circular package dependencies.</Description>
    <PackageTags>harborline;foundation;authorization;identity;tenant-context;oidc</PackageTags>
    <!-- NU1510 suppressed: direct PackageReferences for
         Microsoft.Extensions.DependencyInjection.Abstractions +
         Microsoft.Extensions.Hosting.Abstractions are required (IServiceCollection,
         IHostedService, IServiceScopeFactory, ServiceDescriptor) but NuGet
         preview.4 pruning flags them as unnecessary due to transitive
         availability via foundation-multitenancy. Per fleet-conventions
         §"NU1510 — keep the PackageRef, suppress the warning"; reference
         template shipyard commit b4475df. -->
    <NoWarn>CS1591;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Authorization.Tests" />
    <InternalsVisibleTo Include="Harborline.Api.Blocks.AccessGrant" />
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Forms" />
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Workflow" />
    <InternalsVisibleTo Include="Harborline.Api.LocalNodeHost.Tests" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
