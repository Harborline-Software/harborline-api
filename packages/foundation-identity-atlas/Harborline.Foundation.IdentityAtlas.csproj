<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.IdentityAtlas</PackageId>
    <AssemblyName>Harborline.Api.Foundation.IdentityAtlas</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.IdentityAtlas</RootNamespace>
    <Description>Foundation-tier backing-service contracts for the Identity Atlas surface (ADR 0066 §Phase 3): IKeyStore, ITrusteeRegistry, ITeamRegistry interfaces + Null* stubs. Real implementations ship in a future wallet/keystore workstream.</Description>
    <PackageTags>harborline;foundation;identity-atlas;adr-0066</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude the sibling test project from library compilation -->
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="tests" />
    <!-- Ticket 293 slice 5: MemberRoster.PermissionsOf / HasPermission read the SIGNED set, which no
         production code may use as an authorization answer. The host test suite asserts the signed shape. -->
    <InternalsVisibleTo Include="Harborline.Api.LocalNodeHost.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
