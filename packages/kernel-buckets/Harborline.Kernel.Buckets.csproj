<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel.Buckets</PackageId>
    <AssemblyName>Harborline.Api.Kernel.Buckets</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel.Buckets</RootNamespace>
    <Description>Declarative sync-bucket engine for the Harborline local-node architecture (paper §10.2, §10.3). Parses YAML bucket definitions, evaluates eligibility from role attestations at capability negotiation, and models lazy-fetch stubs with an LRU storage-budget manager.</Description>
    <PackageTags>harborline;kernel;buckets;sync;yaml</PackageTags>
    <!-- Stub interfaces and XML-doc gaps will be filled during review hardening.
         CS1591 kept noisy-but-off until the first stable release, matching the
         Foundation and Kernel facade packages. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\ui-core\Harborline.UICore.csproj" />
    <ProjectReference Include="..\kernel\Harborline.Kernel.csproj" />
    <ProjectReference Include="..\kernel-event-bus\Harborline.Kernel.EventBus.csproj" />
    <ProjectReference Include="..\kernel-security\Harborline.Kernel.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the sibling test project from library compilation. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Kernel.Buckets.Tests" />
  </ItemGroup>
</Project>
