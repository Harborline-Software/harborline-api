<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel.Runtime</PackageId>
    <AssemblyName>Harborline.Api.Kernel.Runtime</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel.Runtime</RootNamespace>
    <Description>Harborline local-node kernel runtime — the paper's §5.1 kernel (node lifecycle, plugin registry, extension-point contracts for ILocalNodePlugin, IStreamDefinition, IProjectionBuilder, ISchemaVersion, IUiBlockManifest). Sits alongside the Harborline.Api.Kernel type-forwarding facade per ADR 0027.</Description>
    <PackageTags>harborline;kernel;runtime;plugin-host</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Kernel.Runtime.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\ui-core\Harborline.UICore.csproj" />
    <ProjectReference Include="..\kernel\Harborline.Kernel.csproj" />
    <ProjectReference Include="..\kernel-event-bus\Harborline.Kernel.EventBus.csproj" />
    <ProjectReference Include="..\kernel-schema-registry\Harborline.Kernel.SchemaRegistry.csproj" />
    <ProjectReference Include="..\kernel-security\Harborline.Kernel.Security.csproj" />
    <ProjectReference Include="..\kernel-buckets\Harborline.Kernel.Buckets.csproj" />
    <ProjectReference Include="..\kernel-sync\Harborline.Kernel.Sync.csproj" />
    <ProjectReference Include="..\kernel-lease\Harborline.Kernel.Lease.csproj" />
    <!-- ADR 0115 Stage 1 (council Finding A1): the default team registrar composes
         the kernel ledger (PostingEngine + projections + period closer) into each
         per-team service provider. No cycle — kernel-ledger references only
         foundation/kernel/event-bus/lease. -->
    <ProjectReference Include="..\kernel-ledger\Harborline.Kernel.Ledger.csproj" />
    <ProjectReference Include="..\foundation-localfirst\Harborline.Foundation.LocalFirst.csproj" />
  </ItemGroup>
</Project>
