<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.Transport</PackageId>
    <AssemblyName>Harborline.Api.Foundation.Transport</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.Transport</RootNamespace>
    <Description>Foundation-tier substrate for the three-tier peer transport stack (ADR 0061): mDNS link-local (Tier 1) + WireGuard mesh-VPN (Tier 2) + Bridge HTTPS managed-relay (Tier 3). Hosts IPeerTransport / ITransportSelector / IMeshVpnAdapter / IDuplexStream contracts, PeerEndpoint / MeshNodeStatus / MeshPeer / MeshDeviceRegistration value records, and TransportTier discriminator. Concrete tier implementations live in foundation-transport (Tier 1 + Tier 3) and providers-mesh-* adapter packages (Tier 2).</Description>
    <PackageTags>harborline;foundation;transport;mesh-vpn;peer;adr-0061</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <ProjectReference Include="..\federation-common\Harborline.Federation.Common.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Transport.Tests" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
