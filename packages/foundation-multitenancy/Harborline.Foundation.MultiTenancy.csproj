<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.MultiTenancy</PackageId>
    <AssemblyName>Harborline.Api.Foundation.MultiTenancy</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.MultiTenancy</RootNamespace>
    <Description>Tenancy primitives: TenantMetadata, ITenantContext, ITenantResolver, ITenantCatalog, scoped markers, and an in-memory default. Does not reference Finbuckle — Bridge handles that adaptation in its host. See ADR 0008.</Description>
    <PackageTags>harborline;foundation;multitenancy;tenant</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Harborline.Foundation.MultiTenancy" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.MultiTenancy.Tests" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
