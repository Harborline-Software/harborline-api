<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Leases</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Leases</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Leases</RootNamespace>
    <Description>Lease-management block for Harborline — entity models, state-machine shape, and read-display lease list over ILeaseService.</Description>
    <PackageTags>blazor;leases;property;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TODO(HARBORLINE_API_I18N_002): Path A temporary suppression — SharedResource scaffolded
         ahead of consumer wiring. Remove once IStringLocalizer references land. -->
    <NoWarn>CS1591;HARBORLINE_API_I18N_002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Leases.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
    <ProjectReference Include="..\kernel-signatures\Harborline.Kernel.Signatures.csproj" />
    <ProjectReference Include="..\blocks-maintenance\Harborline.Blocks.Maintenance.csproj" />
    <ProjectReference Include="..\ui-core\Harborline.UICore.csproj" />
    <ProjectReference Include="..\ui-adapters-blazor\Harborline.UIAdapters.Blazor.csproj" />
    <!-- ADR 0120 PR-D: PM pack maps leases onto generic sub-ledger accounts.
         References ONLY the LOW identity assembly (SubLedgerAccountId + ISubLedgerReadModel interface).
         NEVER references blocks-financial-subledger-projection (HIGH tier) — the D3 arch-test enforces
         this at build time. blocks-financial-subledger depends only on blocks-financial-ledger (no AR/AP). -->
    <ProjectReference Include="..\blocks-financial-subledger\Harborline.Blocks.FinancialSubLedger.csproj" />
  </ItemGroup>
</Project>
