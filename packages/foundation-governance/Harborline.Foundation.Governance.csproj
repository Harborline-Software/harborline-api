<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.Governance</PackageId>
    <AssemblyName>Harborline.Api.Foundation.Governance</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.Governance</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>SPINE-2 (ADR 0140 D2) field/section aspect governance — the tag→policy resolver, the fail-closed publish-time admission validator, the four PEPs (Store/Read/Export/EraseSubject), and the greenfield bridges (class→AuditEventClass, eligible-set residency, legal-hold registry, retention→shred scheduler) + IConsentGate + Mask. Orchestration over the BUILT crypto-shred / encrypt / retain / reside / audit primitives — it composes them, it does not re-implement them.</Description>
    <PackageTags>governance;policy;classification;pii;retention;residency;crypto-shred;forms;spine-2;harborline;foundation</PackageTags>
    <!-- CS1591 suppressed at package level (matches sibling foundation-* packages):
         GenerateDocumentationFile is on repo-wide; public surface is documented but
         seed-data / params need not each carry a doc comment to keep the 0/0 build. -->
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Governance.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The aspect-overlay data types (additive on FieldOverlay/FormSection/HarborlineOverlay)
         + FormDefinition + the FormDefinitionValidationException the validator throws. -->
    <ProjectReference Include="..\foundation-forms\Harborline.Foundation.Forms.csproj" />
    <!-- IFieldEncryptor / ISubjectFieldEncryptor (encrypt), ISubjectErasureService +
         ISubjectErasurePropagator (erase / shred), EncryptedField, SubjectId. -->
    <ProjectReference Include="..\foundation-recovery\Harborline.Foundation.Recovery.csproj" />
    <!-- IRetentionPolicyResolver + RetentionVerdict + AuditEventClass (retain). -->
    <ProjectReference Include="..\foundation-security-policy\Harborline.Foundation.SecurityPolicy.csproj" />
    <!-- IDataResidencyEnforcer + EnforcementVerdict + DataResidencyConstraint +
         RegulatoryRegime / PolicyEnforcementAction vocabulary (reside / regime-precedence). -->
    <ProjectReference Include="..\foundation-mission-space-regulatory\Harborline.Foundation.MissionSpace.Regulatory.csproj" />
    <!-- ScopeExpression — the ONE scope reading the authority model already uses; the tenant consent
         record's scope and the consent gate's containment test are that same expression (ticket 213). -->
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <!-- IAuditLog + AuditAppend + Op + EntityId + TenantId + ActorId (audit). -->
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
