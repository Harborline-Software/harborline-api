<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Properties</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Properties</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Properties</RootNamespace>
    <Description>Properties domain block — Property entity, PostalAddress value object, in-memory repository, and IHarborlineEntityModule contribution. First-slice scope per property-properties-stage06-handoff.md (root entity + CRUD only; PropertyUnit + ownership log deferred to follow-up hand-offs).</Description>
    <PackageTags>properties;real-estate;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Properties.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-lifecycle\Harborline.Foundation.Lifecycle.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
  </ItemGroup>
</Project>
