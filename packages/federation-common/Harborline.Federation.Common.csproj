<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Federation.Common</PackageId>
    <AssemblyName>Harborline.Api.Federation.Common</AssemblyName>
    <RootNamespace>Harborline.Api.Federation.Common</RootNamespace>
    <Description>Harborline federation transport abstraction, signed sync-envelope, peer registry, and DI integration (spec §2.5, §10.4).</Description>
    <PackageTags>harborline;federation;sync;peer</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Federation.Common.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
</Project>
