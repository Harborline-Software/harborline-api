<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Kernel</PackageId>
    <AssemblyName>Harborline.Api.Kernel</AssemblyName>
    <RootNamespace>Harborline.Api.Kernel</RootNamespace>
    <Description>Kernel contract facade for Harborline — exposes the platform spec §3 kernel primitives (entity store, version store, audit log, permission evaluator, blob store) at the spec-named Layer 2 surface. Ships as type-forwarded wrappers over Harborline.Api.Foundation primitives. The Schema Registry (§3.4) ships from the sibling Harborline.Api.Kernel.SchemaRegistry package (gap G2). The Event Bus (§3.6) ships from the sibling Harborline.Api.Kernel.EventBus package (gap G3).</Description>
    <PackageTags>harborline;kernel;contracts;facade</PackageTags>
    <!-- Stub interfaces are intentionally empty and documented via xmldoc, but the
         empty-interface analyzer and CS1591 (missing doc on member) are noisy for a
         pure facade. Foundation suppresses CS1591 the same way pending stable-release
         doc hardening. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the sibling test project from library compilation. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
