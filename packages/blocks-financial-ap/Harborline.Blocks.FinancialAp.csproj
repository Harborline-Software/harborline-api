<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialAp</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialAp</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialAp</RootNamespace>
    <Description>Accounts-payable substrate for Harborline — Bill + BillLine entities, status transitions (incl. Disputed hold + optional Approval gate), and in-memory repository. First pass: entity model + repository contract only; posting, aging, and ERPNext importer arrive in PRs 2–4 of the financial-ap hand-off.</Description>
    <PackageTags>accounts-payable;ap;bill;vendor;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;NU1510;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialAp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-events\Harborline.Foundation.Events.csproj" />
    <ProjectReference Include="..\foundation-import\Harborline.Foundation.Import.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <!-- ADR 0120 PR-C / C-ARCH-2: additive SubLedgerAccountId? FK on Bill.
         The LOW identity assembly only depends on blocks-financial-ledger (no cycle). -->
    <ProjectReference Include="..\blocks-financial-subledger\Harborline.Blocks.FinancialSubLedger.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
  </ItemGroup>
</Project>
