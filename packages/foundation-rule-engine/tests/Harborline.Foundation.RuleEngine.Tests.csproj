<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.RuleEngine.Tests</PackageId>
    <AssemblyName>Harborline.Api.Foundation.RuleEngine.Tests</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.RuleEngine.Tests</RootNamespace>
    <!-- The assembly name MUST stay Harborline.Api.Foundation.RuleEngine.Tests: the package csproj already
         grants exactly that name InternalsVisibleTo, which is what makes CompiledGraph.Rules — and so the
         corpus `expectedAst` lane — reachable at all (ticket 193). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Harborline.Foundation.RuleEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The corpus is DATA in the package, not a compiled source. Link it into the test output so the
         runner reads the same ten files the package ships, rather than a second copy that could drift. -->
    <Content Include="../Conformance/corpus/*.json" Link="corpus/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Conformance/corpus-manifest.json" Link="corpus-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
