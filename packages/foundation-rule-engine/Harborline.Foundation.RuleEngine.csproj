<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.RuleEngine</PackageId>
    <AssemblyName>Harborline.Api.Foundation.RuleEngine</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.RuleEngine</RootNamespace>
    <Description>SPINE-1 Tier-2 rule engine (ADR 0140 D2 / ADR 0055 follow-up). The shared spine of the form + workflow keystones: a dependency-graph evaluator over a closed, versioned shipyard-jsonlogic/v1 operator set with fail-closed resource bounds and authoring-time cycle detection. The .NET integrity tier; the TS @harborline-software/rule-engine package is the reactive client tier emitting structurally-identical RuleOutcome values (proven by the shared conformance corpus).</Description>
    <PackageTags>harborline;foundation;rule-engine;jsonlogic;forms;workflow;spine-1;adr-0140;adr-0055</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.RuleEngine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation-forms\Harborline.Foundation.Forms.csproj" />
  </ItemGroup>
</Project>
