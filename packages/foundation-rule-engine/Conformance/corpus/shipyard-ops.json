{
  "_comment": "SPINE-1 conformance corpus — Shipyard extension operators: decimal-correct money.*, deterministic date.* (injected clock), coding.is taxonomy membership.",
  "cases": [
    {
      "name": "money/add-sub-decimal-correct",
      "definitionRules": [
        { "id": "c.sum", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "sum", "action": "Compute",
          "expression": { "money.add": [ { "var": "a" }, { "var": "b" } ] } },
        { "id": "c.diff", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "diff", "action": "Compute",
          "expression": { "money.sub": [ { "var": "a" }, { "var": "b" } ] } }
      ],
      "instance": { "a": "10.50", "b": "0.25" },
      "expectedOutcomes": {
        "c.sum": { "ruleId": "c.sum", "target": "field:sum", "outputType": "Value", "value": { "state": "Resolved", "value": "10.75" } },
        "c.diff": { "ruleId": "c.diff", "target": "field:diff", "outputType": "Value", "value": { "state": "Resolved", "value": "10.25" } }
      }
    },
    {
      "name": "money/multiply-no-float-drift",
      "definitionRules": [
        { "id": "c.m", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "m", "action": "Compute",
          "expression": { "money.mul": [ "1.5", "3" ] } },
        { "id": "c.m2", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "m2", "action": "Compute",
          "expression": { "money.mul": [ "0.1", "0.2" ] } }
      ],
      "instance": {},
      "expectedOutcomes": {
        "c.m": { "ruleId": "c.m", "target": "field:m", "outputType": "Value", "value": { "state": "Resolved", "value": "4.5" } },
        "c.m2": { "ruleId": "c.m2", "target": "field:m2", "outputType": "Value", "value": { "state": "Resolved", "value": "0.02" } }
      }
    },
