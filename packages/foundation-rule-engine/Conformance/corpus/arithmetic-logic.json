{
  "_comment": "SPINE-1 conformance corpus — one case per stock shipyard-jsonlogic/v1 operator (arithmetic, logic, compare, membership, data).",
  "cases": [
    {
      "name": "arith/add-sub-mul",
      "definitionRules": [
        { "id": "c.v", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "v", "action": "Compute",
          "expression": { "*": [ { "-": [ { "var": "a" }, { "var": "b" } ] }, { "var": "c" } ] } }
      ],
      "instance": { "a": 10, "b": 3, "c": 2 },
      "expectedAst": { "c.v": { "*": [ { "-": [ { "var": "field.a" }, { "var": "field.b" } ] }, { "var": "field.c" } ] } },
      "expectedOutcomes": {
        "c.v": { "ruleId": "c.v", "target": "field:v", "outputType": "Value", "value": { "state": "Resolved", "value": 14 } }
      }
    },
    {
      "name": "arith/divide-integer",
      "definitionRules": [
        { "id": "c.q", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "q", "action": "Compute",
          "expression": { "/": [ { "var": "a" }, { "var": "b" } ] } }
      ],
      "instance": { "a": 12, "b": 4 },
      "expectedOutcomes": {
        "c.q": { "ruleId": "c.q", "target": "field:q", "outputType": "Value", "value": { "state": "Resolved", "value": 3 } }
      }
    },
    {
      "name": "arith/modulo",
      "definitionRules": [
        { "id": "c.m", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "m", "action": "Compute",
          "expression": { "%": [ { "var": "a" }, { "var": "b" } ] } }
      ],
      "instance": { "a": 10, "b": 3 },
      "expectedOutcomes": {
        "c.m": { "ruleId": "c.m", "target": "field:m", "outputType": "Value", "value": { "state": "Resolved", "value": 1 } }
      }
    },
    {
      "name": "arith/min-max",
      "definitionRules": [
        { "id": "c.lo", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "lo", "action": "Compute",
          "expression": { "min": [ { "var": "a" }, { "var": "b" }, { "var": "c" } ] } },
        { "id": "c.hi", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "hi", "action": "Compute",
          "expression": { "max": [ { "var": "a" }, { "var": "b" }, { "var": "c" } ] } }
      ],
      "instance": { "a": 5, "b": 2, "c": 9 },
      "expectedOutcomes": {
        "c.lo": { "ruleId": "c.lo", "target": "field:lo", "outputType": "Value", "value": { "state": "Resolved", "value": 2 } },
        "c.hi": { "ruleId": "c.hi", "target": "field:hi", "outputType": "Value", "value": { "state": "Resolved", "value": 9 } }
      }
    },
    {
      "name": "logic/and-or",
      "definitionRules": [
        { "id": "c.r", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "r", "action": "Compute",
          "expression": { "or": [ { "and": [ { ">": [ { "var": "a" }, 0 ] }, { "<": [ { "var": "a" }, 10 ] } ] }, false ] } }
      ],
      "instance": { "a": 5 },
      "expectedOutcomes": {
        "c.r": { "ruleId": "c.r", "target": "field:r", "outputType": "Value", "value": { "state": "Resolved", "value": true } }
      }
    },
    {
      "name": "logic/if-ternary",
      "definitionRules": [
        { "id": "c.g", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "g", "action": "Compute",
          "expression": { "if": [ { ">": [ { "var": "a" }, { "var": "b" } ] }, "hi", "lo" ] } }
      ],
      "instance": { "a": 5, "b": 2 },
      "expectedOutcomes": {
        "c.g": { "ruleId": "c.g", "target": "field:g", "outputType": "Value", "value": { "state": "Resolved", "value": "hi" } }
      }
    },
    {
      "name": "logic/not-doublenot",
      "definitionRules": [
        { "id": "c.n", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "n", "action": "Compute",
          "expression": { "!": [ { "var": "flag" } ] } },
        { "id": "c.nn", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "nn", "action": "Compute",
          "expression": { "!!": [ { "var": "flag" } ] } }
      ],
      "instance": { "flag": false },
      "expectedOutcomes": {
        "c.n": { "ruleId": "c.n", "target": "field:n", "outputType": "Value", "value": { "state": "Resolved", "value": true } },
        "c.nn": { "ruleId": "c.nn", "target": "field:nn", "outputType": "Value", "value": { "state": "Resolved", "value": false } }
      }
    },
    {
      "name": "eq/strict-vs-loose",
      "definitionRules": [
        { "id": "c.se", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "se", "action": "Compute",
          "expression": { "===": [ { "var": "a" }, { "var": "b" } ] } },
        { "id": "c.le", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "le", "action": "Compute",
          "expression": { "==": [ { "var": "a" }, { "var": "b" } ] } }
      ],
      "instance": { "a": "5", "b": 5 },
      "expectedOutcomes": {
        "c.se": { "ruleId": "c.se", "target": "field:se", "outputType": "Value", "value": { "state": "Resolved", "value": false } },
        "c.le": { "ruleId": "c.le", "target": "field:le", "outputType": "Value", "value": { "state": "Resolved", "value": true } }
      }
    },
    {
      "name": "compare/gte-neq",
      "definitionRules": [
        { "id": "c.ge", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "ge", "action": "Compute",
          "expression": { ">=": [ { "var": "a" }, { "var": "b" } ] } },
        { "id": "c.ne", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "ne", "action": "Compute",
          "expression": { "!=": [ { "var": "a" }, { "var": "b" } ] } }
      ],
      "instance": { "a": 5, "b": 5 },
      "expectedOutcomes": {
        "c.ge": { "ruleId": "c.ge", "target": "field:ge", "outputType": "Value", "value": { "state": "Resolved", "value": true } },
        "c.ne": { "ruleId": "c.ne", "target": "field:ne", "outputType": "Value", "value": { "state": "Resolved", "value": false } }
      }
    },
    {
      "name": "membership/in-and-cat",
      "definitionRules": [
        { "id": "c.hit", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "hit", "action": "Compute",
          "expression": { "in": [ { "var": "x" }, { "var": "arr" } ] } },
        { "id": "c.label", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "label", "action": "Compute",
          "expression": { "cat": [ { "var": "p" }, "-", { "var": "s" } ] } }
      ],
      "instance": { "x": "b", "arr": [ "a", "b" ], "p": "x", "s": "y" },
      "expectedOutcomes": {
        "c.hit": { "ruleId": "c.hit", "target": "field:hit", "outputType": "Value", "value": { "state": "Resolved", "value": true } },
        "c.label": { "ruleId": "c.label", "target": "field:label", "outputType": "Value", "value": { "state": "Resolved", "value": "x-y" } }
      }
    },
    {
      "name": "data/missing-and-missing-some",
      "definitionRules": [
        { "id": "c.miss", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "miss", "action": "Compute",
          "expression": { "missing": [ "a", "z" ] } },
        { "id": "c.ms", "tier": "JsonLogic", "scope": "Field", "scopeTarget": "ms", "action": "Compute",
          "expression": { "missing_some": [ 1, [ "a", "b", "z" ] ] } }
      ],
      "instance": { "a": 1, "b": 2 },
      "expectedOutcomes": {
        "c.miss": { "ruleId": "c.miss", "target": "field:miss", "outputType": "Value", "value": { "state": "Resolved", "value": [ "z" ] } },
        "c.ms": { "ruleId": "c.ms", "target": "field:ms", "outputType": "Value", "value": { "state": "Resolved", "value": [] } }
      }
    }
  ]
}
