          "expression": { "+": [ { "var": "a" }, { "var": "b" } ] } }
      ],
      "instance": { "a": 0.1, "b": 0.2 },
      "expectedOutcomes": {
        "c.n": { "ruleId": "c.n", "target": "field:n", "outputType": "Value", "value": { "state": "Resolved", "value": 0.30000000000000004 } }
      }
