<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Assets.Registry</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Assets.Registry</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Assets.Registry</RootNamespace>
    <Description>Asset Type System substrate (ADR 0101 Rev 3.1 Wave 1) — the generic typed-entity
      registry: EntityType registry rows (tenant-scoped, immutable seed templates + tenant override
      rows), composable EntityTrait flags, typed dated relationships (contains / located-at /
      part-of-system) with same-tenant + cycle-guard + depth-bound + as-of-clock query discipline, the
      generic ConditionAssessment record keyed off a typed-entity ref, and the per-field scoring layer
      (metadata + raise-strictness-only floor resolution). Lives beside — and deliberately decoupled
      from — the frozen Rev 2 concrete Asset domain (blocks-assets); the two generic models never grow
      in parallel (A1 freeze guard). Pure .NET domain substrate, no Blazor.</Description>
    <PackageTags>assets;asset-type-system;registry;typed-entities;traits;relationships;condition;scoring;blocks;substrate;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Assets.Registry.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR 0101 Rev 3.1 Wave 1 substrate:
         - foundation            → Assets.Common primitives (TenantId, Instant)
         - foundation-multitenancy → IMustHaveTenant / ITenantScoped markers
         - foundation-integrations → Money (typed money from the start; read-side only, no posting path)
         - foundation-forms      → FormDefinitionId (content-addressed) + SemanticVersion (per-entity pin)
         NO reference on blocks-assets or blocks-property-equipment — the Asset Type System is a fresh
         generic model, not a fork of either frozen domain (A1). The freeze guard proves this. -->
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-integrations\Harborline.Foundation.Integrations.csproj" />
    <ProjectReference Include="..\foundation-forms\Harborline.Foundation.Forms.csproj" />
  </ItemGroup>
</Project>
