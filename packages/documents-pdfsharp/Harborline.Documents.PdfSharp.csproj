<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Documents.PdfSharp</PackageId>
    <AssemblyName>Harborline.Api.Documents.PdfSharp</AssemblyName>
    <RootNamespace>Harborline.Api.Documents.PdfSharp</RootNamespace>
    <Description>The default Documents-pillar PDF render adapter (#111 design §3.4): the first implementation of
      the Foundation IPdfExportWriter contract, backed by PDFsharp + MigraDoc (MIT, empira; pure-managed,
      cross-platform, no revenue gate — the D-1 discipline that rejects QuestPDF). Renders a semantic
      RenderedDocument to PDF bytes on the desktop/dogfood JIT node. Deliberately NOT a Harborline.Api.Foundation.*
      package: it holds the PDF-library dependency the ProviderNeutrality analyzer keeps out of Foundation
      (ADR 0021 §5); the mobile-carve AOT-clean emitter would register the same contract, different adapter.</Description>
    <PackageTags>harborline;documents;pdf;pdfsharp;migradoc;render;adr-0021;pillar-111</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Documents.PdfSharp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation-documents\Harborline.Foundation.Documents.csproj" />
  </ItemGroup>
</Project>
