<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialAr</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialAr</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialAr</RootNamespace>
    <Description>Accounts-receivable substrate for Harborline — Invoice + InvoiceLine entities, status transitions, and in-memory repository. First pass: entity model + repository contract only; numbering, posting, aging, rent-collection wrapper, and ERPNext importer arrive in PRs 2–6 of the financial-ar hand-off.</Description>
    <PackageTags>accounts-receivable;ar;invoice;billing;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;NU1510;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialAr.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-events\Harborline.Foundation.Events.csproj" />
    <ProjectReference Include="..\foundation-import\Harborline.Foundation.Import.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <!-- ADR 0120 PR-C / C-ARCH-2: additive SubLedgerAccountId? FK on Invoice.
         The LOW identity assembly only depends on blocks-financial-ledger (no cycle). -->
    <ProjectReference Include="..\blocks-financial-subledger\Harborline.Blocks.FinancialSubLedger.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
    <ProjectReference Include="..\foundation-scheduling\Harborline.Foundation.Scheduling.csproj" />
  </ItemGroup>
</Project>
