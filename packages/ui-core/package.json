{
  "name": "@harborline-software/ui-core",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Framework-agnostic Web Components for Harborline. Accessibility-first, RTL-safe, globally tested.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:a11y": "test-storybook --config-dir .storybook",
    "build:contracts": "tsx scripts/export-a11y-contracts.mts",
    "build": "pnpm run typecheck && pnpm run build-storybook && pnpm run build:contracts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@storybook/web-components": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "http-server": "^14.1.1",
    "lit": "^3.3.3",
    "playwright": "^1.62.0",
    "storybook": "^10.5.10",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=11.1.1"
    }
  }
}
