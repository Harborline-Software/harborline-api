<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Banking</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Banking</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Banking</RootNamespace>
    <Description>Banking and reconciliation domain block — ADR 0112. Tier-1 domain-block (zero external dependencies): BankAccount master, StatementLine entity, MatchLink many-to-many, Reconciliation state, MatchingRule, and the IBankFeedProvider tier-2 seam + Mock. CSV/OFX/QIF/CAMT.053 file-import pipeline contracts; matching engine contracts; per-account/period reconciliation state. Does NOT contain Bridge endpoints (H-5 scope).</Description>
    <PackageTags>banking;reconciliation;bank-account;statement-line;matching;blocks;domain;harborline</PackageTags>
    <NoWarn>$(NoWarn);NU1510;CS1574;CS0419</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Banking.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-integrations\Harborline.Foundation.Integrations.csproj" />
    <ProjectReference Include="..\foundation-lifecycle\Harborline.Foundation.Lifecycle.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <ProjectReference Include="..\blocks-financial-periods\Harborline.Blocks.FinancialPeriods.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
