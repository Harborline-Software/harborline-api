<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation</PackageId>
    <AssemblyName>Harborline.Api.Foundation</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation</RootNamespace>
    <Description>Core contracts, enums, models, and services for Harborline.</Description>
    <!-- TODO: Remove project-level CS1591 suppression before stable release.
         Add per-file #pragma guards on files with genuinely undocumented members instead.
         Tracked as Phase 1 migration accommodation. -->
    <!-- TODO(HARBORLINE_API_I18N_002): Path A temporary suppression. Foundation's SharedResource
         bundle defines 8 keys (severity.info/warning/error/critical, action.save/cancel/retry,
         state.loading) across SharedResource.resx + SharedResource.ar-SA.resx that are not yet
         consumed by any .cs / .razor in this package — they're scaffolded ahead of consumer
         wiring (per commit 93c53ba2 "scaffold SharedResource bundle — proof of layered cascade").
         Remove this suppression once consumers wire the keys via IStringLocalizer indexer or
         GetString. Follow-up issue: wire foundation SharedResource consumers. -->
    <NoWarn>CS1591;HARBORLINE_API_I18N_002;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="SmartFormat" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude the sibling test project from library compilation -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Expose internals (e.g. Macaroons.MacaroonCodec, FirstPartyCaveatParser) to the
         sibling test assembly so chain-computation and parser coverage can be asserted
         directly. -->
    <InternalsVisibleTo Include="tests" />
    <!-- Pattern C worked-example test assembly needs MacaroonCodec for wire-format
         encode/decode of bearer credentials across HTTP (spec §10.4, Issue #11). -->
    <InternalsVisibleTo Include="Harborline.Federation.PatternC.Tests" />
    <!-- Ticket 366 slice 1: the entity store's RAW (non-token) write seam is internal. Exactly the
         assemblies that own a NON-record write shape see it, each keeping its own admission because a
         record schema cannot judge their body: a definition envelope (foundation's own Definitions),
         a form definition envelope (Forms), a form instance whose Sensitive fields are ciphertext
         (Forms.Engine) and a workflow definition envelope (Blocks.Workflow).
         Harborline.Api.LocalNodeHost is deliberately NOT here: that absence is what makes a raw record
         write in NodeEntityWriter or NodeHierarchyCompositeCoordinator a compile error. -->
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Forms" />
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Forms.Engine" />
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Workflow" />
    <!-- The host test assembly's existing entity-store doubles and NSubstitute mocks implement the
         port, so both need the internal seam to compile. Tests, not production. -->
    <InternalsVisibleTo Include="Harborline.Api.LocalNodeHost.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
