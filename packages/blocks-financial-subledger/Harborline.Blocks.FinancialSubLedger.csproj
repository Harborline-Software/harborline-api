<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.FinancialSubLedger</PackageId>
    <AssemblyName>Harborline.Api.Blocks.FinancialSubLedger</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.FinancialSubLedger</RootNamespace>
    <Description>Generic subsidiary-ledger account identity primitive for Harborline (ADR 0120). Provides SubLedgerAccount master, SubLedgerKind enum, and the ISubLedgerReadModel interface + view types. Depends ONLY on blocks-financial-ledger. The projection implementation lives in blocks-financial-subledger-projection (HIGH tier, PR-B).</Description>
    <PackageTags>subsidiary-ledger;subledger;ar;ap;reconciliation;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Blocks.FinancialSubLedger.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-persistence\Harborline.Foundation.Persistence.csproj" />
    <ProjectReference Include="..\blocks-financial-ledger\Harborline.Blocks.FinancialLedger.csproj" />
    <ProjectReference Include="..\blocks-people-foundation\Harborline.Blocks.People.Foundation.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
