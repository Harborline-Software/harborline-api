<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.Ship.Common</PackageId>
    <AssemblyName>Harborline.Api.Foundation.Ship.Common</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.Ship.Common</RootNamespace>
    <Description>Foundation-tier substrate for the Harborline Shared Design System (ADR 0077): the closed ShipRole taxonomy + IPermissionResolver + IDeckRegistry + DefaultPermissionResolver. Provides the role/location/deck/action permission tuple consumed by every W#35 cohort UI ADR (Quarterdeck, Engine Room, Tactical, Sick Bay, Ship's Office, OOD-Watch). Per ADR 0077, W#46 Phase 1.</Description>
    <PackageTags>harborline;foundation;ship;permissions;adr-0077</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <ProjectReference Include="..\foundation-multitenancy\Harborline.Foundation.MultiTenancy.csproj" />
    <ProjectReference Include="..\foundation-mission-space\Harborline.Foundation.MissionSpace.csproj" />
    <ProjectReference Include="..\foundation-wayfinder\Harborline.Foundation.Wayfinder.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
    <!-- Safe: ui-core → foundation-ship-common would cycle (via kernel-crdt→ui-core);
         the reverse (foundation-ship-common → ui-core) is cycle-safe.
         Required for AddHarborlineSharedDesignSystem() to register IConformanceRegistry. -->
    <ProjectReference Include="..\ui-core\Harborline.UICore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.Ship.Common.Tests" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
