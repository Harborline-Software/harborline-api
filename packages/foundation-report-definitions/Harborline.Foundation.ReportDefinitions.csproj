<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.ReportDefinitions</PackageId>
    <AssemblyName>Harborline.Api.Foundation.ReportDefinitions</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.ReportDefinitions</RootNamespace>
    <Description>Foundation-tier substrate for tenant-scoped, versioned report definitions (control ticket 073). A ReportDefinition is a binding from a stable key and semantic version to a registered report kind plus its parameters - never a query language. Hosts the DefinitionEnvelope-wired ReportDefinition record, the IReportDefinitionRegistry pinned-tuple CRUD + governance contract, the IReportDefinitionDescriptorRegistry admission seam (host-supplied; runtime cartridge registration is deliberately NOT the wire-validity authority), and the IReportDefinitionCanonicalizer seam with a pass-through reference implementation.</Description>
    <PackageTags>harborline;foundation;reports;definitions;governance;ticket-073</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
  </ItemGroup>
</Project>
