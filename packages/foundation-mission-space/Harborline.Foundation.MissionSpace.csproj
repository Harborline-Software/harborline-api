<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.MissionSpace</PackageId>
    <AssemblyName>Harborline.Api.Foundation.MissionSpace</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.MissionSpace</RootNamespace>
    <Description>Foundation-tier substrate for the runtime mission-envelope negotiation protocol (ADR 0062 + A1). Hosts MissionEnvelope (10-dimension snapshot) + EnvelopeChange + FeatureVerdict + 5-value DegradationKind taxonomy + IFeatureGate/IDimensionProbe/IFeatureBespokeProbe contracts + IMissionEnvelopeProvider central coordinator + IFeatureForceEnableSurface operator-only override + LocalizedString + 9 new AuditEventType discriminators. Canonical-load-bearing for the W#33 §7.2 cohort.</Description>
    <PackageTags>harborline;foundation;mission-space;feature-gate;adr-0062</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <ProjectReference Include="..\foundation-versioning\Harborline.Foundation.Versioning.csproj" />
    <ProjectReference Include="..\foundation-migration\Harborline.Foundation.Migration.csproj" />
    <ProjectReference Include="..\foundation-ui-syncstate\Harborline.Foundation.UI.SyncState.csproj" />
    <ProjectReference Include="..\foundation-transport\Harborline.Foundation.Transport.csproj" />
    <ProjectReference Include="..\kernel-audit\Harborline.Kernel.Audit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harborline.Api.Foundation.MissionSpace.Tests" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
