<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Foundation.LocalFirst.Tests</PackageId>
    <AssemblyName>Harborline.Api.Foundation.LocalFirst.Tests</AssemblyName>
    <RootNamespace>Harborline.Api.Foundation.LocalFirst.Tests</RootNamespace>
    <!-- Test project: no public API ships from here, so the repo-wide XML-doc requirement
         (GenerateDocumentationFile + TreatWarningsAsErrors) would only produce CS1591 noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Harborline.Foundation.LocalFirst.csproj" />
  </ItemGroup>
</Project>
