<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Harborline.Api.Blocks.Workflow</PackageId>
    <AssemblyName>Harborline.Api.Blocks.Workflow</AssemblyName>
    <RootNamespace>Harborline.Api.Blocks.Workflow</RootNamespace>
    <Description>Workflow primitives for Harborline. Slice 1: generic state-machine (declarative definition, fluent builder, in-memory runtime). Slice 2 (ADR 0135 process engine): the provider-neutral durable-execution core — IWorkflowStore seam, the 3-table durable model, atomic-advance contract, cross-architecture-stable idempotency key, the four triggers + dispatcher. The recoverable EF/SQLite store impl lives in apps/local-node-host. Defers the general step-graph executor + saga runner to a later slice (rule-of-three).</Description>
    <PackageTags>workflow;state-machine;blocks;domain;harborline</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR 0143 (red-team Chain 1+5 / F2): the WorkflowAdmissionValidator DERIVES an action's
         CP/AP class from the CANONICAL capability→authority registry rather than trusting the
         author-declared label. Embed the SAME command-authority.json the harborline-sdk TS
         `authorityOf` + the `.mjs` invoke bridge read — one source of truth across both runtimes
         (no A4 drift). Linked (not copied) from its canonical location; if harborline-sdk moves it,
         this build breaks LOUDLY rather than drifting silently. -->
    <EmbeddedResource Include="..\harborline-sdk\src\command-authority.json">
      <Link>command-authority.json</Link>
      <LogicalName>command-authority.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Every friend in this project is test-only; this is a project-local claim, not a repository-wide one. -->
    <!-- Own tests exercise private effect-factory and persistence boundaries. -->
    <InternalsVisibleTo Include="Harborline.Api.Blocks.Workflow.Tests" />
    <!-- Host integration tests prove the real dispatcher, projector, and durable store composition. -->
    <InternalsVisibleTo Include="Harborline.Api.LocalNodeHost.Tests" />
    <!-- NSubstitute's test-only proxy assembly must implement internal workflow doubles. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation\Harborline.Foundation.csproj" />
    <ProjectReference Include="..\foundation-authorization\Harborline.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\foundation-identity-atlas\Harborline.Foundation.IdentityAtlas.csproj" />
    <ProjectReference Include="..\foundation-scheduling\Harborline.Foundation.Scheduling.csproj" />
    <ProjectReference Include="..\foundation-packs\Harborline.Foundation.Packs.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../eng/identity-contract.props" />
</Project>
