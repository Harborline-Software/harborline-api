<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The local beta feed (default ~/.harborline/nuget-feed, override HARBORLINE_NUGET_FEED) is
         deliberately NOT declared here: NuGet does not expand "~", so a home-relative source in
         this file breaks every restore on CI (NU1301). tooling/nuget-feed/pack-and-push.sh passes
         the absolute feed path via explicit "-source" arguments instead. -->
  </packageSources>
</configuration>
